@{
    ViewData["Title"] = "Về Chúng Tôi";
}

<div class="container-xxl py-5 mt-5">
    <div class="container">
        <div class="row g-5 align-items-center">
            <div class="col-lg-6 wow fadeIn" data-wow-delay="0.1s">
                <div class="about-img position-relative overflow-hidden p-5 pe-0">
                    <img class="img-fluid w-100 rounded-4 shadow" src="~/img/Hinh/QC/QC1.jpg" alt="Về QuaMonHai">
                </div>
            </div>
            <div class="col-lg-6 wow fadeIn" data-wow-delay="0.5s">
                <h1 class="display-5 mb-4 text-primary fw-bold" style="font-family: 'Lora', serif;">Chào mừng bạn đến với QuaMon<span class="text-secondary" style="font-style: italic;">Hai</span></h1>
                <p class="mb-4 text-dark fs-5">Hệ thống bán lẻ đa ngành hàng đầu, mang đến cho bạn trải nghiệm mua sắm tuyệt vời với các sản phẩm công nghệ tiên tiến (Laptop, Điện thoại, Máy ảnh) và phụ kiện thời trang cao cấp (Đồng hồ, Trang sức, Nước hoa).</p>

                <div class="row g-3 mb-4">
                    <div class="col-sm-6">
                        <div class="d-flex align-items-center bg-light rounded-4 p-3 shadow-sm border-start border-4 border-primary">
                            <i class="fa fa-shield-alt text-primary me-3 fs-4"></i>
                            <span class="fw-bold text-dark">100% Hàng chính hãng</span>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="d-flex align-items-center bg-light rounded-4 p-3 shadow-sm border-start border-4 border-primary">
                            <i class="fa fa-credit-card text-primary me-3 fs-4"></i>
                            <span class="fw-bold text-dark">Hỗ trợ trả góp 0%</span>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="d-flex align-items-center bg-light rounded-4 p-3 shadow-sm border-start border-4 border-primary">
                            <i class="fa fa-truck text-primary me-3 fs-4"></i>
                            <span class="fw-bold text-dark">Giao hàng toàn quốc</span>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="d-flex align-items-center bg-light rounded-4 p-3 shadow-sm border-start border-4 border-primary">
                            <i class="fa fa-tools text-primary me-3 fs-4"></i>
                            <span class="fw-bold text-dark">Bảo hành chuyên nghiệp</span>
                        </div>
                    </div>
                </div>

                <p class="mb-4">Với trụ sở chính tại <strong>Biên Hòa, Đồng Nai</strong>[cite: 92], chúng tôi không ngừng nỗ lực cập nhật những xu hướng công nghệ và thời trang mới nhất để phục vụ đam mê của bạn.</p>

                <a class="btn btn-primary rounded-pill py-3 px-5 fw-bold text-white shadow-sm" href="/HangHoas/Index">Khám phá cửa hàng</a>
            </div>
        </div>
    </div>
</div>
<div class="container-fluid bg-light bg-icon py-6 mt-5">
    <div class="container">
        <div class="section-header text-center mx-auto mb-5 wow fadeInUp" data-wow-delay="0.1s" style="max-width: 600px;">
            <h1 class="display-5 mb-3 fw-bold text-primary">Giá Trị Cốt Lõi</h1>
            <p>Khẳng định phong cách, nâng tầm trải nghiệm sống của bạn thông qua những sản phẩm chất lượng đỉnh cao.</p>
        </div>
        <div class="row g-4">
            <div class="col-lg-4 col-md-6 wow fadeInUp" data-wow-delay="0.1s">
                <div class="bg-white text-center h-100 p-4 p-xl-5 rounded-4 shadow-sm border-bottom border-4 border-primary">
                    <i class="fa fa-laptop text-primary mb-4" style="font-size: 4rem;"></i>
                    <h4 class="mb-3 fw-bold">Đa Dạng Sản Phẩm</h4>
                    <p class="mb-4">Từ các thiết bị điện tử, laptop mạnh mẽ đến những món phụ kiện, đồng hồ, trang sức tinh tế nhất.</p>
                </div>
            </div>
            <div class="col-lg-4 col-md-6 wow fadeInUp" data-wow-delay="0.3s">
                <div class="bg-white text-center h-100 p-4 p-xl-5 rounded-4 shadow-sm border-bottom border-4 border-primary">
                    <i class="fa fa-medal text-primary mb-4" style="font-size: 4rem;"></i>
                    <h4 class="mb-3 fw-bold">Chất Lượng Uy Tín</h4>
                    <p class="mb-4">Chỉ phân phối các mặt hàng đến từ các thương hiệu danh tiếng, đảm bảo trải nghiệm hoàn hảo.</p>
                </div>
            </div>
            <div class="col-lg-4 col-md-6 wow fadeInUp" data-wow-delay="0.5s">
                <div class="bg-white text-center h-100 p-4 p-xl-5 rounded-4 shadow-sm border-bottom border-4 border-primary">
                    <i class="fa fa-headset text-primary mb-4" style="font-size: 4rem;"></i>
                    <h4 class="mb-3 fw-bold">Tận Tâm Phục Vụ</h4>
                    <p class="mb-4">Đội ngũ chuyên viên tư vấn am hiểu sâu sắc, sẵn sàng hỗ trợ khách hàng 24/7 trong suốt quá trình sử dụng.</p>
                </div>
            </div>
        </div>
    </div>
</div>