@{
    ViewData["Title"] = "Bài Viết & Hướng Dẫn";
}

<div class="container-xxl py-5 mt-5">
    <div class="container">
        <!-- Section Header -->
        <div class="section-header text-center mx-auto mb-5 wow fadeInUp" data-wow-delay="0.1s" style="max-width: 800px;">
            <h1 class="display-5 mb-3 fw-bold text-primary" style="font-family: 'Lora', serif;">Bài Viết Nổi Bật Trong Tuần</h1>
            <p class="text-muted">Cập nhật những xu hướng công nghệ mới nhất, cẩm nang chăm sóc phụ kiện thời trang cao cấp và bí quyết chuẩn bị hành trang hoàn hảo cho mỗi chuyến đi cùng QuaMonHaiShop.</p>
        </div>

        <div class="row g-4">
            <!-- Article 1: Laptops & Phones -->
            <div class="col-lg-4 col-md-6 wow fadeInUp" data-wow-delay="0.1s">
                <div class="blog-card bg-white rounded-4 shadow-sm overflow-hidden h-100 border border-light">
                    <div class="blog-img-wrapper position-relative">
                        <img class="img-fluid w-100" src="~/img/blog_features.png" alt="Xu hướng công nghệ" style="height: 220px; object-fit: cover;">
                        <span class="position-absolute top-0 start-0 bg-primary text-white px-3 py-1 m-3 rounded-pill fw-bold" style="font-size: 0.8rem;">Công nghệ</span>
                    </div>
                    <div class="p-4">
                        <div class="d-flex mb-3">
                            <small class="text-muted me-3"><i class="fa fa-calendar-alt text-primary me-2"></i>26/05/2026</small>
                            <small class="text-muted ms-3"><i class="fa fa-user text-primary me-2"></i>QuaMonHai</small>
                        </div>
                        <h4 class="fw-bold mb-3 text-dark blog-title">Hướng Dẫn Lựa Chọn Laptop & Điện Thoại Phù Hợp Nhu Cầu</h4>
                        <p class="text-muted mb-4">Làm thế nào để chọn một chiếc Laptop HP, Dell bền bỉ, Asus mỏng nhẹ hay chiếc điện thoại Nokia, BlackBerry cổ điển phù hợp nhất cho công việc văn phòng và học tập...</p>
                        <a href="#" class="btn btn-outline-primary rounded-pill px-4 py-2 fw-bold read-more-btn" data-bs-toggle="modal" data-bs-target="#featureModal">Đọc chi tiết</a>
                    </div>
                </div>
            </div>

            <!-- Article 2: Perfumes & Watches -->
            <div class="col-lg-4 col-md-6 wow fadeInUp" data-wow-delay="0.3s">
                <div class="blog-card bg-white rounded-4 shadow-sm overflow-hidden h-100 border border-light">
                    <div class="blog-img-wrapper position-relative">
                        <img class="img-fluid w-100" src="~/img/blog_guide.png" alt="Phong cách & Đẳng cấp" style="height: 220px; object-fit: cover;">
                        <span class="position-absolute top-0 start-0 bg-success text-white px-3 py-1 m-3 rounded-pill fw-bold" style="font-size: 0.8rem;">Đẳng cấp</span>
                    </div>
                    <div class="p-4">
                        <div class="d-flex mb-3">
                            <small class="text-muted me-3"><i class="fa fa-calendar-alt text-primary me-2"></i>26/05/2026</small>
                            <small class="text-muted ms-3"><i class="fa fa-user text-primary me-2"></i>Stylist</small>
                        </div>
                        <h4 class="fw-bold mb-3 text-dark blog-title">Bí Quyết Giữ Hương Nước Hoa & Bảo Quản Đồng Hồ Luôn Đẹp</h4>
                        <p class="text-muted mb-4">Khám phá cách xịt nước hoa Guess, D&G lưu hương lâu phai và cách chăm sóc bộ máy đồng hồ Citizen Eco-Drive, Tissot automatic chống nước bền bỉ với thời gian...</p>
                        <a href="#" class="btn btn-outline-primary rounded-pill px-4 py-2 fw-bold read-more-btn" data-bs-toggle="modal" data-bs-target="#guideModal">Đọc chi tiết</a>
                    </div>
                </div>
            </div>

            <!-- Article 3: Jewelry & Luggage -->
            <div class="col-lg-4 col-md-6 wow fadeInUp" data-wow-delay="0.5s">
                <div class="blog-card bg-white rounded-4 shadow-sm overflow-hidden h-100 border border-light">
                    <div class="blog-img-wrapper position-relative">
                        <img class="img-fluid w-100" src="~/img/blog_reviews.png" alt="Cẩm nang hành trình" style="height: 220px; object-fit: cover;">
                        <span class="position-absolute top-0 start-0 bg-info text-white px-3 py-1 m-3 rounded-pill fw-bold" style="font-size: 0.8rem;">Cẩm nang</span>
                    </div>
                    <div class="p-4">
                        <div class="d-flex mb-3">
                            <small class="text-muted me-3"><i class="fa fa-calendar-alt text-primary me-2"></i>26/05/2026</small>
                            <small class="text-muted ms-3"><i class="fa fa-user text-primary me-2"></i>Traveler</small>
                        </div>
                        <h4 class="fw-bold mb-3 text-dark blog-title">Cẩm Nang Lựa Chọn Trang Sức & Vali Cho Chuyến Đi Hoàn Hảo</h4>
                        <p class="text-muted mb-4">Gợi ý cách phối nhẫn bạc đính đá Opal phong thủy sang trọng cùng cách chọn kích thước vali kéo Samsonite, balo High Sierra đa năng tiện lợi cho hành trình dài ngày...</p>
                        <a href="#" class="btn btn-outline-primary rounded-pill px-4 py-2 fw-bold read-more-btn" data-bs-toggle="modal" data-bs-target="#reviewModal">Đọc chi tiết</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal 1: Technology & Hardware Guide -->
<div class="modal fade" id="featureModal" tabindex="-1" aria-labelledby="featureModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header bg-primary text-white rounded-top-4 border-0">
                <h5 class="modal-title fw-bold" id="featureModalLabel"><i class="fa fa-laptop me-2"></i>Tư vấn chọn Laptop & Điện thoại phù hợp</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4 text-dark" style="max-height: 70vh; overflow-y: auto;">
                <h5 class="fw-bold mb-3">1. Xác định đúng mục đích sử dụng</h5>
                <p>Trước khi đầu tư, bạn cần phân loại rõ nhu cầu: các dòng máy trạm mạnh mẽ hay Dell Inspiron thích hợp cho kỹ thuật, ASUS Vivobook mỏng nhẹ lý tưởng cho việc di chuyển liên tục, còn dòng HP Pavilion sang trọng, thời trang sẽ tôn thêm phong cách chuyên nghiệp của bạn.</p>
                
                <h5 class="fw-bold mb-3 mt-4">2. Thông số kỹ thuật cần lưu ý</h5>
                <p>Nên chọn CPU tối thiểu từ Intel Core i5/Ryzen 5 trở lên, dung lượng RAM tối thiểu 8GB (ưu tiên 16GB nếu làm đa tác vụ) và bắt buộc sử dụng ổ cứng SSD để đảm bảo tốc độ khởi động, phản hồi ứng dụng nhanh chóng.</p>

                <h5 class="fw-bold mb-3 mt-4">3. Lựa chọn Điện thoại thông minh đồng bộ</h5>
                <p>Bên cạnh các dòng điện thoại thông minh hiện đại, các mẫu điện thoại cổ điển bền bỉ như Nokia E71, BlackBerry Bold vẫn giữ vững vị thế nhờ bàn phím QWERTY hỗ trợ soạn thảo nhanh, khả năng kết nối tốt và thời lượng pin cực trâu, rất phù hợp làm máy phụ liên lạc tin cậy.</p>
            </div>
        </div>
    </div>
</div>

<!-- Modal 2: Perfumes & Watches Care -->
<div class="modal fade" id="guideModal" tabindex="-1" aria-labelledby="guideModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header bg-success text-white rounded-top-4 border-0">
                <h5 class="modal-title fw-bold" id="guideModalLabel"><i class="fa fa-gem me-2"></i>Bí quyết bảo quản Nước hoa & Đồng hồ</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4 text-dark" style="max-height: 70vh; overflow-y: auto;">
                <h5 class="fw-bold mb-3">1. Cách xịt nước hoa giữ hương suốt ngày dài</h5>
                <p>Vị trí lý tưởng để xịt nước hoa (như các dòng Guess, D&G Light Blue) là những vùng có mạch máu nổi rõ và ấm áp: cổ tay, sau gáy, ngực và khuỷu tay. Tránh chà xát cổ tay sau khi xịt vì hành động này có thể phá vỡ cấu trúc các tầng hương, làm nước hoa bay mùi nhanh hơn.</p>

                <h5 class="fw-bold mb-3 mt-4">2. Lưu trữ và bảo quản nước hoa đúng cách</h5>
                <p>Luôn đóng chặt nắp sau khi sử dụng và bảo quản nước hoa ở nơi khô ráo, tránh ánh nắng trực tiếp hoặc độ ẩm cao (không nên để trong phòng tắm). Nhiệt độ thay đổi đột ngột có thể làm biến đổi màu sắc và mùi hương gốc của sản phẩm.</p>

                <h5 class="fw-bold mb-3 mt-4">3. Vận hành đồng hồ cơ tự động & Eco-Drive</h5>
                <p>Đồng hồ Automatic cần đeo thường xuyên (khoảng 8 tiếng/ngày) hoặc sử dụng hộp xoay chuyên dụng để duy trì năng lượng. Đối với dòng Citizen Eco-Drive, định kỳ hãy để đồng hồ tiếp xúc với nguồn sáng (ánh sáng mặt trời hoặc đèn tuýp) để sạc pin đầy đủ, không để cạn kiệt năng lượng quá lâu.</p>
            </div>
        </div>
    </div>
</div>

<!-- Modal 3: Travel Luggage & Accessory Styling -->
<div class="modal fade" id="reviewModal" tabindex="-1" aria-labelledby="reviewModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header bg-info text-white rounded-top-4 border-0">
                <h5 class="modal-title fw-bold" id="reviewModalLabel"><i class="fa fa-plane me-2"></i>Cẩm nang chọn Trang sức & Vali du lịch</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4 text-dark" style="max-height: 70vh; overflow-y: auto;">
                <h5 class="fw-bold mb-3">1. Phối trang sức tinh tế cho mọi dịp</h5>
                <p>Các mẫu nhẫn bạc đính đá Opal lấp lánh ngũ sắc xà cừ hay nút thắt Celtic Knot mang ý nghĩa may mắn, tình yêu vĩnh cửu. Phối hợp nhẫn bạc cùng trang phục tối giản sẽ tạo điểm nhấn tinh tế, thanh lịch nhưng vẫn vô cùng nổi bật cho bạn.</p>

                <h5 class="fw-bold mb-3 mt-4">2. Kinh nghiệm lựa chọn vali kéo Samsonite</h5>
                <p>Nên ưu tiên chất liệu nhựa Polycarbonate (PC) cao cấp có khả năng đàn hồi vượt trội, chống va đập, bể vỡ khi ký gửi hành lý. Bánh xe đôi xoay 360 độ linh hoạt kết hợp khóa số an toàn TSA là những yếu tố bắt buộc để có một chuyến đi an tâm.</p>

                <h5 class="fw-bold mb-3 mt-4">3. Lựa chọn balo phượt & balo kéo High Sierra</h5>
                <p>Với những chuyến đi ngắn ngày hoặc dã ngoại leo núi, balo kéo đa năng của High Sierra là lựa chọn hoàn hảo nhờ thiết kế tích hợp quai đeo trợ lực dày dặn bảo vệ cột sống, đi kèm tay kéo hợp kim bền bỉ giúp bạn linh hoạt thay đổi tư thế di chuyển.</p>
            </div>
        </div>
    </div>
</div>

<style>
    .blog-card {
        transition: all 0.3s ease;
    }
    .blog-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 12px 25px rgba(0,0,0,0.08) !important;
    }
    .blog-title {
        transition: color 0.3s ease;
    }
    .blog-card:hover .blog-title {
        color: #81c408 !important; /* Theme primary color */
    }
    .read-more-btn {
        transition: all 0.3s ease;
    }
    .read-more-btn:hover {
        background-color: #81c408 !important;
        border-color: #81c408 !important;
        color: white !important;
    }
</style>
