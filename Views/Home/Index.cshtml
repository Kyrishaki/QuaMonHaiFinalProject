@model IEnumerable<LTWEB_QuaMonHai_CuoiKy.Models.HangHoa>

<div id="tab-1" class="tab-pane fade show p-0 active">
    <div class="row g-4">
        @* Sử dụng .Take(12) để chỉ lấy tối đa 12 sản phẩm (4 cột x 3 hàng) *@
        @foreach (var item in Model.Take(12))
        {
            @* col-lg-3 giúp hiển thị 4 sản phẩm trên 1 hàng (12/3 = 4) *@
            <div class="col-xl-3 col-lg-3 col-md-6 wow fadeInUp" data-wow-delay="0.1s">
                <div class="product-item">
                    <div class="position-relative bg-light overflow-hidden">
                        @* Cập nhật src để lấy ảnh động từ database *@
                        <img class="img-fluid w-100" src="~/Hinh/HangHoa/@item.Hinh" alt="@item.TenHh"> 
                        <div class="bg-secondary rounded text-white position-absolute start-0 top-0 m-4 py-1 px-3">
                            @* Hiển thị tên loại thay vì object Navigation *@
                            @item.MaLoaiNavigation?.TenLoai
                        </div>
                    </div>
                    <div class="text-center p-4">
                        <a class="d-block h5 mb-2" href="">@item.TenHh</a> 
                        <span class="text-primary me-1">$@item.DonGia</span> 
                        <span class="text-body text-decoration-line-through">$@((item.DonGia * 1.2))</span>
                    </div>
                    <div class="d-flex border-top">
                       
                        <small class="w-50 text-center border-end py-2">
                            <a class="text-body" href=""><i class="fa fa-eye text-primary me-2"></i>View detail</a> 
                        </small>
                        <small class="w-50 text-center py-2">
                           
                            <a class="text-body" href=""><i class="fa fa-shopping-bag text-primary me-2"></i>Add to cart</a> 
                        </small>
                    </div> 
                </div>
            </div>
        }

        @* Nút Browse More nằm ngoài vòng lặp để chỉ xuất hiện 1 lần duy nhất *@
        <div class="col-12 text-center wow fadeInUp" data-wow-delay="0.1s">
            <a class="btn btn-primary rounded-pill py-3 px-5" href="">Browse More Products</a>
        </div>
    </div>
</div>