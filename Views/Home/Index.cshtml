@model IEnumerable<LTWEB_QuaMonHai_CuoiKy.Models.HangHoa>

@{
    ViewData["Title"] = "Cửa hàng của chúng tôi";
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
}

<div class="container py-5" style="max-width: 1200px;" id="product-section">
    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
        <h2 class="m-0 text-dark">Sản Phẩm Của Chúng Tôi</h2>
    </div>

    <div class="row g-4">
        <div class="col-lg-3 col-md-4">
            <partial name="_Sidebar" />
        </div>

        <div class="col-lg-9 col-md-8">
            <div class="row g-3">
                @foreach (var item in Model) {
                    <div class="col-sm-6 col-lg-4">
                        <div class="card h-100 shadow-sm border-0 rounded-3 overflow-hidden product-card position-relative">

                            <div class="bg-secondary rounded text-white position-absolute start-0 top-0 m-3 py-1 px-2" style="z-index: 10; font-size: 0.8rem; background-color: rgba(129, 196, 8, 0.9) !important;">
                                @(item.MaLoaiNavigation != null ? item.MaLoaiNavigation.TenLoai : "Sản phẩm")
                            </div>

                            <img src="@Url.Content("~/img/Hinh/HangHoa/" + (string.IsNullOrEmpty(item.Hinh) ? "no-image.jpg" : item.Hinh))"
                                 class="card-img-top"
                                 style="height: 220px; width: 100%; object-fit: cover; object-position: center;"
                                 alt="@item.TenHh">

                            <div class="card-body d-flex flex-column text-center p-3">
                                <h6 class="card-title text-truncate mb-1" title="@item.TenHh">@item.TenHh</h6>
                                <p class="text-primary fw-bold fs-5 mb-3" style="color: #81c408 !important;">$@item.DonGia</p>

                                <div class="btn-group mt-auto w-100 shadow-sm rounded-pill overflow-hidden">
                                    <a asp-action="Details" asp-controller="HangHoas" asp-route-id="@item.MaHh" class="btn btn-sm btn-light border-end text-info">
                                        <i class="fa fa-eye me-1"></i> Chi tiết
                                    </a>

                                    <a asp-action="AddToCart" asp-controller="Cart" asp-route-id="@item.MaHh" class="btn btn-sm btn-light text-success">
                                        <i class="fa fa-shopping-cart me-1"></i> Thêm giỏ
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <partial name="_NumberBar" />
        </div>
    </div>
</div>

<style>
    .product-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .product-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 .5rem 1rem rgba(0,0,0,.15) !important;
        }

    /* ĐÃ FIX: Đổi màu thanh phân trang thành Xanh lá (Green) */
    .pagination .page-link {
        color: #81c408;
        border: none;
        border-radius: 5px;
        margin: 0 4px;
        font-weight: 500;
        cursor: pointer;
    }

    .pagination .page-item.active .page-link {
        background-color: #81c408;
        color: white;
    }

    .pagination .page-item.disabled .page-link {
        color: #6c757d;
        background-color: transparent;
        pointer-events: none;
    }
</style>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        // Kiểm tra xem trên thanh địa chỉ có chứa biến "searchQuery" không
        const urlParams = new URLSearchParams(window.location.search);

        if (urlParams.has('searchQuery')) {
            // Nếu có tìm kiếm, đợi một nhịp (khoảng 200ms) để giao diện render xong rồi cuộn xuống
            setTimeout(function() {
                const element = document.getElementById('product-section');
                if (element) {
                    // Lấy vị trí của khu vực sản phẩm, trừ hao 100px cho độ cao của thanh Navbar
                    const yOffset = element.getBoundingClientRect().top + window.scrollY - 100;
                    window.scrollTo({top: yOffset, behavior: 'smooth'});
                }
            }, 200);
        }
    });
</script>