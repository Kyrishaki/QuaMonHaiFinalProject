@model IEnumerable<LTWEB_QuaMonHai_CuoiKy.Models.HangHoa>

@{
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
}

<div id="tab-1" class="tab-pane fade show p-0 active">
    <div class="row g-4">
        @foreach (var item in Model)
        {
            @* col-lg-4 tạo ra 3 cột trên 1 hàng (12 / 4 = 3) *@
            <div class="col-xl-4 col-lg-4 col-md-6 wow fadeInUp" data-wow-delay="0.1s">
                <div class="product-item">
                    <div class="position-relative bg-light overflow-hidden">
                        <img class="img-fluid w-100" src="~/img/@item.Hinh" alt="@item.TenHh">
                        <div class="bg-secondary rounded text-white position-absolute start-0 top-0 m-4 py-1 px-3">
                            @* Hiển thị loại sản phẩm *@
                            @{
                                // Lưu ý: Để hiện tên loại ở trang chủ, bạn cần .Include(h => h.MaLoaiNavigation) trong Controller
                                // Nếu không, đoạn này có thể để trống hoặc hiển thị "Sản phẩm"
                            }
                            Sản phẩm
                        </div>
                    </div>
                    <div class="text-center p-4">
                        <a class="d-block h5 mb-2" href="">@item.TenHh</a>
                        <span class="text-primary me-1">$@item.DonGia</span>
                        <span class="text-body text-decoration-line-through">$@((item.DonGia ?? 0) * 1.2)</span>
                    </div>
                    <div class="d-flex border-top">
                        <small class="w-50 text-center border-end py-2">
                            <a class="text-body" href=""><i class="fa fa-eye text-primary me-2"></i>Xem chi tiết</a>
                        </small>
                        <small class="w-50 text-center py-2">
                            <a asp-controller="Cart" asp-action="AddToCart" asp-route-id="@item.MaHh" class="text-body"><i class="fa fa-shopping-bag text-primary me-2"></i>Thêm giỏ</a>
                        </small>
                    </div>
                </div>
            </div>
        }

        @* THANH PHÂN TRANG *@
        @if (totalPages > 1)
        {
            <div class="col-12 text-center wow fadeInUp" data-wow-delay="0.1s" style="margin-top: 50px;">
                <nav>
                    <ul class="pagination justify-content-center mb-0">
                        @if (currentPage > 1)
                        {
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action("Index", new { page = currentPage - 1 })">&laquo;</a>
                            </li>
                        }

                        @for (int i = 1; i <= totalPages; i++)
                        {
                            <li class="page-item @(i == currentPage ? "active" : "")">
                                <a class="page-link" href="@Url.Action("Index", new { page = i })">@i</a>
                            </li>
                        }

                        @if (currentPage < totalPages)
                        {
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action("Index", new { page = currentPage + 1 })">&raquo;</a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>

<style>
    .pagination .page-link {
        color: #81c408;
        border: 1px solid #dee2e6;
        margin: 0 4px;
        padding: 10px 20px;
        border-radius: 5px;
    }

    .pagination .page-item.active .page-link {
        background-color: #81c408;
        border-color: #81c408;
        color: white;
    }
</style>