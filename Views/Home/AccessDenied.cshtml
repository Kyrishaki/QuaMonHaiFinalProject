@{
    Layout = "_Layout";
    ViewData["Title"] = "Truy cập bị từ chối";
}

<div class="container d-flex align-items-center justify-content-center" style="min-height: 75vh; padding-top: 140px; padding-bottom: 80px;">
    <div class="access-denied-card text-center p-5 rounded-4 shadow">
        <div class="icon-box mb-4 mx-auto d-flex align-items-center justify-content-center">
            <i class="fa fa-shield-halved text-danger fa-4x animate-pulse"></i>
        </div>
        <h1 class="fw-bold text-dark mb-3" style="font-family: 'Lora', serif; letter-spacing: 0.5px;">TRUY CẬP BỊ TỪ CHỐI</h1>
        <div class="divider mx-auto mb-4" style="width: 60px; height: 3px; background: linear-gradient(90deg, #dc3545, #ffc107); border-radius: 2px;"></div>
        <p class="text-muted fs-5 mb-4" style="max-width: 500px;">
            Tài khoản của bạn không có đủ đặc quyền để truy cập vào tài nguyên này. Vui lòng liên hệ với Quản Trị Viên (Admin) hoặc quay lại Trang chủ.
        </p>
        <div class="d-flex justify-content-center gap-3">
            <a href="javascript:history.back()" class="btn btn-outline-secondary rounded-pill px-4 fw-bold shadow-sm">
                <i class="fa fa-arrow-left me-2"></i>Quay lại
            </a>
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm" style="background: linear-gradient(135deg, #81c408, #5a8c03); border: none;">
                <i class="fa fa-home me-2"></i>Trang chủ
            </a>
        </div>
    </div>
</div>

<style>
    .access-denied-card {
        background: rgba(255, 255, 255, 0.85);
        backdrop-filter: blur(15px);
        -webkit-backdrop-filter: blur(15px);
        border: 1px solid rgba(220, 53, 69, 0.2);
        max-width: 600px;
        width: 100%;
        transition: transform 0.3s ease;
    }
    
    .access-denied-card:hover {
        transform: translateY(-5px);
    }
    
    .icon-box {
        width: 100px;
        height: 100px;
        background: rgba(220, 53, 69, 0.1);
        border-radius: 50%;
        border: 2px dashed rgba(220, 53, 69, 0.4);
    }

    .animate-pulse {
        animation: pulse 2s infinite;
    }

    @@keyframes pulse {
        0% {
            transform: scale(1);
        }
        50% {
            transform: scale(1.08);
        }
        100% {
            transform: scale(1);
        }
    }
</style>
