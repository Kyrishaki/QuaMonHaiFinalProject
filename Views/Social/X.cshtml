            <div class="col-6 x-main px-0">
                <!-- Profile Header -->
                <div class="x-header d-flex align-items-center gap-4">
                    <a href="/" class="text-white text-decoration-none"><i class="fa fa-arrow-left"></i></a>
                    <div>
                        <h2 class="x-name">QuaMonHai <i class="fa fa-circle-check text-primary fs-6" style="color: #1d9bf0 !important;" title="Verified account"></i></h2>
                        <span class="text-muted" style="font-size: 0.85rem;">42 Tweets</span>
                    </div>
                </div>

                <!-- Cover Image -->
