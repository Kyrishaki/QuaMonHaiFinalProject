    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body {
            background-color: #000000;
            color: #e7e9ea;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        }
        .x-sidebar-left {
            border-right: 1px solid #2f3336;
            height: 100vh;
            position: sticky;
            top: 0;
            padding-right: 20px;
        }
        .x-menu-item {
            font-size: 1.25rem;
            font-weight: 700;
            padding: 12px 20px;
            border-radius: 9999px;
            cursor: pointer;
            width: fit-content;
            transition: background-color 0.2s ease;
            display: flex;
            align-items: center;
            gap: 20px;
            color: #e7e9ea;
            text-decoration: none;
        }
        .x-menu-item:hover {
            background-color: #16181c;
            color: #e7e9ea;
        }
        .x-menu-item.active {
            font-weight: 800;
        }
        .x-logo {
            font-size: 1.8rem;
            color: #e7e9ea;
            padding: 12px;
            display: inline-block;
            margin-bottom: 10px;
        }
        .btn-tweet-nav {
            background-color: #1d9bf0;
            color: white;
            font-weight: 700;
            border: none;
            border-radius: 9999px;
            padding: 14px 0;
            width: 90%;
            margin-top: 15px;
            font-size: 1.05rem;
            transition: background-color 0.2s ease;
        }
        .btn-tweet-nav:hover {
            background-color: #1a8cd8;
        }
        .x-main {
            border-right: 1px solid #2f3336;
            min-height: 100vh;
        }
        .x-header {
            position: sticky;
            top: 0;
            background-color: rgba(0, 0, 0, 0.65);
            backdrop-filter: blur(12px);
            z-index: 10;
            border-bottom: 1px solid #2f3336;
            padding: 10px 15px;
        }
        .x-cover {
            height: 200px;
            background: linear-gradient(135deg, #1d9bf0 0%, #0d4b73 100%);
            position: relative;
        }
        .x-avatar-container {
            margin-top: -70px;
            margin-left: 15px;
            position: relative;
            z-index: 2;
        }
        .x-avatar {
            width: 134px;
            height: 134px;
            border-radius: 50%;
            border: 4px solid #000000;
            background-color: #81c408;
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 4rem;
            font-weight: bold;
        }
        .btn-x-edit {
            border: 1px solid #536471;
            background-color: transparent;
            color: #e7e9ea;
            font-weight: 700;
            border-radius: 9999px;
            padding: 8px 16px;
            font-size: 0.95rem;
            transition: background-color 0.2s ease;
        }
        .btn-x-edit:hover {
            background-color: rgba(231, 233, 234, 0.1);
        }
        .x-profile-info {
            padding: 15px;
        }
        .x-name {
            font-size: 1.3rem;
            font-weight: 800;
            margin: 0;
            display: flex;
            align-items: center;
            gap: 5px;
        }
        .x-handle {
            color: #71767b;
            font-size: 0.95rem;
            margin-bottom: 12px;
        }
        .x-bio {
            font-size: 0.95rem;
            line-height: 1.4;
            margin-bottom: 12px;
        }
        .x-meta-item {
            color: #71767b;
            font-size: 0.9rem;
            margin-right: 15px;
            display: inline-flex;
            align-items: center;
            gap: 5px;
        }
        .x-meta-item i {
            font-size: 1rem;
        }
        .x-stats {
            margin-top: 12px;
            font-size: 0.9rem;
        }
        .x-stat-num {
            color: #e7e9ea;
            font-weight: 700;
        }
        .x-stat-label {
            color: #71767b;
        }
        .x-tabs {
            border-bottom: 1px solid #2f3336;
            display: flex;
            text-align: center;
        }
        .x-tab {
            flex: 1;
            padding: 15px 0;
            font-weight: 700;
            color: #71767b;
            cursor: pointer;
            position: relative;
            transition: background-color 0.2s ease;
        }
        .x-tab:hover {
            background-color: rgba(231, 233, 234, 0.03);
        }
        .x-tab.active {
            color: #e7e9ea;
        }
        .x-tab.active::after {
            content: "";
            position: absolute;
            bottom: 0;
            left: 50%;
            transform: translateX(-50%);
            width: 60px;
            height: 4px;
            background-color: #1d9bf0;
            border-radius: 9999px;
        }
        .tweet-card {
            border-bottom: 1px solid #2f3336;
            padding: 15px;
            display: flex;
            gap: 12px;
            transition: background-color 0.2s ease;
        }
        .tweet-card:hover {
            background-color: rgba(255, 255, 255, 0.015);
        }
        .tweet-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background-color: #81c408;
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            flex-shrink: 0;
        }
        .tweet-header {
            display: flex;
            align-items: center;
            gap: 5px;
            margin-bottom: 4px;
        }
        .tweet-author {
            font-weight: 700;
            color: #e7e9ea;
            margin: 0;
            display: flex;
            align-items: center;
            gap: 3px;
        }
        .tweet-handle {
            color: #71767b;
            font-size: 0.9rem;
        }
        .tweet-time {
            color: #71767b;
            font-size: 0.9rem;
        }
        .tweet-text {
            font-size: 0.95rem;
            line-height: 1.5;
            color: #e7e9ea;
            margin-bottom: 10px;
        }
        .tweet-media-container {
            border: 1px solid #2f3336;
            border-radius: 16px;
            overflow: hidden;
            background-color: #0c0d0e;
            margin-bottom: 10px;
            text-align: center;
        }
        .tweet-image {
            max-height: 380px;
            object-fit: cover;
            max-width: 100%;
        }
        .tweet-actions {
            display: flex;
            justify-content: space-between;
            color: #71767b;
            max-width: 425px;
            font-size: 0.85rem;
            margin-top: 10px;
        }
        .tweet-action-btn {
            display: flex;
            align-items: center;
            gap: 8px;
            cursor: pointer;
            transition: color 0.2s ease;
        }
        .tweet-action-btn:hover {
            color: #1d9bf0;
        }
        .tweet-action-btn.retweeted {
            color: #00ba7c;
        }
        .tweet-action-btn.liked {
            color: #f91880;
        }
        .x-sidebar-right {
            border-left: 1px solid #2f3336;
            padding: 15px 0 15px 25px;
            height: 100vh;
            position: sticky;
            top: 0;
        }
        .x-search-right {
            background-color: #202327;
            border-radius: 9999px;
            border: none;
            padding: 12px 20px;
            width: 100%;
            color: white;
            font-size: 0.95rem;
            outline: none;
            margin-bottom: 15px;
        }
        .x-widget-card {
            background-color: #16181c;
            border-radius: 16px;
            padding: 15px;
            margin-bottom: 15px;
        }
        .x-widget-title {
            font-size: 1.2rem;
            font-weight: 800;
            margin-bottom: 15px;
        }
        .trend-item {
            margin-bottom: 15px;
        }
        .trend-category {
            font-size: 0.8rem;
            color: #71767b;
        }
        .trend-name {
            font-weight: 700;
            font-size: 0.95rem;
            color: #e7e9ea;
        }
        .trend-tweets {
            font-size: 0.8rem;
            color: #71767b;
        }
        .floating-back-btn {
            position: fixed;
            bottom: 24px;
            right: 24px;
            background: linear-gradient(135deg, #81c408 0%, #689f06 100%);
            color: white;
            border-radius: 50px;
            padding: 12px 24px;
            box-shadow: 0 4px 15px rgba(129, 196, 8, 0.4);
            z-index: 10000;
            text-decoration: none;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 8px;
            transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            animation: pulseBtn 2s infinite;
        }
        .floating-back-btn:hover {
            transform: scale(1.05) translateY(-3px);
            box-shadow: 0 6px 20px rgba(129, 196, 8, 0.6);
            color: white;
        }
        @@keyframes pulseBtn {
            0% { box-shadow: 0 4px 15px rgba(129, 196, 8, 0.4); }
            50% { box-shadow: 0 4px 25px rgba(129, 196, 8, 0.7); }
            100% { box-shadow: 0 4px 15px rgba(129, 196, 8, 0.4); }
        }
    </style>
</head>
<body>

    <!-- Floating Back Button -->
    <a href="/" class="floating-back-btn">
        <i class="fa fa-arrow-left"></i> Quay lại QuaMonHai
