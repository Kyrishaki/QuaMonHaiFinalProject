@model LTWEB_QuaMonHai_CuoiKy.Models.HangHoa

<div class="container py-4">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">Thông tin sản phẩm (Lưu vào SQL Server)</h4>
        </div>
        <div class="card-body">
            <form asp-action="@ViewContext.RouteData.Values["action"]">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                @if (ViewContext.RouteData.Values["action"].ToString() == "Edit")
                {
                    <input type="hidden" asp-for="MaHh" />
                }

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="TenHh" class="form-label fw-bold">Tên hàng hóa</label>
                        <input asp-for="TenHh" class="form-control" required />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="DonGia" class="form-label fw-bold">Đơn giá ($)</label>
                        <input asp-for="DonGia" class="form-control" type="number" step="0.01" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="MaLoai" class="form-label fw-bold">Loại sản phẩm</label>
                        <select asp-for="MaLoai" class="form-select" asp-items="ViewBag.MaLoai"></select>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Hinh" class="form-label fw-bold">URL Hình ảnh</label>
                        <input asp-for="Hinh" class="form-control" placeholder="Dán link ảnh từ API hoặc tên file..." />
                    </div>
                </div>

                <div class="mt-3">
                    <button type="submit" class="btn btn-success"><i class="fa fa-save"></i> Lưu vĩnh viễn</button>
                    <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
                </div>
            </form>
        </div>
    </div>
</div>