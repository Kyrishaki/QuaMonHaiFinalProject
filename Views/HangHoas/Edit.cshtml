@model LTWEB_QuaMonHai_CuoiKy.Models.HangHoa

@{
    ViewData["Title"] = "Sửa sản phẩm";
}

<div class="container py-4">
    <h2>Cập Nhật Sản Phẩm (Database)</h2>
    <hr />
    <div class="row">
        <div class="col-md-6">
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <input type="hidden" asp-for="MaHh" />

                <div class="form-group mb-3">
                    <label asp-for="TenHh" class="control-label fw-bold">Tên sản phẩm</label>
                    <input asp-for="TenHh" class="form-control" required />
                    <span asp-validation-for="TenHh" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="DonGia" class="control-label fw-bold">Giá bán ($)</label>
                    <input asp-for="DonGia" type="number" step="0.01" class="form-control" required />
                    <span asp-validation-for="DonGia" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="MaLoai" class="control-label fw-bold">Danh mục (Loại)</label>
                    <select asp-for="MaLoai" class="form-select" asp-items="ViewBag.MaLoai"></select>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Hinh" class="control-label fw-bold">Link ảnh / Tên file ảnh</label>
                    <input asp-for="Hinh" class="form-control" />
                    @if (!string.IsNullOrEmpty(Model?.Hinh))
                    {
                        <div class="mt-2">
                            <img src="@(Model.Hinh.StartsWith("http") ? Model.Hinh : "/Hinh/HangHoa/" + Model.Hinh)"
                                 class="rounded shadow-sm border" style="height: 100px;" />
                        </div>
                    }
                </div>

                <div class="form-group mb-3">
                    <label asp-for="MoTa" class="control-label fw-bold">Mô tả</label>
                    <textarea asp-for="MoTa" class="form-control" rows="4"></textarea>
                </div>

                <div class="form-group mt-4">
                    <button type="submit" class="btn btn-warning">
                        <i class="fa fa-save me-1"></i> Lưu Thay Đổi
                    </button>
                    <a asp-action="Index" class="btn btn-secondary ms-2">Hủy bỏ</a>
                </div>
            </form>
        </div>
    </div>
</div>