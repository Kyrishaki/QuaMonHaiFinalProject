@model LTWEB_QuaMonHai_CuoiKy.Models.HangHoa

@{
    ViewData["Title"] = "Chỉnh sửa sản phẩm";
}

<div class="container py-5" style="max-width: 900px;">
    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-header bg-warning text-white py-3">
            <h4 class="mb-0"><i class="fa fa-edit me-2"></i>Chỉnh Sửa Sản Phẩm</h4>
        </div>
        <div class="card-body p-4">
            <form asp-action="Edit" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <input type="hidden" asp-for="MaHh" />
                <input type="hidden" asp-for="Hinh" /> <!-- Giữ lại tên hình cũ nếu không upload mới -->
                <input type="hidden" asp-for="SoLanXem" />

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="TenHh" class="form-label fw-bold text-muted"></label>
                        <input asp-for="TenHh" class="form-control rounded-pill" />
                        <span asp-validation-for="TenHh" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="TenAlias" class="form-label fw-bold text-muted"></label>
                        <input asp-for="TenAlias" class="form-control rounded-pill" />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="MaLoai" class="form-label fw-bold text-muted">Danh mục</label>
                        <select asp-for="MaLoai" class="form-select rounded-pill" asp-items="ViewBag.MaLoai"></select>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="MaNcc" class="form-label fw-bold text-muted">Nhà cung cấp</label>
                        <select asp-for="MaNcc" class="form-select rounded-pill" asp-items="ViewBag.MaNcc"></select>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="DonGia" class="form-label fw-bold text-muted"></label>
                        <div class="input-group">
                            <span class="input-group-text rounded-start-pill">$</span>
                            <input asp-for="DonGia" class="form-control rounded-end-pill" type="number" step="0.01" />
                        </div>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="GiamGia" class="form-label fw-bold text-muted"></label>
                        <div class="input-group">
                            <input asp-for="GiamGia" class="form-control rounded-start-pill" type="number" />
                            <span class="input-group-text rounded-end-pill">%</span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="MoTaDonVi" class="form-label fw-bold text-muted">Đơn vị</label>
                        <input asp-for="MoTaDonVi" class="form-control rounded-pill" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold text-muted d-block">Hình ảnh hiện tại</label>
                        <img src="@(Model.Hinh != null && Model.Hinh.StartsWith("http") ? Model.Hinh : Url.Content("~/img/Hinh/HangHoa/" + (string.IsNullOrEmpty(Model.Hinh) ? "no-image.jpg" : Model.Hinh)))"
                             alt="Ảnh sản phẩm" class="img-thumbnail mb-2 shadow-sm" style="height: 100px;">
                        <input type="file" name="fHinh" class="form-control rounded-pill" accept="image/*" />
                        <small class="text-info mt-1">Bỏ trống nếu không muốn thay đổi ảnh.</small>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="NgaySx" class="form-label fw-bold text-muted"></label>
                        <input asp-for="NgaySx" class="form-control rounded-pill" type="date" />
                    </div>

                    <div class="col-12">
                        <label asp-for="MoTa" class="form-label fw-bold text-muted"></label>
                        <textarea asp-for="MoTa" class="form-control rounded-3" rows="3"></textarea>
                    </div>
                </div>

                <hr class="my-4" />
                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-light rounded-pill px-4 border">Hủy bỏ</a>
                    <button type="submit" class="btn btn-warning text-white rounded-pill px-4 fw-bold"><i class="fa fa-save me-1"></i> Cập Nhật</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}