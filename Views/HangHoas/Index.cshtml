@model IEnumerable<LTWEB_QuaMonHai_CuoiKy.Models.HangHoa>

@{
    ViewData["Title"] = "Quản lý Hàng Hóa";
    // Lấy thông tin phân trang từ Controller
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Danh sách Hàng hóa</h2>
        <p class="mb-0">
            <a asp-action="Create" class="btn btn-success"><i class="fa fa-plus"></i> Thêm sản phẩm mới</a>
        </p>
    </div>

    <div class="table-responsive shadow-sm rounded">
        <table class="table table-hover table-bordered align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Hình ảnh</th>
                    <th>@Html.DisplayNameFor(model => model.TenHh)</th>
                    <th>@Html.DisplayNameFor(model => model.DonGia)</th>
                    <th>Giảm giá</th>
                    <th>Ngày SX</th>
                    <th>Loại</th>
                    <th>Nhà CC</th>
                    <th class="text-center">Thao tác</th>
                </tr>
            </thead>
            <tbody class="bg-white">
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="text-center">
                            @* Xử lý hiển thị hình ảnh thật từ thư mục wwwroot/Hinh/HangHoa *@
                            <img src="~/Hinh/HangHoa/@item.Hinh" alt="@item.TenHh" style="width: 60px; height: 60px; object-fit: cover;" class="rounded shadow-sm" />
                        </td>
                        <td class="fw-bold">
                            @Html.DisplayFor(modelItem => item.TenHh)
                        </td>
                        <td class="text-primary fw-bold">
                            $@Html.DisplayFor(modelItem => item.DonGia)
                        </td>
                        <td>
                            <span class="badge bg-danger">@Html.DisplayFor(modelItem => item.GiamGia)%</span>
                        </td>
                        <td>
                            @* Hiển thị ngày tháng định dạng ngắn gọn *@
                            @item.NgaySx.ToString("dd/MM/yyyy")
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.MaLoaiNavigation.TenLoai)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.MaNccNavigation.TenCongTy)
                        </td>
                        <td class="text-center">
                            <div class="btn-group" role="group">
                                <a asp-action="Edit" asp-route-id="@item.MaHh" class="btn btn-sm btn-outline-warning">Sửa</a>
                                <a asp-action="Details" asp-route-id="@item.MaHh" class="btn btn-sm btn-outline-info">Xem</a>
                                <a asp-action="Delete" asp-route-id="@item.MaHh" class="btn btn-sm btn-outline-danger">Xóa</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @* THANH PHÂN TRANG CHO BẢNG QUẢN TRỊ *@
    @if (totalPages > 1)
    {
        <div class="d-flex justify-content-center mt-4">
            <nav aria-label="Page navigation">
                <ul class="pagination">
                    @if (currentPage > 1)
                    {
                        <li class="page-item">
                            <a class="page-link" asp-action="Index" asp-route-page="@(currentPage - 1)">Trước</a>
                        </li>
                    }

                    @for (int i = 1; i <= totalPages; i++)
                    {
                        <li class="page-item @(i == currentPage ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@i">@i</a>
                        </li>
                    }

                    @if (currentPage < totalPages)
                    {
                        <li class="page-item">
                            <a class="page-link" asp-action="Index" asp-route-page="@(currentPage + 1)">Sau</a>
                        </li>
                    }
                </ul>
            </nav>
        </div>
    }
</div>