@model IEnumerable<LTWEB_QuaMonHai_CuoiKy.Models.HangHoa>

@{
    ViewData["Title"] = "Cửa Hàng Công Nghệ & Phụ Kiện";
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
}

<div class="container py-5" style="max-width: 1200px;">
    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
        <h2 class="m-0 text-dark"><i class="fa fa-shopping-bag me-2 text-primary"></i>Sản Phẩm Của Chúng Tôi</h2>

        <!-- BẢO MẬT: CHỈ ADMIN & STAFF MỚI THẤY NÚT THÊM MỚI -->
        @if (User.IsInRole("Admin") || User.IsInRole("Staff")) {
            <div>
                <a asp-action="Create" class="btn btn-success rounded-pill px-4 shadow-sm">
                    <i class="fa fa-plus me-1"></i> Thêm mới
                </a>
            </div>
        }
    </div>

    @if (TempData["Success"] != null) {
        <div class="alert alert-success shadow-sm rounded-3">
            <i class="fa fa-check-circle me-2"></i>@TempData["Success"]
        </div>
    }

    <div class="row g-4">
        <!-- SIDEBAR -->
        <div class="col-lg-3 col-md-4">
            <partial name="_Sidebar" />
        </div>

        <!-- DANH SÁCH SẢN PHẨM -->
        <div class="col-lg-9 col-md-8">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4 bg-white border rounded-3 p-3 shadow-sm">
                <span class="text-muted small">Hiển thị <strong class="text-success">@Model.Count()</strong> sản phẩm</span>
                
                <div class="d-flex align-items-center gap-3">
                    @if (User.IsInRole("Admin") || User.IsInRole("Staff")) {
                        <div class="form-check form-switch bg-light border rounded-pill px-4 py-1.5 d-flex align-items-center mb-0">
                            <input class="form-check-input" type="checkbox" id="manageModeToggle" @(ViewBag.ManageMode == true ? "checked" : "") onchange="toggleManageMode(this.checked)" style="cursor: pointer;">
                            <label class="form-check-label fw-bold text-primary ms-2 mb-0" for="manageModeToggle" style="cursor: pointer; font-size: 0.85rem;">Quản lý</label>
                        </div>
                    }

                    <div class="d-flex align-items-center gap-2">
                        <span class="text-muted small text-nowrap"><i class="fa-solid fa-sort text-success me-1"></i>Sắp xếp:</span>
                        <select class="form-select form-select-sm border border-secondary-subtle rounded-pill px-3 py-1 text-dark" style="cursor: pointer; min-width: 170px;" onchange="changeSort(this.value)" data-inspect-id="sort-select">
                            <option value="" selected="@(string.IsNullOrEmpty(ViewBag.CurrentSort))">Mặc định</option>
                            <option value="price_asc" selected="@(ViewBag.CurrentSort == "price_asc")">Giá: Thấp đến Cao</option>
                            <option value="price_desc" selected="@(ViewBag.CurrentSort == "price_desc")">Giá: Cao đến Thấp</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="row g-3">
                @foreach (var item in Model) {
                    <div class="col-sm-6 col-lg-4">
                        <div class="card h-100 shadow-sm border-0 rounded-3 overflow-hidden product-card position-relative" data-inspect-id="product-card">

                            <div class="bg-secondary rounded text-white position-absolute start-0 top-0 m-3 py-1 px-2" style="z-index: 10; font-size: 0.8rem; background-color: rgba(129, 196, 8, 0.9) !important;">
                                @(item.MaLoaiNavigation != null ? item.MaLoaiNavigation.TenLoai : "Sản phẩm")
                            </div>

                            <button type="button" class="btn btn-light rounded-circle shadow-sm position-absolute end-0 top-0 m-3 toggle-favorite-ajax" data-id="@item.MaHh" style="z-index: 10; width: 36px; height: 36px; display: flex; align-items: center; justify-content: center; border: none; transition: transform 0.2s ease;">
                                @if (ViewBag.FavoriteProductIds != null && ((List<int>)ViewBag.FavoriteProductIds).Contains(item.MaHh)) {
                                    <i class="fa-solid fa-heart text-danger fs-5"></i>
                                } else {
                                    <i class="fa-regular fa-heart text-danger fs-5"></i>
                                }
                            </button>

                             <a asp-action="Details" asp-route-id="@item.MaHh" class="text-decoration-none">
                                 <div class="position-relative overflow-hidden bg-white d-flex align-items-center justify-content-center p-3" style="height: 220px; @(!item.HieuLuc || item.SoLuong <= 0 ? "opacity: 0.68;" : "")" data-inspect-id="product-image">
                                     <img src="@Url.Content("~/img/Hinh/HangHoa/" + (string.IsNullOrEmpty(item.Hinh) ? "no-image.jpg" : item.Hinh))"
                                          class="card-img-top img-fluid"
                                          style="max-height: 180px; object-fit: contain; transition: transform 0.3s;"
                                          alt="@item.TenHh"
                                          onmouseover="this.style.transform='scale(1.08)'" onmouseout="this.style.transform='scale(1)'">
                                     @if (!item.HieuLuc) {
                                         <span class="badge bg-danger text-white rounded-pill position-absolute top-50 start-50 translate-middle fw-bold py-2 px-3 shadow" style="font-size: 0.85rem; transform: translate(-50%, -50%) rotate(-12deg) !important; pointer-events: none; z-index: 100; border: 2px solid white;">Ngưng bán</span>
                                     }
                                     else if (item.SoLuong <= 0) {
                                         <span class="badge bg-secondary text-white rounded-pill position-absolute top-50 start-50 translate-middle fw-bold py-2 px-3 shadow" style="font-size: 0.85rem; transform: translate(-50%, -50%) rotate(-12deg) !important; pointer-events: none; z-index: 100; border: 2px solid white; background-color: #6c757d !important;">Hết hàng</span>
                                     }
                                 </div>
                             </a>

                             <div class="card-body d-flex flex-column text-center p-3">
                                 <a asp-action="Details" asp-route-id="@item.MaHh" class="text-decoration-none text-dark">
                                     <h6 class="card-title text-truncate mb-1" title="@item.TenHh">@item.TenHh</h6>
                                 </a>
                                 <div class="d-flex justify-content-between align-items-center mb-3">
                                     <span class="text-primary fw-bold fs-5" style="color: #81c408 !important;">$@item.DonGia</span>
                                     @{
                                         int soldCount = 0;
                                         if (ViewBag.SoldCounts != null) {
                                             var dict = (Dictionary<int, int>)ViewBag.SoldCounts;
                                             if (dict.ContainsKey(item.MaHh)) {
                                                 soldCount = dict[item.MaHh];
                                             }
                                         }
                                     }
                                     <span class="text-muted small" data-inspect-id="product-sold"><i class="fa-solid fa-fire text-danger me-1"></i>Đã bán @soldCount</span>
                                 </div>

                                <!-- BẢO MẬT: PHÂN QUYỀN HIỂN THỊ NÚT Ở TỪNG SẢN PHẨM -->
                                <div class="btn-group mt-auto w-100 shadow-sm rounded-pill overflow-hidden" data-inspect-id="product-actions">

                                    <!-- Nút Xem chi tiết thì ai cũng được bấm -->
                                    <a asp-action="Details" asp-route-id="@item.MaHh" class="btn btn-sm btn-light border-end text-info fw-bold">
                                        <i class="fa fa-eye me-1"></i> Xem
                                    </a>

                                    @if (User.IsInRole("Admin") || User.IsInRole("Staff")) {
                                        <!-- Nếu là Admin hoặc Staff: Hiện nút Sửa -->
                                        <a asp-action="Edit" asp-route-id="@item.MaHh" class="btn btn-sm btn-light border-end text-warning fw-bold">Sửa</a>
                                        @if (User.IsInRole("Admin")) {
                                            @if (item.HieuLuc) {
                                                <a asp-action="Delete" asp-route-id="@item.MaHh" class="btn btn-sm btn-light text-danger fw-bold">Xóa</a>
                                            } else {
                                                <form asp-action="Reactivate" asp-route-id="@item.MaHh" method="post" class="d-inline m-0 p-0 border-0" style="flex: 1 1 auto;">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-light text-success fw-bold w-100 h-100 rounded-0" style="border: none;">Kích hoạt</button>
                                                </form>
                                            }
                                        }
                                    }
                                    else {
                                        <!-- Nếu là Khách thường: Hiện nút Thêm vào giỏ hàng -->
                                        <button type="button" data-id="@item.MaHh" class="btn btn-sm btn-light text-success fw-bold add-to-cart-ajax">
                                            <i class="fa fa-shopping-cart me-1"></i> Thêm giỏ
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- THANH PHÂN TRANG -->
            <partial name="_NumberBar" />

        </div>
    </div>
</div>

<style>
    .product-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .product-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 .5rem 1rem rgba(0,0,0,.15) !important;
        }

    .toggle-favorite-ajax:hover {
        transform: scale(1.15) !important;
        background-color: #fff0f0 !important;
    }

    .pagination .page-link {
        color: #81c408;
        border: none;
        border-radius: 5px;
        margin: 0 4px;
        font-weight: 500;
        cursor: pointer;
    }

    .pagination .page-item.active .page-link {
        background-color: #81c408;
        color: white;
    }

    .pagination .page-item.disabled .page-link {
        color: #6c757d;
        background-color: transparent;
        pointer-events: none;
    }
</style>

@section Scripts {
<script>
    function changeSort(sortBy) {
        const urlParams = new URLSearchParams(window.location.search);
        if (sortBy) {
            urlParams.set('sortBy', sortBy);
        } else {
            urlParams.delete('sortBy');
        }
        urlParams.set('page', '1');
        window.location.search = urlParams.toString();
    }

    function toggleManageMode(isChecked) {
        const urlParams = new URLSearchParams(window.location.search);
        if (isChecked) {
            urlParams.set('manage', 'true');
        } else {
            urlParams.delete('manage');
        }
        urlParams.set('page', '1');
        window.location.search = urlParams.toString();
    }

    $(document).ready(function() {
        // Xử lý nút Thêm vào giỏ hàng bằng AJAX
        $('.add-to-cart-ajax').click(function(e) {
            e.preventDefault();
            var id = $(this).data('id');
            var qty = 1;
            
            $.ajax({
                url: '@Url.Action("AddToCartAjax", "Cart")',
                type: 'POST',
                data: { id: id, quantity: qty },
                success: function(res) {
                    if(res.success) {
                        // Cập nhật số lượng trên icon giỏ hàng
                        var badge = $('.fa-shopping-bag').siblings('.badge');
                        if (badge.length > 0) {
                            badge.text(res.count);
                        } else if (res.count > 0) {
                            $('.fa-shopping-bag').parent().append('<span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size: 0.65rem;">' + res.count + '</span>');
                        }
                        
                        // Show toast
                        showToast("Đã thêm sản phẩm vào giỏ hàng!");
                    } else {
                        alert(res.message || 'Có lỗi xảy ra');
                    }
                }
            });
        });

        // Xử lý nút Yêu thích bằng AJAX
        $('.toggle-favorite-ajax').click(function(e) {
            e.preventDefault();
            var btn = $(this);
            var id = btn.data('id');
            
            $.ajax({
                url: '@Url.Action("ToggleFavorite", "Customer")',
                type: 'POST',
                data: { id: id },
                success: function(res) {
                    if (res.redirectTo) {
                        showToast(res.message);
                        setTimeout(function() {
                            window.location.href = res.redirectTo;
                        }, 1500);
                        return;
                    }
                    
                    if(res.success) {
                        var icon = btn.find('i');
                        if (res.isFavorite) {
                            icon.removeClass('fa-regular').addClass('fa-solid');
                        } else {
                            icon.removeClass('fa-solid').addClass('fa-regular');
                        }
                        showToast(res.message);
                    } else {
                        alert(res.message || 'Có lỗi xảy ra');
                    }
                }
            });
        });

        function showToast(message) {
            $('#customToast').remove(); // remove existing
            var toastHtml = '<div id="customToast" class="position-fixed bottom-0 end-0 p-3" style="z-index: 9999;">' +
                            '<div class="toast align-items-center text-white bg-success border-0 show" role="alert" aria-live="assertive" aria-atomic="true">' +
                            '<div class="d-flex"><div class="toast-body"><i class="fa fa-check-circle me-2"></i>' + message + '</div>' +
                            '<button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close" onclick="$(this).closest(\'#customToast\').remove();"></button>' +
                            '</div></div></div>';
            $('body').append(toastHtml);
            setTimeout(function() {
                $('#customToast').fadeOut(500, function() { $(this).remove(); });
            }, 3000);
        }
    });
</script>
}