@model IEnumerable<LTWEB_QuaMonHai_CuoiKy.Models.HangHoa>

<div class="container py-4">
    <div class="d-flex justify-content-between mb-4">
        <h2>Quản Lý Hàng Hóa (SQL Server)</h2>
        <div>
            <a asp-action="SyncFromApi" class="btn btn-info text-white"><i class="fa fa-sync"></i> Đồng bộ API</a>
            <a asp-action="Create" class="btn btn-primary"><i class="fa fa-plus"></i> Thêm mới</a>
        </div>
    </div>

    <table class="table table-hover align-middle shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>Ảnh</th>
                <th>Tên sản phẩm</th>
                <th>Giá ($)</th>
                <th>Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td><img src="@(item.Hinh.StartsWith("http") ? item.Hinh : "/Hinh/HangHoa/" + item.Hinh)" width="60" class="rounded border" /></td>
                    <td class="fw-bold">@item.TenHh</td>
                    <td class="text-primary">$@item.DonGia</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.MaHh" class="btn btn-sm btn-warning">Sửa</a>
                        <a asp-action="Details" asp-route-id="@item.MaHh" class="btn btn-sm btn-info">Chi tiết</a>
                        <a asp-action="Delete" asp-route-id="@item.MaHh" class="btn btn-sm btn-danger">Xóa</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>