@model IEnumerable<LTWEB_QuaMonHai_CuoiKy.Models.HangHoa>

@{
    ViewData["Title"] = "Cửa Hàng Thực Phẩm";
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
}

<div class="container py-5" style="max-width: 1200px;">
    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
        <h2 class="m-0 text-dark"><i class="fa fa-shopping-bag me-2 text-primary"></i>Sản Phẩm Của Chúng Tôi</h2>

        <!-- BẢO MẬT: CHỈ ADMIN MỚI THẤY NÚT THÊM MỚI -->
        @if (User.IsInRole("Admin")) {
            <div>
                <a asp-action="Create" class="btn btn-success rounded-pill px-4 shadow-sm">
                    <i class="fa fa-plus me-1"></i> Thêm mới (Admin)
                </a>
            </div>
        }
    </div>

    @if (TempData["Success"] != null) {
        <div class="alert alert-success shadow-sm rounded-3">
            <i class="fa fa-check-circle me-2"></i>@TempData["Success"]
        </div>
    }

    <div class="row g-4">
        <!-- SIDEBAR -->
        <div class="col-lg-3 col-md-4">
            <partial name="_Sidebar" />
        </div>

        <!-- DANH SÁCH SẢN PHẨM -->
        <div class="col-lg-9 col-md-8">
            <div class="row g-3">
                @foreach (var item in Model) {
                    <div class="col-sm-6 col-lg-4">
                        <div class="card h-100 shadow-sm border-0 rounded-3 overflow-hidden product-card position-relative">

                            <div class="bg-secondary rounded text-white position-absolute start-0 top-0 m-3 py-1 px-2" style="z-index: 10; font-size: 0.8rem; background-color: rgba(129, 196, 8, 0.9) !important;">
                                @(item.MaLoaiNavigation != null ? item.MaLoaiNavigation.TenLoai : "Sản phẩm")
                            </div>

                            <img src="@Url.Content("~/img/Hinh/HangHoa/" + (string.IsNullOrEmpty(item.Hinh) ? "no-image.jpg" : item.Hinh))"
                                 class="card-img-top"
                                 style="height: 220px; width: 100%; object-fit: cover; object-position: center;"
                                 alt="@item.TenHh">

                            <div class="card-body d-flex flex-column text-center p-3">
                                <h6 class="card-title text-truncate mb-1" title="@item.TenHh">@item.TenHh</h6>
                                <p class="text-primary fw-bold fs-5 mb-3" style="color: #81c408 !important;">$@item.DonGia</p>

                                <!-- BẢO MẬT: PHÂN QUYỀN HIỂN THỊ NÚT Ở TỪNG SẢN PHẨM -->
                                <div class="btn-group mt-auto w-100 shadow-sm rounded-pill overflow-hidden">

                                    <!-- Nút Xem chi tiết thì ai cũng được bấm -->
                                    <a asp-action="Details" asp-route-id="@item.MaHh" class="btn btn-sm btn-light border-end text-info fw-bold">
                                        <i class="fa fa-eye me-1"></i> Xem
                                    </a>

                                    @if (User.IsInRole("Admin")) {
                                        <!-- Nếu là Admin: Hiện nút Sửa và Xóa -->
                                        <a asp-action="Edit" asp-route-id="@item.MaHh" class="btn btn-sm btn-light border-end text-warning fw-bold">Sửa</a>
                                        <a asp-action="Delete" asp-route-id="@item.MaHh" class="btn btn-sm btn-light text-danger fw-bold">Xóa</a>
                                    }
                                    else {
                                        <!-- Nếu là Khách thường: Hiện nút Thêm vào giỏ hàng -->
                                        <button type="button" data-id="@item.MaHh" class="btn btn-sm btn-light text-success fw-bold add-to-cart-ajax">
                                            <i class="fa fa-shopping-cart me-1"></i> Thêm giỏ
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- THANH PHÂN TRANG -->
            <partial name="_NumberBar" />

        </div>
    </div>
</div>

<style>
    .product-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .product-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 .5rem 1rem rgba(0,0,0,.15) !important;
        }

    .pagination .page-link {
        color: #81c408;
        border: none;
        border-radius: 5px;
        margin: 0 4px;
        font-weight: 500;
        cursor: pointer;
    }

    .pagination .page-item.active .page-link {
        background-color: #81c408;
        color: white;
    }

    .pagination .page-item.disabled .page-link {
        color: #6c757d;
        background-color: transparent;
        pointer-events: none;
    }
</style>

@section Scripts {
<script>
    $(document).ready(function() {
        // Xử lý nút Thêm vào giỏ hàng bằng AJAX
        $('.add-to-cart-ajax').click(function(e) {
            e.preventDefault();
            var id = $(this).data('id');
            var qty = 1;
            
            $.ajax({
                url: '@Url.Action("AddToCartAjax", "Cart")',
                type: 'POST',
                data: { id: id, quantity: qty },
                success: function(res) {
                    if(res.success) {
                        // Cập nhật số lượng trên icon giỏ hàng
                        var badge = $('.fa-shopping-bag').siblings('.badge');
                        if (badge.length > 0) {
                            badge.text(res.count);
                        } else if (res.count > 0) {
                            $('.fa-shopping-bag').parent().append('<span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size: 0.65rem;">' + res.count + '</span>');
                        }
                        
                        // Show toast
                        showToast("Đã thêm sản phẩm vào giỏ hàng!");
                    } else {
                        alert(res.message || 'Có lỗi xảy ra');
                    }
                }
            });
        });

        function showToast(message) {
            $('#customToast').remove(); // remove existing
            var toastHtml = '<div id="customToast" class="position-fixed bottom-0 end-0 p-3" style="z-index: 9999;">' +
                            '<div class="toast align-items-center text-white bg-success border-0 show" role="alert" aria-live="assertive" aria-atomic="true">' +
                            '<div class="d-flex"><div class="toast-body"><i class="fa fa-check-circle me-2"></i>' + message + '</div>' +
                            '<button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close" onclick="$(this).closest(\'#customToast\').remove();"></button>' +
                            '</div></div></div>';
            $('body').append(toastHtml);
            setTimeout(function() {
                $('#customToast').fadeOut(500, function() { $(this).remove(); });
            }, 3000);
        }
    });
</script>
}