@model LTWEB_QuaMonHai_CuoiKy.ViewModels.ForgotPasswordVM
@{
    ViewData["Title"] = "Quên Mật Khẩu";
}

<div class="container-fluid py-5" style="background-color: #f4f6f8;">
    <div class="container py-5">
        <div class="row g-0 shadow-lg rounded-4 overflow-hidden bg-white" style="min-height: 550px;">
            <div class="col-lg-6 d-none d-lg-flex flex-column justify-content-center align-items-center text-white position-relative" style="background: url('/img/vegetable-item-4.jpg') center/cover no-repeat;">
                <div class="position-absolute top-0 start-0 w-100 h-100" style="background: rgba(129, 196, 8, 0.85);"></div>
                <div class="position-relative z-1 text-center p-5">
                    <h1 class="display-3 text-white fw-bold mb-4">QuaMonHai</h1>
                    <h4 class="text-white mb-4">Hệ thống mua sắm công nghệ & phụ kiện cao cấp!</h4>
                    <p class="fs-5 mb-4">Đừng lo lắng, chúng tôi sẽ giúp bạn lấy lại quyền truy cập tài khoản một cách nhanh chóng.</p>
                </div>
            </div>

            <div class="col-lg-6 p-5 d-flex flex-column justify-content-center">
                <div class="text-center mb-4">
                    <h2 class="text-primary fw-bold">Quên Mật Khẩu</h2>
                    <p class="text-muted">Nhập tên đăng nhập và email đã đăng ký để nhận mã OTP</p>
                </div>

                <form asp-action="QuenMatKhau" method="post">
                    <div class="text-danger mb-3" asp-validation-summary="ModelOnly"></div>

                    <div class="form-floating mb-4">
                        <input asp-for="UserName" type="text" class="form-control rounded-pill px-4" id="floatingUser" placeholder="Tên đăng nhập">
                        <label for="floatingUser" class="ms-3 text-muted">Tên đăng nhập *</label>
                        <span asp-validation-for="UserName" class="text-danger small ms-3"></span>
                    </div>

                    <div class="form-floating mb-4">
                        <input asp-for="Email" type="email" class="form-control rounded-pill px-4" id="floatingEmail" placeholder="Email">
                        <label for="floatingEmail" class="ms-3 text-muted">Email đã đăng ký *</label>
                        <span asp-validation-for="Email" class="text-danger small ms-3"></span>
                    </div>

                    <div class="d-grid gap-3 mb-4">
                        <button type="submit" class="btn text-white rounded-pill py-3 fw-bold shadow-sm" style="background-color: #81c408; font-size: 1.1rem;">
                            GỬI MÃ XÁC THỰC OTP
                        </button>
                    </div>

                    <div class="text-center mt-2">
                        <a asp-action="DangNhap" class="text-primary text-decoration-none small fw-bold"><i class="fa fa-arrow-left me-1"></i> Quay lại trang Đăng nhập</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>