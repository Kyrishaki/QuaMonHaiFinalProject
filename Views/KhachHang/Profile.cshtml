@model LTWEB_QuaMonHai_CuoiKy.Models.KhachHang
@{
    ViewData["Title"] = "Hồ Sơ Cá Nhân";
}

<div class="container py-5" style="max-width: 1000px;">
    <div class="row mb-4">
        <div class="col-12">
            <h2 class="text-primary fw-bold border-bottom pb-3"><i class="fa fa-id-card me-2"></i>Hồ Sơ Cá Nhân</h2>
        </div>
    </div>

    <!-- Hiện thông báo thành công nếu có -->
    @if (TempData["Success"] != null) {
        <div class="alert alert-success alert-dismissible fade show shadow-sm rounded-3" role="alert">
            <i class="fa fa-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4">
        <!-- CỘT TRÁI: THÔNG TIN CƠ BẢN & AVATAR -->
        <div class="col-md-4">
            <div class="card shadow-sm border-0 rounded-3 text-center p-4">
                <div class="position-relative d-inline-block mx-auto mb-3">
                    <img src="@Url.Content("~/img/Hinh/khachHang/" + (string.IsNullOrEmpty(Model.Hinh) ? "Photo.gif" : Model.Hinh))"
                         alt="Avatar" class="rounded-circle img-thumbnail shadow-sm"
                         style="width: 150px; height: 150px; object-fit: cover; border-width: 3px !important; border-color: #81c408 !important;">
                </div>
                <h4 class="fw-bold text-dark mb-1">@Model.HoTen</h4>
                <p class="text-muted mb-3">@@@Model.MaKh</p>

                @if (Model.VaiTro == 1) {
                    <span class="badge bg-danger rounded-pill px-3 py-2 fw-bold shadow-sm mb-3"><i class="fa fa-star me-1"></i> Quản Trị Viên (Admin)</span>
                }
                else {
                    <span class="badge bg-success rounded-pill px-3 py-2 fw-bold shadow-sm mb-3"><i class="fa fa-user me-1"></i> Khách Hàng</span>
                }

                <div class="d-grid mt-3 gap-2">
                    <a asp-action="DoiMatKhau" class="btn btn-warning rounded-pill fw-bold text-dark shadow-sm"><i class="fa fa-key me-2"></i>Đổi mật khẩu</a>
                    <a asp-action="DangXuat" class="btn btn-outline-danger rounded-pill fw-bold"><i class="fa fa-sign-out-alt me-2"></i>Đăng xuất ngay</a>
                </div>
            </div>
        </div>

        <!-- CỘT PHẢI: FORM CHỈNH SỬA THÔNG TIN -->
        <div class="col-md-8">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-header bg-white pb-0 border-0 mt-3 ms-3">
                    <h5 class="fw-bold text-dark mb-0">Cập nhật thông tin</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Profile" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <!-- Giấu các trường không cho sửa vào thẻ hidden -->
                        <input type="hidden" asp-for="MaKh" />
                        <input type="hidden" asp-for="MatKhau" />
                        <input type="hidden" asp-for="Hinh" />
                        <input type="hidden" asp-for="VaiTro" />
                        <input type="hidden" asp-for="HieuLuc" />
                        <input type="hidden" asp-for="RandomKey" />

                        <div class="row g-3">
                            <!-- Họ và Tên -->
                            <div class="col-md-12">
                                <label asp-for="HoTen" class="form-label fw-bold text-muted">Họ và tên</label>
                                <input asp-for="HoTen" class="form-control rounded-pill" required />
                                <span asp-validation-for="HoTen" class="text-danger small"></span>
                            </div>

                            <!-- Giới tính -->
                            <div class="col-md-6">
                                <label class="form-label fw-bold text-muted d-block">Giới tính</label>
                                <div class="d-flex gap-3 px-2 mt-2">
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" asp-for="GioiTinh" value="true" id="nam">
                                        <label class="form-check-label" for="nam">Nam</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" asp-for="GioiTinh" value="false" id="nu">
                                        <label class="form-check-label" for="nu">Nữ</label>
                                    </div>
                                </div>
                            </div>

                            <!-- Ngày sinh -->
                            <div class="col-md-6">
                                <label asp-for="NgaySinh" class="form-label fw-bold text-muted">Ngày sinh</label>
                                <!-- Đổi format để thẻ input type="date" có thể đọc được -->
                                <input asp-for="NgaySinh" type="date" class="form-control rounded-pill" asp-format="{0:yyyy-MM-dd}" />
                            </div>

                            <!-- Số điện thoại -->
                            <div class="col-md-6">
                                <label asp-for="DienThoai" class="form-label fw-bold text-muted">Số điện thoại</label>
                                <input asp-for="DienThoai" class="form-control rounded-pill" />
                            </div>

                            <!-- Email -->
                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label fw-bold text-muted">Địa chỉ Email</label>
                                <input asp-for="Email" type="email" class="form-control rounded-pill" required />
                            </div>

                            <!-- Địa chỉ -->
                            <div class="col-12">
                                <label asp-for="DiaChi" class="form-label fw-bold text-muted">Địa chỉ liên hệ</label>
                                <input asp-for="DiaChi" class="form-control rounded-pill" />
                            </div>

                            <!-- Đổi Avatar -->
                            <div class="col-12">
                                <label class="form-label fw-bold text-muted">Đổi ảnh đại diện (Tùy chọn)</label>
                                <input type="file" name="fHinh" class="form-control rounded-pill" accept="image/*" />
                            </div>
                        </div>

                        <hr class="my-4" />
                        <div class="d-flex justify-content-end gap-3">
                            <button type="submit" class="btn btn-success rounded-pill px-5 fw-bold shadow-sm" style="background-color: #81c408; border-color: #81c408;">
                                <i class="fa fa-save me-2"></i>Lưu Thay Đổi
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}