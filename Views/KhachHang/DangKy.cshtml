@model LTWEB_QuaMonHai_CuoiKy.ViewModels.RegisterVM
@{
    ViewData["Title"] = "Đăng Ký";
}
<div class="container-fluid py-5" style="background-color: #f4f6f8;">
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
                    <div class="card-header bg-primary text-white text-center py-4" style="background-color: #81c408 !important;">
                        <h2 class="mb-0 fw-bold text-white"><i class="fa fa-user-plus me-2"></i>Đăng ký Thành viên</h2>
                        <p class="mb-0 text-white-50">Gia nhập cộng đồng Foody ngay hôm nay</p>
                    </div>
                    <div class="card-body p-4 p-md-5">
                        <form asp-action="DangKy" enctype="multipart/form-data">
                            <div class="row g-4">
                                <div class="col-md-6">
                                    <label asp-for="@Model.MaKh" class="form-label fw-bold text-muted">Tên đăng nhập <sup class="text-danger">*</sup></label>
                                    <input asp-for="@Model.MaKh" type="text" class="form-control rounded-pill px-3">
                                    <span asp-validation-for="@Model.MaKh" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="@Model.MatKhau" class="form-label fw-bold text-muted">Mật khẩu <sup class="text-danger">*</sup></label>
                                    <input asp-for="@Model.MatKhau" type="password" class="form-control rounded-pill px-3">
                                    <span asp-validation-for="@Model.MatKhau" class="text-danger small"></span>
                                </div>

                                <div class="col-md-6">
                                    <label asp-for="@Model.HoTen" class="form-label fw-bold text-muted">Họ và tên <sup class="text-danger">*</sup></label>
                                    <input asp-for="@Model.HoTen" class="form-control rounded-pill px-3" />
                                    <span asp-validation-for="@Model.HoTen" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="@Model.NgaySinh" class="form-label fw-bold text-muted">Ngày sinh</label>
                                    <input asp-for="@Model.NgaySinh" type="date" class="form-control rounded-pill px-3" />
                                    <span asp-validation-for="@Model.NgaySinh" class="text-danger small"></span>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-bold text-muted d-block">Giới tính</label>
                                    <div class="d-flex gap-4 mt-2 px-2">
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" asp-for="GioiTinh" value="true" id="gioiTinhNam">
                                            <label class="form-check-label" for="gioiTinhNam">Nam</label>
                                        </div>
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" asp-for="GioiTinh" value="false" id="gioiTinhNu">
                                            <label class="form-check-label" for="gioiTinhNu">Nữ</label>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="@Model.DienThoai" class="form-label fw-bold text-muted">Điện thoại <sup class="text-danger">*</sup></label>
                                    <input asp-for="@Model.DienThoai" class="form-control rounded-pill px-3" />
                                    <span asp-validation-for="@Model.DienThoai" class="text-danger small"></span>
                                </div>

                                <div class="col-12">
                                    <label asp-for="@Model.DiaChi" class="form-label fw-bold text-muted">Địa chỉ <sup class="text-danger">*</sup></label>
                                    <input asp-for="@Model.DiaChi" class="form-control rounded-pill px-3" />
                                    <span asp-validation-for="@Model.DiaChi" class="text-danger small"></span>
                                </div>

                                <div class="col-md-6">
                                    <label asp-for="Email" class="form-label fw-bold text-muted">Email <sup class="text-danger">*</sup></label>
                                    <div class="input-group">
                                        <input asp-for="Email" type="email" class="form-control" style="border-radius: 50rem 0 0 50rem;" id="emailInput">
                                        <button type="button" class="btn btn-secondary" style="border-radius: 0 50rem 50rem 0;" id="btnSendCode">Gửi mã</button>
                                    </div>
                                    <span asp-validation-for="Email" class="text-danger small"></span>
                                </div>

                                <div class="col-md-6" id="verificationSection" style="display: none;">
                                    <label class="form-label fw-bold text-muted">Mã xác thực <sup class="text-danger">*</sup></label>
                                    <input asp-for="VerificationCode" class="form-control rounded-pill px-3" placeholder="Nhập mã 6 số">
                                    <span asp-validation-for="VerificationCode" class="text-danger small"></span>
                                </div>

                                <div class="col-12">
                                    <label class="form-label fw-bold text-muted" for="Hinh">Hình đại diện <sup class="text-danger">*</sup></label>
                                    <input type="file" name="Hinh" class="form-control rounded-pill px-3" accept="image/*" />
                                </div>

                                <div class="col-12 text-center mt-5">
                                    <button type="submit" class="btn text-white rounded-pill py-3 px-5 fw-bold shadow-sm" style="background-color: #81c408; font-size: 1.1rem; width: 100%; max-width: 400px;">
                                        ĐĂNG KÝ TÀI KHOẢN
                                    </button>
                                    <p class="mt-3">Đã có tài khoản? <a asp-controller="KhachHang" asp-action="DangNhap" class="text-primary fw-bold">Đăng nhập tại đây</a></p>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $("#btnSendCode").click(function () {
            var email = $("#emailInput").val();
            if(!email) { alert("Hãy nhập email!"); return; }

            var btn = $(this);
            btn.prop('disabled', true).text("Đang gửi...");

            $.post('/KhachHang/SendVerificationCode', { email: email }, function (res) {
                if (res.success) {
                    $("#verificationSection").slideDown();
                    alert("Đã gửi mã thành công!");
                } else {
                    alert(res.message);
                }
                btn.prop('disabled', false).text("Gửi lại mã");
            });
        });
    </script>
}