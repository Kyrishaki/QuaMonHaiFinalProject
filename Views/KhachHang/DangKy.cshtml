@model LTWEB_QuaMonHai_CuoiKy.ViewModels.RegisterVM
@{
    ViewData["Title"] = "Đăng Ký";
}
<div class="container-fluid py-5">
    <div class="container py-5">
        <h1 class="mb-4">Đăng ký Thành viên</h1>
        <form asp-action="DangKy" enctype="multipart/form-data">

            <div class ="row">

                <div class="col-md-12 col-lg-6">
                    <div class="form-item w-100">
                        <label asp-for="@Model.MaKh" class="form-label my-3"> </label><sup>*</sup>
                        <input  asp-for="@Model.MaKh" type="text" class="form-control">
                        <span asp-validation-for="@Model.MaKh" class="text-danger"></span> 
                    </div>
                </div>

                <div class="col-md-12 col-lg-6">
                    <label asp-for="@Model.MatKhau" class="form-label my-3"> </label><sup>*</sup>
                    <input asp-for="@Model.MatKhau" type="password" class="form-control">
                    <span asp-validation-for="@Model.MatKhau" class="text-danger"></span>
                </div>

                <div class="form-item">
                    <label class="form-label my-3" asp-for="@Model.HoTen"></label><sup>*</sup>
                    <input asp-for="@Model.HoTen" class="form-control" />
                    <span asp-validation-for="@Model.HoTen" class="text-danger"></span>
                </div>

@*                 <div class="form-check my-3">
                    <input asp-for="@Model.GioiTinh" class="form-check-input">
                    <label class="form-check-label" for="GioiTinh">Nam?</label>
                </div> *@

                <div class="my-3">
                    <label class="form-label d-block">Giới tính</label>

                    <!-- Lựa chọn Nam (tương ứng true) -->
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio"
                               asp-for="GioiTinh" value="true" id="gioiTinhNam">
                        <label class="form-check-label" for="gioiTinhNam">Nam</label>
                    </div>

                    <!-- Lựa chọn Nữ (tương ứng false) -->
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio"
                               asp-for="GioiTinh" value="false" id="gioiTinhNu">
                        <label class="form-check-label" for="gioiTinhNu">Nữ</label>
                    </div>
                </div>

                <div class="form-item">
                    <label class="form-label my-3" asp-for="@Model.NgaySinh"></label>
                    <input asp-for="@Model.NgaySinh" class="form-control" />
                    <span asp-validation-for="@Model.NgaySinh" class="text-danger"></span>
                </div>

                <div class="form-item">
                    <label class="form-label my-3" asp-for="@Model.DiaChi"></label><sup>*</sup>
                    <input asp-for="@Model.DiaChi" class="form-control" />
                    <span asp-validation-for="@Model.DiaChi" class="text-danger"></span>
                </div>

                <div class="form-item">
                    <label class="form-label my-3" asp-for="@Model.DienThoai"></label><sup>*</sup>
                    <input asp-for="@Model.DienThoai" class="form-control" />
                    <span asp-validation-for="@Model.DienThoai" class="text-danger"></span>
                </div>

                @* bo sung xac thuc email *@
                <div class="col-md-12 col-lg-6">
                    <div class="form-item w-100">
                        <label asp-for="Email" class="form-label my-3"></label><sup>*</sup>
                        <div class="input-group">
                            <input asp-for="Email" type="email" class="form-control" id="emailInput">
                            <button type="button" class="btn btn-secondary" id="btnSendCode">Gửi mã</button>
                        </div>
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                </div>

                <div class="col-md-12 col-lg-6" id="verificationSection" style="display:none;">
                    <div class="form-item w-100">
                        <label class="form-label my-3">Mã xác thực</label><sup>*</sup>
                        <input asp-for="VerificationCode" class="form-control" placeholder="Nhập mã 6 số">
                        <span asp-validation-for="VerificationCode" class="text-danger"></span>
                    </div>
                </div>
                @* het phan bo sung xac thuc email *@
                <div class="form-item">
                    <label class="form-label my-3" for="Hinh">Hình<sup>*</sup></label>
                    <input type="file" name="Hinh" class="form-control" />
                </div>

                <div class="row g-4 text-center align-items-center justify-content-center pt-4">
                    <button type="submit" class="btn border-secondary py-3 px-4 text-uppercase w-100 text-primary">Đăng ký</button>
                </div>

            </div>
        </form>
    </div>
</div>


@section Scripts {
    <script>
        $("#btnSendCode").click(function () {
            var email = $("#emailInput").val();
            if(!email) { alert("Hãy nhập email!"); return; }

            var btn = $(this);
            btn.prop('disabled', true).text("Đang gửi...");

            $.post('/KhachHang/SendVerificationCode', { email: email }, function (res) {
                if (res.success) {
                    $("#verificationSection").slideDown();
                    alert("Đã gửi mã thành công!");
                } else {
                    alert(res.message);
                }
                btn.prop('disabled', false).text("Gửi lại mã");
            });
        });
    </script>
}