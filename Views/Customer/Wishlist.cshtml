@model IEnumerable<LTWEB_QuaMonHai_CuoiKy.Models.YeuThich>

@{
    ViewData["Title"] = "Sản phẩm yêu thích";
}

<div class="container py-5 mt-5" style="max-width: 1200px;">
    <div class="row g-4">
        <!-- Sidebar cột trái (3/12) -->
        <div class="col-lg-3 col-md-4">
            <partial name="_CustomerSidebar" />
        </div>

        <!-- Nội dung chính cột phải (9/12) -->
        <div class="col-lg-9 col-md-8">
            <div class="card shadow-sm border-0 rounded-3 bg-white p-4">
                <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
                    <h4 class="fw-bold text-dark m-0"><i class="fa fa-heart me-2 text-danger"></i>Sản Phẩm Yêu Thích</h4>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-success rounded-pill px-4 btn-sm fw-bold transition-all" style="border-width: 2px;">
                        <i class="fa fa-shopping-bag me-1"></i> Tiếp tục mua sắm
                    </a>
                </div>

                @if (!Model.Any()) {
                    <div id="empty-wishlist" class="text-center py-5">
                        <div class="mb-4">
                            <i class="fa-regular fa-heart text-muted" style="font-size: 5rem; opacity: 0.3;"></i>
                        </div>
                        <h5 class="text-secondary fw-bold">Danh sách yêu thích của bạn đang trống</h5>
                        <p class="text-muted mb-4 small">Hãy khám phá các sản phẩm tuyệt vời của chúng tôi và thêm chúng vào danh sách yêu thích nhé!</p>
                        <a asp-controller="Home" asp-action="Index" class="btn btn-success rounded-pill px-5 py-2.5 shadow-sm fw-bold" style="background-color: var(--primary); border: none;">
                            Khám phá ngay
                        </a>
                    </div>
                } else {
                    <div id="wishlist-container" class="row g-4" data-inspect-id="wishlist-table">
                        @foreach (var item in Model) {
                            var hh = item.MaHhNavigation;
                            if (hh != null) {
                                <div class="col-sm-6 col-md-6 col-lg-4 wishlist-item" id="wishlist-item-@hh.MaHh">
                                    <div class="card h-100 shadow-sm border-0 rounded-4 overflow-hidden product-card position-relative transition-all" style="transition: transform 0.3s ease, box-shadow 0.3s ease;">
                                        
                                        <!-- Bỏ thích AJAX -->
                                        <button type="button" class="btn btn-light rounded-circle shadow-sm position-absolute end-0 top-0 m-3 remove-favorite-btn" data-id="@hh.MaHh" data-inspect-id="wishlist-remove-btn" style="z-index: 10; width: 36px; height: 36px; display: flex; align-items: center; justify-content: center; border: none; transition: transform 0.2s ease;">
                                            <i class="fa-solid fa-heart text-danger fs-5"></i>
                                        </button>

                                        <!-- Nhãn Loại sản phẩm -->
                                        <div class="badge rounded text-white position-absolute start-0 top-0 m-3 py-1.5 px-2.5" style="z-index: 10; font-size: 0.75rem; background-color: var(--primary) !important;">
                                            @(hh.MaLoaiNavigation != null ? hh.MaLoaiNavigation.TenLoai : "Sản phẩm")
                                        </div>

                                        <a asp-controller="HangHoas" asp-action="Details" asp-route-id="@hh.MaHh" class="text-decoration-none">
                                            <div class="overflow-hidden bg-light d-flex align-items-center justify-content-center p-3" style="height: 180px;">
                                                <img src="@Url.Content("~/img/Hinh/HangHoa/" + (string.IsNullOrEmpty(hh.Hinh) ? "no-image.jpg" : hh.Hinh))"
                                                     class="img-fluid"
                                                     style="max-height: 150px; object-fit: contain; transition: transform 0.3s;"
                                                     alt="@hh.TenHh"
                                                     onmouseover="this.style.transform='scale(1.08)'" onmouseout="this.style.transform='scale(1)'">
                                            </div>
                                        </a>

                                        <!-- Thân card -->
                                        <div class="card-body d-flex flex-column justify-content-between p-3 bg-white">
                                            <div class="text-center mb-3">
                                                <a asp-controller="HangHoas" asp-action="Details" asp-route-id="@hh.MaHh" class="text-decoration-none text-dark">
                                                    <h6 class="card-title text-dark fw-bold text-truncate-2 mb-2" title="@hh.TenHh" style="font-size: 0.95rem; height: 40px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                                        @hh.TenHh
                                                    </h6>
                                                </a>
                                                <div class="d-flex justify-content-between align-items-center mb-0">
                                                    <span class="fw-bold text-danger fs-5">$@hh.DonGia</span>
                                                    @{
                                                        int wlSoldCount = 0;
                                                        if (ViewBag.SoldCounts != null) {
                                                            var dict = (Dictionary<int, int>)ViewBag.SoldCounts;
                                                            if (dict.ContainsKey(hh.MaHh)) {
                                                                wlSoldCount = dict[hh.MaHh];
                                                            }
                                                        }
                                                    }
                                                    <span class="text-muted small"><i class="fa-solid fa-fire text-danger me-1"></i>Đã bán @wlSoldCount</span>
                                                </div>
                                            </div>

                                            <div class="btn-group mt-auto w-100 shadow-sm rounded-pill overflow-hidden">
                                                <a asp-controller="HangHoas" asp-action="Details" asp-route-id="@hh.MaHh" class="btn btn-sm btn-light border-end text-info fw-bold py-2">
                                                    <i class="fa fa-eye me-1"></i> Chi tiết
                                                </a>

                                                <button type="button" data-id="@hh.MaHh" class="btn btn-sm btn-light text-success fw-bold add-to-cart-ajax py-2" style="color: var(--primary) !important;">
                                                    <i class="fa fa-shopping-cart me-1"></i> Thêm giỏ
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                    </div>

                    <div id="empty-wishlist" class="text-center py-5 d-none">
                        <div class="mb-4">
                            <i class="fa-regular fa-heart text-muted" style="font-size: 5rem; opacity: 0.3;"></i>
                        </div>
                        <h5 class="text-secondary fw-bold">Danh sách yêu thích của bạn đang trống</h5>
                        <p class="text-muted mb-4 small">Hãy khám phá các sản phẩm tuyệt vời của chúng tôi và thêm chúng vào danh sách yêu thích nhé!</p>
                        <a asp-controller="Home" asp-action="Index" class="btn btn-success rounded-pill px-5 py-2.5 shadow-sm fw-bold" style="background-color: var(--primary); border: none;">
                            Khám phá ngay
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<style>
    .product-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 .5rem 1rem rgba(0,0,0,.1) !important;
    }

    .remove-favorite-btn:hover {
        transform: scale(1.15) !important;
        background-color: #fff0f0 !important;
    }

    .text-truncate-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        text-overflow: ellipsis;
    }
</style>

@section Scripts {
<script>
    $(document).ready(function() {
        // Xử lý nút Thêm vào giỏ hàng bằng AJAX
        $('.add-to-cart-ajax').click(function(e) {
            e.preventDefault();
            var id = $(this).data('id');
            var qty = 1;
            
            $.ajax({
                url: '@Url.Action("AddToCartAjax", "Cart")',
                type: 'POST',
                data: { id: id, quantity: qty },
                success: function(res) {
                    if(res.success) {
                        // Cập nhật số lượng trên icon giỏ hàng
                        var badge = $('.fa-shopping-bag').siblings('.badge');
                        if (badge.length > 0) {
                            badge.text(res.count);
                        } else if (res.count > 0) {
                            $('.fa-shopping-bag').parent().append('<span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size: 0.65rem;">' + res.count + '</span>');
                        }
                        
                        // Show toast
                        showToast("Đã thêm sản phẩm vào giỏ hàng!");
                    } else {
                        showToast(res.message || 'Có lỗi xảy ra', 'error');
                    }
                }
            });
        });

        // Xử lý xóa yêu thích bằng AJAX
        $('.remove-favorite-btn').click(function(e) {
            e.preventDefault();
            var btn = $(this);
            var id = btn.data('id');
            
            $.ajax({
                url: '@Url.Action("ToggleFavorite", "Customer")',
                type: 'POST',
                data: { id: id },
                success: function(res) {
                    if(res.success && !res.isFavorite) {
                        // Tìm card sản phẩm và làm mờ biến mất
                        var itemCard = $('#wishlist-item-' + id);
                        itemCard.fadeOut(400, function() {
                            $(this).remove();
                            // Kiểm tra xem còn sản phẩm nào không
                            if ($('.wishlist-item').length === 0) {
                                $('#wishlist-container').remove();
                                $('#empty-wishlist').removeClass('d-none');
                            }
                        });
                        showToast("Đã xóa sản phẩm khỏi danh sách yêu thích!");
                    } else {
                        showToast(res.message || 'Có lỗi xảy ra', 'error');
                    }
                }
            });
        });

        function showToast(message, type = 'success') {
            $('#customToast').remove();
            var bgClass = type === 'error' ? 'bg-danger' : 'bg-success';
            var iconClass = type === 'error' ? 'fa-exclamation-circle' : 'fa-check-circle';
            var toastHtml = '<div id="customToast" class="position-fixed bottom-0 end-0 p-3" style="z-index: 9999;">' +
                            '<div class="toast align-items-center text-white ' + bgClass + ' border-0 show" role="alert" aria-live="assertive" aria-atomic="true">' +
                            '<div class="d-flex"><div class="toast-body"><i class="fa ' + iconClass + ' me-2"></i>' + message + '</div>' +
                            '<button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close" onclick="$(this).closest(\'#customToast\').remove();"></button>' +
                            '</div></div></div>';
            $('body').append(toastHtml);
            setTimeout(function() {
                $('#customToast').fadeOut(500, function() { $(this).remove(); });
            }, 3000);
        }
    });
</script>
}
