@model LTWEB_QuaMonHai_CuoiKy.Models.KhachHang
@{
    ViewData["Title"] = "Hồ Sơ Cá Nhân";
}

<div class="container py-5" style="max-width: 1000px;">
    <div class="row mb-4">
        <div class="col-12">
            <h2 class="text-primary fw-bold border-bottom pb-3"><i class="fa fa-id-card me-2"></i>Hồ Sơ Cá Nhân</h2>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm rounded-3" role="alert">
            <i class="fa fa-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4">
        <div class="col-md-4">
            <div class="card shadow-sm border-0 rounded-3 text-center p-4">

                <div class="position-relative d-inline-block mx-auto mb-3" id="btnClickAvatar" style="width: 150px; height: 150px; cursor: pointer;">
                    @{
                        string avatarFile = "default1.svg";
                        if (!string.IsNullOrEmpty(Model.Hinh))
                        {
                            if (Model.Hinh == "default-avatar.jpg" || Model.Hinh == "Photo.gif")
                            {
                                avatarFile = "default1.svg";
                            }
                            else
                            {
                                avatarFile = Model.Hinh;
                            }
                        }
                    }
                    <img id="mainAvatarDisplay" src="@Url.Content("~/img/Hinh/khachHang/" + avatarFile)"
                         alt="Avatar" class="rounded-circle img-thumbnail shadow-sm"
                         style="width: 150px; height: 150px; object-fit: cover; border-width: 3px !important; border-color: #81c408 !important; transition: transform 0.2s ease;">

                    <div class="position-absolute top-0 start-0 w-100 h-100 rounded-circle d-flex align-items-center justify-content-center text-white small fw-bold"
                         style="background: rgba(0,0,0,0.4); opacity: 0; transition: opacity 0.2s ease;"
                         onmouseover="this.style.opacity=1" onmouseout="this.style.opacity=0">
                        <i class="fa fa-sync me-1"></i> Click để đổi ảnh
                    </div>
                </div>

                <h4 class="fw-bold text-dark mb-1">@Model.HoTen</h4>
                <p class="text-muted mb-3">@@@Model.MaKh</p>

                @if (Model.VaiTro == 1)
                {
                    <span class="badge bg-danger rounded-pill px-3 py-2 fw-bold shadow-sm mb-3"><i class="fa fa-star me-1"></i> Quản Trị Viên (Admin)</span>
                }
                else
                {
                    <span class="badge bg-success rounded-pill px-3 py-2 fw-bold shadow-sm mb-3"><i class="fa fa-user me-1"></i> Khách Hàng</span>
                }

                <div class="d-grid mt-3 gap-2">
                    <a asp-action="ChangePassword" class="btn btn-warning rounded-pill fw-bold text-dark shadow-sm"><i class="fa fa-key me-2"></i>Đổi mật khẩu</a>
                    <a asp-action="Logout" class="btn btn-outline-danger rounded-pill fw-bold"><i class="fa fa-sign-out-alt me-2"></i>Đăng xuất ngay</a>
                </div>
            </div>
        </div>

        <div class="col-md-8">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-header bg-white pb-0 border-0 mt-3 ms-3">
                    <h5 class="fw-bold text-dark mb-0">Cập nhật thông tin</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Profile" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <input type="hidden" asp-for="MaKh" />
                        <input type="hidden" asp-for="MatKhau" />
                        <input type="hidden" asp-for="Hinh" id="currentHinhInput" /> <input type="hidden" asp-for="VaiTro" />
                        <input type="hidden" asp-for="HieuLuc" />
                        <input type="hidden" asp-for="RandomKey" />

                        <input type="hidden" name="DefaultAvatar" id="selectedDefaultAvatar" />

                        <div class="row g-3">
                            <div class="col-md-12">
                                <label asp-for="HoTen" class="form-label fw-bold text-muted">Họ và tên</label>
                                <input asp-for="HoTen" class="form-control rounded-pill" required />
                                <span asp-validation-for="HoTen" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold text-muted d-block">Giới tính</label>
                                <div class="d-flex gap-3 px-2 mt-2">
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" asp-for="GioiTinh" value="true" id="nam">
                                        <label class="form-check-label" for="nam">Nam</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" asp-for="GioiTinh" value="false" id="nu">
                                        <label class="form-check-label" for="nu">Nữ</label>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="NgaySinh" class="form-label fw-bold text-muted">Ngày sinh</label>
                                <input asp-for="NgaySinh" type="date" class="form-control rounded-pill" asp-format="{0:yyyy-MM-dd}" />
                            </div>

                            <div class="col-md-6">
                                <label asp-for="DienThoai" class="form-label fw-bold text-muted">Số điện thoại</label>
                                <input asp-for="DienThoai" class="form-control rounded-pill" />
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label fw-bold text-muted">Địa chỉ Email</label>
                                <input asp-for="Email" type="email" class="form-control rounded-pill" required />
                            </div>

                            <div class="col-12">
                                <label asp-for="DiaChi" class="form-label fw-bold text-muted">Địa chỉ liên hệ</label>
                                <input asp-for="DiaChi" class="form-control rounded-pill" />
                            </div>

                            <div class="col-12">
                                <label class="form-label fw-bold text-muted">Hoặc tải ảnh mới từ thiết bị của bạn</label>
                                <input type="file" name="fHinh" id="fileAvatar" class="form-control rounded-pill" accept="image/*" />
                            </div>
                        </div>

                        <hr class="my-4" />
                        <div class="d-flex justify-content-end gap-3">
                            <button type="submit" class="btn btn-success rounded-pill px-5 fw-bold shadow-sm" style="background-color: #81c408; border-color: #81c408;">
                                <i class="fa fa-save me-2"></i>Lưu Thay Đổi
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const btnAvatar = document.getElementById("btnClickAvatar");
            const imgDisplay = document.getElementById("mainAvatarDisplay");
            const hiddenDefaultAvatar = document.getElementById("selectedDefaultAvatar");
            const currentHinhInput = document.getElementById("currentHinhInput");
            const fileInput = document.getElementById("fileAvatar");

            // Danh sách 5 đường dẫn tương ứng với 5 ảnh của hệ thống
            const totalAvatars = 5;
            const baseUrl = "@Url.Content("~/img/Hinh/khachHang/")";

            // Lấy số thứ tự ảnh hiện tại đang dùng (ví dụ: default3.svg -> số 3)
            let currentFileName = currentHinhInput.value || "default1.svg";
            let currentIndex = 1;

            // Nếu ảnh cũ có dạng defaultX.svg thì bóc tách lấy X, ngược lại mặc định là 1
            if (currentFileName.startsWith("default") && currentFileName.endsWith(".svg")) {
                currentIndex = parseInt(currentFileName.replace("default", "").replace(".svg", "")) || 1;
            }

            // Sự kiện click trực tiếp vào Avatar lớn
            btnAvatar.addEventListener("click", function () {
                // Tạo hiệu ứng nảy nhẹ khi bấm (nhìn chuyên nghiệp hơn)
                imgDisplay.style.transform = "scale(0.9)";
                setTimeout(() => { imgDisplay.style.transform = "scale(1)"; }, 150);

                // Tăng thứ tự ảnh lên 1, nếu vượt quá 5 thì quay lại 1
                currentIndex = (currentIndex % totalAvatars) + 1;

                // Cập nhật tên file mới
                const newAvatarName = `default${currentIndex}.svg`;

                // 1. Đổi ngay hình ảnh hiển thị trên giao diện trực quan cho người dùng thấy
                imgDisplay.src = baseUrl + newAvatarName;

                // 2. Gán giá trị vào input để Controller lưu lại
                hiddenDefaultAvatar.value = newAvatarName;

                // 3. Xóa file upload từ máy tính (nếu có) để không bị đè dữ liệu
                fileInput.value = "";
            });

            // Nếu người dùng chọn file từ máy, hủy bỏ gán ảnh xoay tua
            fileInput.addEventListener('change', function() {
                if (this.files.length > 0) {
                    hiddenDefaultAvatar.value = "";
                    // Hiển thị ảnh tạm thời xem trước (Preview) từ máy tính nếu muốn
                    const reader = new FileReader();
                    reader.onload = function(e) {
                        imgDisplay.src = e.target.result;
                    }
                    reader.readAsDataURL(this.files[0]);
                }
            });
        });
    </script>
}