@model LTWEB_QuaMonHai_CuoiKy.Models.KhachHang
@{
    string avatarUrl = "";
    // 1. Nếu có tag nhận diện API từ Đăng ký
    if (Model.Hinh != null && Model.Hinh.StartsWith("[API]:"))
    {
        string userName = Model.Hinh.Replace("[API]:", "");
        avatarUrl = Url.Content($"~/api/Avatar/generate?name={Uri.EscapeDataString(userName)}");
    }
    // 2. Nếu có ảnh thật do họ tự upload lên (loại trừ các chuỗi default cũ)
    else if (!string.IsNullOrEmpty(Model.Hinh) && Model.Hinh != "default-avatar.jpg" && Model.Hinh != "avatar.jpg")
    {
        avatarUrl = Url.Content("~/img/Hinh/KhachHang/" + Model.Hinh);
    }
    // 3. ÉP BUỘC: Nếu là ảnh mặc định hoặc trống, gọi API lấy họ tên sinh ảnh chữ luôn
    else
    {
        avatarUrl = Url.Content($"~/api/Avatar/generate?name={Uri.EscapeDataString(Model.HoTen ?? "User")}");
    }
}

<div class="container py-5 mt-5" style="max-width: 1200px;">
    <!-- Hiện thông báo thành công nếu có -->
    @if (TempData["Success"] != null) {
        <div class="alert alert-success alert-dismissible fade show shadow-sm rounded-3 mb-4" role="alert">
            <i class="fa fa-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4">
        <!-- Sidebar cột trái (3/12) -->
        <div class="col-lg-3 col-md-4">
            <partial name="_CustomerSidebar" />
        </div>

        <!-- Nội dung chính cột phải (9/12) -->
        <div class="col-lg-9 col-md-8">
            <div class="card shadow-sm border-0 rounded-3 bg-white p-4">
                <div class="border-bottom pb-3 mb-4">
                    <h4 class="fw-bold text-dark m-0"><i class="fa fa-id-card me-2 text-success" style="color: var(--primary) !important;"></i>Hồ Sơ Cá Nhân</h4>
                    <p class="text-muted m-0 small">Quản lý thông tin hồ sơ để bảo mật tài khoản</p>
                </div>

                <form asp-action="Profile" method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <!-- Giấu các trường không cho sửa vào thẻ hidden -->
                    <input type="hidden" asp-for="MaKh" />
                    <input type="hidden" asp-for="MatKhau" />
                    <input type="hidden" asp-for="Hinh" />
                    <input type="hidden" asp-for="VaiTro" />
                    <input type="hidden" asp-for="HieuLuc" />
                    <input type="hidden" asp-for="RandomKey" />

                    <div class="row g-3">
                        <!-- Họ và Tên -->
                        <div class="col-md-12">
                            <label asp-for="HoTen" class="form-label fw-bold text-secondary">Họ và tên</label>
                            <input asp-for="HoTen" class="form-control rounded-pill px-4 shadow-none border-success-focus" required />
                            <span asp-validation-for="HoTen" class="text-danger small"></span>
                        </div>

                        <!-- Giới tính -->
                        <div class="col-md-6">
                            <label class="form-label fw-bold text-secondary d-block">Giới tính</label>
                            <div class="d-flex gap-3 px-2 mt-2">
                                <div class="form-check">
                                    <input class="form-check-input text-success" type="radio" asp-for="GioiTinh" value="true" id="nam">
                                    <label class="form-check-label text-dark" for="nam">Nam</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input text-success" type="radio" asp-for="GioiTinh" value="false" id="nu">
                                    <label class="form-check-label text-dark" for="nu">Nữ</label>
                                </div>
                            </div>
                        </div>

                        <!-- Ngày sinh -->
                        <div class="col-md-6">
                            <label asp-for="NgaySinh" class="form-label fw-bold text-secondary">Ngày sinh</label>
                            <input asp-for="NgaySinh" type="date" class="form-control rounded-pill px-4 shadow-none border-success-focus" asp-format="{0:yyyy-MM-dd}" />
                        </div>

                        <!-- Số điện thoại -->
                        <div class="col-md-6">
                            <label asp-for="DienThoai" class="form-label fw-bold text-secondary">Số điện thoại</label>
                            <input asp-for="DienThoai" class="form-control rounded-pill px-4 shadow-none border-success-focus" />
                        </div>

                        <!-- Email -->
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label fw-bold text-secondary">Địa chỉ Email</label>
                            <input asp-for="Email" type="email" class="form-control rounded-pill px-4 shadow-none border-success-focus" required />
                        </div>

                        <!-- Địa chỉ -->
                        <div class="col-12">
                            <label asp-for="DiaChi" class="form-label fw-bold text-secondary">Địa chỉ liên hệ</label>
                            <input asp-for="DiaChi" class="form-control rounded-pill px-4 shadow-none border-success-focus" />
                        </div>

                        <!-- Đổi Avatar -->
                        <div class="col-12">
                            <label class="form-label fw-bold text-secondary mb-2">Ảnh đại diện hiện tại</label>
                            <div class="mb-3 d-flex align-items-center gap-3">
                                <img src="@avatarUrl" class="rounded-circle border border-2 border-success shadow-sm" style="width: 70px; height: 70px; object-fit: cover;" />
                                <span class="text-muted small">Tài khoản đang sử dụng hình ảnh này làm đại diện.</span>
                            </div>

                            <label class="form-label fw-bold text-secondary">Chọn ảnh đại diện mới</label>
                            <input type="file" name="fHinh" class="form-control rounded-pill px-4 shadow-none border-success-focus" accept="image/*" />
                        </div>
                    </div>

                    <hr class="my-4 text-light-muted opacity-50" />
                    <div class="d-flex justify-content-end">
                        <button type="submit" class="btn btn-success rounded-pill px-5 py-2.5 fw-bold shadow-sm" style="background-color: var(--primary) !important; border-color: var(--primary) !important;">
                            <i class="fa fa-save me-2"></i>Lưu Thay Đổi
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

<style>
    .form-control:focus {
        border-color: var(--primary) !important;
        box-shadow: 0 0 0 0.25rem rgba(60, 184, 21, 0.25) !important;
    }
    .form-check-input:checked {
        background-color: var(--primary) !important;
        border-color: var(--primary) !important;
    }
</style>