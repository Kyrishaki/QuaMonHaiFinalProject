@model LTWEB_QuaMonHai_CuoiKy.ViewModels.ChangePasswordVM
@{
    ViewData["Title"] = "Đổi Mật Khẩu";
}

<div class="container py-5" style="max-width: 600px;">
    <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
        <div class="card-header bg-white text-center py-4 border-bottom">
            <h3 class="text-primary fw-bold mb-0"><i class="fa fa-lock me-2"></i>Đổi Mật Khẩu</h3>
            <p class="text-muted mb-0 mt-2">Chọn phương thức phù hợp để xác thực tài khoản</p>
        </div>

        <div class="card-body p-4 p-md-5">
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show rounded-3" role="alert">
                    <i class="fa fa-exclamation-circle me-2"></i>@TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show rounded-3" role="alert">
                    <i class="fa fa-check-circle me-2"></i>@TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <form asp-action="ChangePassword" method="post" id="formChangePassword">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-4 border rounded-3 p-3 bg-light">
                    <label class="form-label fw-bold text-secondary d-block mb-2">Bạn muốn xác thực bằng:</label>
                    <div class="form-check form-check-inline me-4">
                        <input class="form-check-input" type="radio" asp-for="ChangeMethod" value="OldPassword" id="methodPassword" checked>
                        <label class="form-check-label fw-semibold" for="methodPassword">Mật khẩu hiện tại</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" asp-for="ChangeMethod" value="EmailOTP" id="methodOTP">
                        <label class="form-check-label fw-semibold" for="methodOTP">Nhận mã qua Gmail</label>
                    </div>
                </div>

                <div class="mb-4" id="groupOldPassword">
                    <label asp-for="OldPassword" class="form-label fw-bold text-muted">Mật khẩu hiện tại <span class="text-danger">*</span></label>
                    <input asp-for="OldPassword" type="password" class="form-control rounded-pill px-4" placeholder="Nhập mật khẩu hiện tại" />
                    <span asp-validation-for="OldPassword" class="text-danger small ms-2"></span>
                </div>

                <div class="mb-4 d-none" id="groupEmailOTP">
                    <label asp-for="VerificationCode" class="form-label fw-bold text-muted">Mã xác thực OTP <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <input asp-for="VerificationCode" type="text" class="form-control rounded-start-pill px-4" placeholder="Nhập 6 số OTP" />
                        <button type="button" class="btn btn-warning rounded-end-pill fw-bold text-white px-3" id="btnSendOTP">
                            <i class="fa fa-paper-plane me-1"></i> Gửi mã
                        </button>
                    </div>
                    <span asp-validation-for="VerificationCode" class="text-danger small ms-2"></span>
                    <div id="otpStatusMessage" class="small mt-1 ms-2"></div>
                </div>

                <hr class="text-muted my-4">

                <div class="mb-4">
                    <label asp-for="NewPassword" class="form-label fw-bold text-muted">Mật khẩu mới <span class="text-danger">*</span></label>
                    <input asp-for="NewPassword" type="password" class="form-control rounded-pill px-4" placeholder="Nhập mật khẩu mới ít nhất 6 ký tự" />
                    <span asp-validation-for="NewPassword" class="text-danger small ms-2"></span>
                </div>

                <div class="mb-5">
                    <label asp-for="ConfirmPassword" class="form-label fw-bold text-muted">Xác nhận mật khẩu mới <span class="text-danger">*</span></label>
                    <input asp-for="ConfirmPassword" type="password" class="form-control rounded-pill px-4" placeholder="Nhập lại mật khẩu mới" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small ms-2"></span>
                </div>

                <div class="d-grid gap-3">
                    <button type="submit" class="btn text-white rounded-pill py-3 fw-bold shadow-sm" style="background-color: #81c408;">
                        <i class="fa fa-save me-2"></i>XÁC NHẬN ĐỔI MẬT KHẨU
                    </button>
                    <a asp-action="Profile" class="btn btn-light rounded-pill py-3 fw-bold text-muted border shadow-sm">
                        <i class="fa fa-arrow-left me-2"></i>Quay lại Hồ sơ
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        $(document).ready(function () {
            // Lắng nghe sự kiện chuyển đổi giữa 2 Radio button công khai
            $('input[name="ChangeMethod"]').change(function () {
                let selectedMethod = $(this).val();

                if (selectedMethod === "OldPassword") {
                    $('#groupOldPassword').removeClass('d-none');
                    $('#groupEmailOTP').addClass('d-none');
                    // Reset field của OTP
                    $('#VerificationCode').val('');
                } else if (selectedMethod === "EmailOTP") {
                    $('#groupEmailOTP').removeClass('d-none');
                    $('#groupOldPassword').addClass('d-none');
                    // Reset field của Password cũ
                    $('#OldPassword').val('');
                }
            });

            // Xử lý gửi OTP qua Email bằng Ajax
            $('#btnSendOTP').click(function () {
                let btn = $(this);
                btn.prop('disabled', true).html('<i class="fa fa-spinner fa-spin"></i> Đang gửi...');
                $('#otpStatusMessage').removeClass('text-danger text-success').text('');

                $.ajax({
                    url: '@Url.Action("SendChangePasswordOtp", "Customer")',
                    type: 'POST',
                    success: function (response) {
                        if (response.success) {
                            $('#otpStatusMessage').addClass('text-success').text(response.message);

                            // Đếm ngược 60 giây anti-spam nút gửi
                            let count = 60;
                            let countdown = setInterval(function () {
                                count--;
                                btn.text('Thử lại (' + count + 's)');
                                if (count <= 0) {
                                    clearInterval(countdown);
                                    btn.prop('disabled', false).html('<i class="fa fa-paper-plane me-1"></i> Gửi lại');
                                }
                            }, 1000);
                        } else {
                            $('#otpStatusMessage').addClass('text-danger').text(response.message);
                            btn.prop('disabled', false).html('<i class="fa fa-paper-plane me-1"></i> Gửi mã');
                        }
                    },
                    error: function () {
                        $('#otpStatusMessage').addClass('text-danger').text('Lỗi kết nối hệ thống server.');
                        btn.prop('disabled', false).html('<i class="fa fa-paper-plane me-1"></i> Gửi mã');
                    }
                });
            });
        });
    </script>
}