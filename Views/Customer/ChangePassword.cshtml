@model LTWEB_QuaMonHai_CuoiKy.ViewModels.ChangePasswordVM
@{
    ViewData["Title"] = "Đổi Mật Khẩu";
}

<div class="container py-5 mt-5" style="max-width: 1200px;">
    @if (TempData["Error"] != null) {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
            <i class="fa fa-exclamation-circle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Success"] != null) {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
            <i class="fa fa-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4">
        <!-- Sidebar cột trái (3/12) -->
        <div class="col-lg-3 col-md-4">
            <partial name="_CustomerSidebar" />
        </div>

        <!-- Nội dung chính cột phải (9/12) -->
        <div class="col-lg-9 col-md-8">
            <div class="card shadow-sm border-0 rounded-3 bg-white p-4">
                <div class="border-bottom pb-3 mb-4">
                    <h4 class="fw-bold text-dark m-0"><i class="fa fa-key me-2 text-warning"></i>Đổi Mật Khẩu</h4>
                    <p class="text-muted m-0 small">Cập nhật mật khẩu thường xuyên để bảo mật tài khoản tốt hơn</p>
                </div>

                <form asp-action="ChangePassword" method="post" data-inspect-id="change-password-form">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-4">
                        <label asp-for="OldPassword" class="form-label fw-bold text-secondary">Mật khẩu hiện tại <span class="text-danger">*</span></label>
                        <input asp-for="OldPassword" type="password" class="form-control rounded-pill px-4 shadow-none" required placeholder="Nhập mật khẩu cũ" />
                        <span asp-validation-for="OldPassword" class="text-danger small ms-2"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="NewPassword" class="form-label fw-bold text-secondary">Mật khẩu mới <span class="text-danger">*</span></label>
                        <input asp-for="NewPassword" type="password" class="form-control rounded-pill px-4 shadow-none" required placeholder="Nhập mật khẩu mới" />
                        <span asp-validation-for="NewPassword" class="text-danger small ms-2"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label fw-bold text-secondary">Xác nhận mật khẩu mới <span class="text-danger">*</span></label>
                        <input asp-for="ConfirmPassword" type="password" class="form-control rounded-pill px-4 shadow-none" required placeholder="Nhập lại mật khẩu mới" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small ms-2"></span>
                    </div>

                    <hr class="my-4 text-light-muted opacity-50" />
                    <div class="d-flex justify-content-end gap-3">
                        <a asp-action="Profile" class="btn btn-outline-secondary rounded-pill px-4 py-2.5 fw-bold">
                            Hủy bỏ
                        </a>
                        <button type="submit" class="btn text-white rounded-pill px-5 py-2.5 fw-bold shadow-sm" style="background-color: var(--primary); border-color: var(--primary);">
                            <i class="fa fa-save me-2"></i>Đổi Mật Khẩu
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

<style>
    .form-control:focus {
        border-color: var(--primary) !important;
        box-shadow: 0 0 0 0.25rem rgba(60, 184, 21, 0.25) !important;
    }
</style>