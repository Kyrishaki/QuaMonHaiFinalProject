@model LTWEB_QuaMonHai_CuoiKy.ViewModels.RegisterVM
@{
    ViewData["Title"] = "Đăng Ký";
    var showOtpSection = !ViewData.ModelState.IsValid || (Model != null && !string.IsNullOrEmpty(Model.Email)) ? "display: block;" : "display: none;";
}
<div class="container-fluid py-5 auth-page-container" style="background-color: #f4f6f8;">
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
                    <div class="card-header bg-primary text-white text-center py-4" style="background-color: #81c408 !important;">
                        <h2 class="mb-0 fw-bold text-white"><i class="fa fa-user-plus me-2"></i>Đăng ký Thành viên</h2>
                        <p class="mb-0 text-white-50">Gia nhập cộng đồng ngay hôm nay</p>
                    </div>
                    <div class="card-body p-4 p-md-5">

                        @if (!ViewData.ModelState.IsValid) {
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                        }

                        <form asp-action="Register" enctype="multipart/form-data">
                            <div class="row g-4">
                                <div class="col-md-6">
                                    <label asp-for="@Model.MaKh" class="form-label fw-bold text-muted">Tên đăng nhập <sup class="text-danger">*</sup></label>
                                    <input asp-for="@Model.MaKh" type="text" class="form-control rounded-pill px-3">
                                    <span asp-validation-for="@Model.MaKh" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="@Model.MatKhau" class="form-label fw-bold text-muted">Mật khẩu <sup class="text-danger">*</sup></label>
                                    <input asp-for="@Model.MatKhau" type="password" class="form-control rounded-pill px-3">
                                    <span asp-validation-for="@Model.MatKhau" class="text-danger small"></span>
                                </div>

                                <div class="col-md-6">
                                    <label asp-for="@Model.HoTen" class="form-label fw-bold text-muted">Họ và tên <sup class="text-danger">*</sup></label>
                                    <input asp-for="@Model.HoTen" class="form-control rounded-pill px-3" />
                                    <span asp-validation-for="@Model.HoTen" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="@Model.NgaySinh" class="form-label fw-bold text-muted">Ngày sinh</label>
                                    <input asp-for="@Model.NgaySinh" type="date" class="form-control rounded-pill px-3" />
                                    <span asp-validation-for="@Model.NgaySinh" class="text-danger small"></span>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-bold text-muted d-block">Giới tính</label>
                                    <div class="d-flex gap-4 mt-2 px-2">
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" asp-for="GioiTinh" value="true" id="gioiTinhNam">
                                            <label class="form-check-label" for="gioiTinhNam">Nam</label>
                                        </div>
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" asp-for="GioiTinh" value="false" id="gioiTinhNu">
                                            <label class="form-check-label" for="gioiTinhNu">Nữ</label>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="@Model.DienThoai" class="form-label fw-bold text-muted">Điện thoại <sup class="text-danger">*</sup></label>
                                    <input asp-for="@Model.DienThoai" class="form-control rounded-pill px-3" />
                                    <span asp-validation-for="@Model.DienThoai" class="text-danger small"></span>
                                </div>

                                <div class="col-12">
                                    <label asp-for="@Model.DiaChi" class="form-label fw-bold text-muted">Địa chỉ <sup class="text-danger">*</sup></label>
                                    <input asp-for="@Model.DiaChi" class="form-control rounded-pill px-3" />
                                    <span asp-validation-for="@Model.DiaChi" class="text-danger small"></span>
                                </div>

                                <div class="col-md-6">
                                    <label asp-for="Email" class="form-label fw-bold text-muted">Email <sup class="text-danger">*</sup></label>
                                    <div class="input-group">
                                        <input asp-for="Email" type="email" class="form-control" style="border-radius: 50rem 0 0 50rem;" id="emailInput">
                                        <button type="button" class="btn btn-secondary" style="border-radius: 0 50rem 50rem 0;" id="btnSendCode">Gửi mã</button>
                                    </div>
                                    <span asp-validation-for="Email" class="text-danger small"></span>
                                </div>

                                <div class="col-md-6" id="verificationSection" style="@showOtpSection">
                                    <label class="form-label fw-bold text-muted">Mã xác thực <sup class="text-danger">*</sup></label>
                                    <input asp-for="VerificationCode" class="form-control rounded-pill px-3" placeholder="Nhập mã 6 số gửi về email">
                                    <span asp-validation-for="VerificationCode" class="text-danger small fw-bold"></span>
                                </div>

                                <div class="col-12">
                                    <label class="form-label fw-bold text-muted" for="Hinh">Hình đại diện</label>
                                    <input type="file" name="Hinh" id="Hinh" class="form-control rounded-pill px-3" accept="image/*" />
                                </div>

                                <div class="col-12 text-center mt-5">
                                    <button type="submit" class="btn text-white rounded-pill py-3 px-5 fw-bold shadow-sm mb-3" style="background-color: #81c408; font-size: 1.1rem; width: 100%; max-width: 400px;">
                                        ĐĂNG KÝ TÀI KHOẢN
                                    </button>

                                    <div class="text-center my-3 position-relative mx-auto" style="max-width: 400px;">
                                        <hr class="text-muted" />
                                        <span class="position-absolute top-50 start-50 translate-middle bg-white px-3 text-muted small text-uppercase">Hoặc</span>
                                    </div>

                                    <div class="d-grid mx-auto mb-4" style="max-width: 400px;">
                                        <a asp-controller="Customer" asp-action="GoogleLogin" class="btn btn-outline-secondary rounded-pill py-3 fw-semibold shadow-sm d-flex align-items-center justify-content-center gap-2 border-opacity-50" style="font-size: 1rem; border-color: #dadce0; color: #3c4043; transition: background-color 0.2s, border-color 0.2s;">
                                            <img src="https://developers.google.com/static/identity/images/g-logo.png" alt="Google" style="width: 20px; height: 20px;" />
                                            Đăng ký bằng Google
                                        </a>
                                    </div>

                                    <p class="mt-3">Đã có tài khoản? <a asp-controller="Customer" asp-action="Login" class="text-primary fw-bold">Đăng nhập tại đây</a></p>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        $("#btnSendCode").click(function () {
            var email = $("#emailInput").val();

            // Đã sửa: Gấp đôi ký hiệu @@ để Razor không biên dịch nhầm
            var emailPattern = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;

            if(!email) {
                alert("Hãy nhập email!");
                return;
            }
            if(!emailPattern.test(email)) {
                alert("Vui lòng nhập đúng định dạng email!");
                return;
            }

            var btn = $(this);
            btn.prop('disabled', true).text("Đang gửi...");

            $.post('/Customer/SendVerificationCode', { email: email }, function (res) {
                if (res.success) {
                    $("#verificationSection").slideDown();
                    alert("Đã gửi mã thành công! Vui lòng kiểm tra hộp thư (cả mục Spam).");
                } else {
                    alert(res.message);
                }
                btn.prop('disabled', false).text("Gửi lại mã");
            }).fail(function() {
                alert("Lỗi kết nối đến server. Vui lòng thử lại sau.");
                btn.prop('disabled', false).text("Gửi lại mã");
            });
        });
    </script>
}