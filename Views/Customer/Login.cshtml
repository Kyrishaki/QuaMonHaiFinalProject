@model LTWEB_QuaMonHai_CuoiKy.ViewModels.LoginVM
@{
    ViewData["Title"] = "Đăng Nhập";
}


<script src="https://www.google.com/recaptcha/api.js" async defer></script>

<div class="container-fluid py-5 auth-page-container" style="background-color: #f4f6f8;">
    <div class="container py-5">
        <div class="row g-0 shadow-lg rounded-4 overflow-hidden bg-white" style="min-height: 600px;">
            <div class="col-lg-6 d-none d-lg-flex flex-column justify-content-center align-items-center text-white position-relative" style="background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);">
                <div class="position-relative z-1 text-center p-5">
                    <h1 class="display-3 text-white fw-bold mb-4">QuaMonHai</h1>
                    <h4 class="text-white mb-4">Hệ thống mua sắm công nghệ & phụ kiện cao cấp!</h4>
                    <p class="fs-5 mb-4">Chào mừng bạn quay trở lại. Đăng nhập ngay để khám phá hàng ngàn sản phẩm Laptop, Điện thoại, Đồng hồ thời trang và Phụ kiện chính hãng với mức giá ưu đãi nhất.</p>
                    <ul class="list-unstyled text-start d-inline-block fs-6">
                        <li class="mb-2"><i class="fa fa-check-circle text-white me-2"></i> Laptop & Điện thoại chính hãng — Bảo hành vượt trội</li>
                        <li class="mb-2"><i class="fa fa-check-circle text-white me-2"></i> Bộ sưu tập Đồng hồ & Trang sức cao cấp, sang trọng</li>
                        <li class="mb-2"><i class="fa fa-check-circle text-white me-2"></i> Cam kết chất lượng 100% — Hỗ trợ đổi trả dễ dàng</li>
                        <li class="mb-2"><i class="fa fa-check-circle text-white me-2"></i> Giao hàng nhanh chóng — Tích điểm thành viên nhận đặc quyền</li>
                    </ul>
                </div>
            </div>

            <div class="col-lg-6 p-5 d-flex flex-column justify-content-center">
                <div class="text-center mb-5">
                    <h2 class="text-primary fw-bold">Đăng Nhập</h2>
                    <p class="text-muted">Vui lòng đăng nhập để tiếp tục</p>
                </div>

                <form asp-action="Login" asp-route-returnurl="@ViewBag.ReturnUrl" data-inspect-id="login-form">
                    <div class="text-danger mb-3" asp-validation-summary="All"></div>

                    <div class="form-floating mb-4" data-inspect-id="login-username">
                        <input asp-for="@Model.UserName" type="text" class="form-control rounded-pill px-4" id="floatingInput" placeholder="Tên đăng nhập">
                        <label for="floatingInput" class="ms-3 text-muted">Tên đăng nhập *</label>
                        <span asp-validation-for="@Model.UserName" class="text-danger small ms-3"></span>
                    </div>

                    <div class="form-floating mb-4" data-inspect-id="login-password">
                        <input asp-for="@Model.Password" type="password" class="form-control rounded-pill px-4" id="floatingPassword" placeholder="Mật khẩu">
                        <label for="floatingPassword" class="ms-3 text-muted">Mật khẩu *</label>
                        <span asp-validation-for="@Model.Password" class="text-danger small ms-3"></span>
                    </div>

                    <!-- TEMPORARILY DISABLED FOR AUTOMATED FLOW TESTING -->
              
                    <div class="d-flex justify-content-center mb-4" data-inspect-id="login-recaptcha">
                        <div class="g-recaptcha" data-sitekey="6Le0Z-MsAAAAAB7YQK_ITslpZxYtzmtTi5h8O6Nr"></div>
                    </div>
           

                    <div class="d-grid gap-3 mb-4" data-inspect-id="login-submit-btn">
                        <button type="submit" class="btn text-white rounded-pill py-3 fw-bold shadow-sm" style="background-color: #81c408; font-size: 1.1rem;">
                            ĐĂNG NHẬP
                        </button>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-2" data-inspect-id="login-redirect-links">
                        <a asp-controller="Customer" asp-action="ForgotPassword" class="text-danger text-decoration-none small"><i class="fa fa-lock me-1"></i> Quên mật khẩu?</a>
                        <a asp-controller="Customer" asp-action="Register" class="text-primary text-decoration-none fw-bold small">Tạo tài khoản <i class="fa fa-arrow-right ms-1"></i></a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

