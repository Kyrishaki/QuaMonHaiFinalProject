            "checkout-voucher": {
                title: "Áp Dụng Voucher Giảm Giá (Checkout Voucher Application)",
                desc: "Tích hợp chọn mã giảm giá. Khi áp dụng voucher, JavaScript sẽ tính toán số tiền được giảm dựa trên phần trăm của đơn hàng, trừ trực tiếp vào tổng tiền thanh toán cuối cùng và gửi ID voucher về Controller.",
                code: `// Chọn áp dụng mã voucher\nfunction applyVoucher(maGg, tenMa, phanTram) {\n    document.getElementById('selectedMaGg').value = maGg;\n    document.getElementById('selectedVoucherLabel').textContent = '✔ Áp dụng mã: ' + tenMa;\n    currentDiscountPercent = parseFloat(phanTram);\n    calculateTotal(); // Tính lại hóa đơn\n}`
