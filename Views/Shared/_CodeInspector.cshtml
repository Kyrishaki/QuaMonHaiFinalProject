        // Load Bookmarks from LocalStorage
        function getBookmarks() {
            const val = localStorage.getItem("code_bookmarks");
            return val ? JSON.parse(val) : [];
        }

        function saveBookmarks(arr) {
            localStorage.setItem("code_bookmarks", JSON.stringify(arr));
            updateBookmarkTabUI();
        }

        // Bookmark check / toggle
        function isBookmarked(id) {
            return getBookmarks().includes(id);
        }

        function toggleBookmark(id) {
            let bookmarks = getBookmarks();
            if (bookmarks.includes(id)) {
                bookmarks = bookmarks.filter(item => item !== id);
                showToast("Đã xóa khỏi Thư mục nhớ!", "danger");
            } else {
                bookmarks.push(id);
                const data = inspectorDb[id];
                const name = data ? data.title : id;
                showToast("Đã lưu " + name + " vào Thư mục nhớ!", "success");
            }
            saveBookmarks(bookmarks);
            updateBookmarkButtonUI(id);
        }

        function updateBookmarkButtonUI(id) {
            if (!id) {
                bookmarkActionBtn.classList.add("d-none");
                return;
            }
            bookmarkActionBtn.classList.remove("d-none");
            if (isBookmarked(id)) {
                bookmarkActionBtn.innerHTML = `<i class="fa-solid fa-star text-warning"></i> <span class="text-warning">Đã lưu (Click xóa)</span>`;
                bookmarkActionBtn.style.background = "rgba(255,193,7,0.15)";
            } else {
                bookmarkActionBtn.innerHTML = `<i class="fa-regular fa-star"></i> <span>Lưu thư mục nhớ</span>`;
                bookmarkActionBtn.style.background = "rgba(255,152,0,0.08)";
            }
        }

        function showToast(message, type = "success") {
            toast.innerText = message;
            toast.style.background = type === "success" ? "rgba(40, 167, 69, 0.95)" : "rgba(220, 53, 69, 0.95)";
            toast.style.opacity = "1";
            toast.style.transform = "translateX(-50%) translateY(0)";
            setTimeout(() => {
                toast.style.opacity = "0";
                toast.style.transform = "translateX(-50%) translateY(20px)";
            }, 2200);
        }

        // Scans all elements with data-inspect-id on the current page
        function scanPageElements() {
            tabContentComponents.innerHTML = "";
            const elements = document.querySelectorAll("[data-inspect-id]");
            const ids = new Set();
            
            elements.forEach(el => {
                const id = el.getAttribute("data-inspect-id");
                if (id) ids.add(id);
            });

            if (ids.size === 0) {
                tabContentComponents.innerHTML = `<div class="text-muted text-center p-3 small font-italic">Không tìm thấy cấu phần nào trên trang này.</div>`;
                return;
            }

            ids.forEach(id => {
                const data = inspectorDb[id];
                const name = data ? data.title : id;
                
                const item = document.createElement("button");
                item.className = "btn btn-sm btn-dark text-start text-white-50 border-0 py-1.5 px-3 rounded w-100 d-flex align-items-center justify-content-between transition-all";
                item.style.background = "rgba(255,255,255,0.03)";
                item.style.fontSize = "0.78rem";
                item.style.fontFamily = "'Open Sans', sans-serif";
                
                item.innerHTML = `
                    <span class="text-truncate" style="max-width: 250px;"><i class="fa-solid fa-cube text-warning me-1.5" style="font-size:0.7rem;"></i>${name}</span>
                    <i class="fa-solid fa-chevron-right text-muted" style="font-size:0.6rem;"></i>
                `;

                // Hovering menu element flashes outline on page
                item.addEventListener("mouseenter", () => {
                    const targetEl = document.querySelector(`[data-inspect-id="${id}"]`);
                    if (targetEl) {
                        targetEl.style.outline = "3px dashed #ff9800";
                        targetEl.style.outlineOffset = "3px";
                    }
                });
                item.addEventListener("mouseleave", () => {
                    const targetEl = document.querySelector(`[data-inspect-id="${id}"]`);
                    if (targetEl) {
                        targetEl.style.outline = "";
                        targetEl.style.outlineOffset = "";
                    }
                });

                // Click scrolls to component and inspects it
                item.addEventListener("click", () => {
                    inspectComponent(id);
                    const targetEl = document.querySelector(`[data-inspect-id="${id}"]`);
                    if (targetEl) {
                        // Flash outline
                        let flashCount = 0;
                        const interval = setInterval(() => {
                            targetEl.style.outline = flashCount % 2 === 0 ? "4px dashed #81c408" : "3px dashed #ff9800";
                            flashCount++;
                            if (flashCount > 5) {
                                clearInterval(interval);
                                targetEl.style.outline = "";
                            }
                        }, 180);
                    }
                });

                tabContentComponents.appendChild(item);
            });
        }

        // Renders Bookmarks list from localStorage
        function updateBookmarkTabUI() {
            tabContentBookmarks.innerHTML = "";
            const bookmarks = getBookmarks();
            bookmarkCountBadge.innerText = bookmarks.length;

            if (bookmarks.length === 0) {
                tabContentBookmarks.innerHTML = `<div class="text-muted text-center p-3 small font-italic">Thư mục nhớ trống. Click chọn cấu phần rồi nhấn 'Lưu thư mục nhớ'!</div>`;
                return;
            }

            bookmarks.forEach(id => {
                const data = inspectorDb[id];
                const name = data ? data.title : id;

                const wrapper = document.createElement("div");
                wrapper.className = "d-flex align-items-center gap-1 w-100";
                
                const item = document.createElement("button");
                item.className = "btn btn-sm btn-dark text-start text-white-50 border-0 py-1.5 px-3 rounded flex-grow-1 text-truncate transition-all";
                item.style.background = "rgba(255,255,255,0.03)";
                item.style.fontSize = "0.78rem";
                item.style.fontFamily = "'Open Sans', sans-serif";
                item.innerHTML = `<i class="fa-solid fa-star text-warning me-1.5" style="font-size:0.7rem;"></i>${name}`;
                item.addEventListener("click", () => {
                    inspectComponent(id);
                });

                const deleteBtn = document.createElement("button");
                deleteBtn.className = "btn btn-sm btn-outline-danger border-0 d-flex align-items-center justify-content-center p-0 rounded-circle";
                deleteBtn.style.width = "28px";
                deleteBtn.style.height = "28px";
                deleteBtn.innerHTML = `<i class="fa-solid fa-trash-can" style="font-size:0.8rem;"></i>`;
                deleteBtn.addEventListener("click", (e) => {
                    e.stopPropagation();
                    toggleBookmark(id);
                });

                wrapper.appendChild(item);
                wrapper.appendChild(deleteBtn);
                tabContentBookmarks.appendChild(wrapper);
            });
        }

        // Loads component data into right-side detail drawer view
        function inspectComponent(id) {
            const data = inspectorDb[id];
            if (data) {
                lastSelectedId = id;
                
                // Animate card content transition (quick crossfade)
                anime({
                    targets: '#inspector-card-body-content',
                    opacity: [0, 1],
                    translateY: [10, 0],
                    duration: 300,
                    easing: 'easeOutQuad'
                });

                inspectTitle.innerText = data.title;
                inspectDesc.innerHTML = data.desc;
                
                // Check which tabs should be shown
                if (data.controller) {
                    btnSubController.classList.remove("d-none");
                } else {
                    btnSubController.classList.add("d-none");
                }

                if (data.model) {
                    btnSubModel.classList.remove("d-none");
                } else {
                    btnSubModel.classList.add("d-none");
                }

                // CƠ CHẾ HOẠT ĐỘNG (Flow) is always active to explain the workflow
                btnSubWorkflow.classList.remove("d-none");

                // Default to 'view' tab
                activeSubTab = "view";
                updateSubTabUI();
                
                updateBookmarkButtonUI(id);
                adjustMobileLayout();
            }
        }

        // Toggle inspector activation
        toggleBtn.addEventListener("click", function () {
            if (isActive) {
                deactivateInspector();
            } else {
                activateInspector();
            }
        });

        closeDrawerBtn.addEventListener("click", function (e) {
            e.stopPropagation();
            deactivateInspector();
        });

        if (mobileBackBtn) {
            mobileBackBtn.addEventListener("click", function (e) {
                e.stopPropagation();
                lastSelectedId = null;
                adjustMobileLayout();
            });
        }

        function adjustMobileLayout() {
            const isMobile = window.innerWidth < 768;
            const leftCol = drawer.firstElementChild; // The left column
            const rightCol = document.getElementById("inspector-card-body-content");
            
            if (isMobile) {
                if (!isActive || lastSelectedId === null) {
                    leftCol.style.display = "flex";
                    rightCol.style.display = "none";
                    if (mobileBackBtn) mobileBackBtn.style.display = "none";
                } else {
                    leftCol.style.display = "none";
                    rightCol.style.display = "flex";
                    if (mobileBackBtn) mobileBackBtn.style.display = "flex";
                }
            } else {
                leftCol.style.display = "flex";
                rightCol.style.display = "flex";
                if (mobileBackBtn) mobileBackBtn.style.display = "none";
            }
            
            // Adjust toggle button position dynamically based on actual drawer height
            if (isActive) {
                const drawerHeight = drawer.offsetHeight;
                toggleContainer.style.bottom = `${drawerHeight + 25}px`;
            } else {
                toggleContainer.style.bottom = "25px";
            }
        }

        function positionBadges() {
            if (!isActive) return;
            const badges = document.querySelectorAll(".inspector-element-badge");
            badges.forEach(badge => {
                const id = badge.getAttribute("data-target-id");
                const el = document.querySelector(`[data-inspect-id="${id}"]`);
                if (el) {
                    const rect = el.getBoundingClientRect();
                    if (rect.width === 0 || rect.height === 0) {
                        badge.style.display = "none";
                    } else {
                        badge.style.display = "flex";
                        // Position badge at the top-left of the target element with slight offset
                        const top = rect.top + window.scrollY - 10;
                        const left = rect.left + window.scrollX - 10;
                        badge.style.top = `${top}px`;
                        badge.style.left = `${left}px`;
                    }
                } else {
                    badge.style.display = "none";
                }
            });
        }

        function createInspectorBadges() {
            removeInspectorBadges();
            
            const elements = document.querySelectorAll("[data-inspect-id]");
            const createdIds = new Set();
            elements.forEach(el => {
                const id = el.getAttribute("data-inspect-id");
                if (!id || createdIds.has(id)) return;
                createdIds.add(id);
                
                const badge = document.createElement("div");
                badge.className = "inspector-element-badge";
                badge.setAttribute("data-target-id", id);
                badge.title = `Nhấp để xem code của: ${inspectorDb[id] ? inspectorDb[id].title : id}`;
                badge.innerHTML = `<i class="fa-solid fa-code"></i>`;
                
                // Click badge performs inspection
                badge.addEventListener("click", function (e) {
                    e.stopPropagation();
                    e.preventDefault();
                    inspectComponent(id);
                    // Flash outline
                    let flashCount = 0;
                    const interval = setInterval(() => {
                        el.style.outline = flashCount % 2 === 0 ? "4px dashed #81c408" : "3px dashed #ff9800";
                        flashCount++;
                        if (flashCount > 5) {
                            clearInterval(interval);
                            el.style.outline = "";
                        }
                    }, 180);
                });
                
                // Badge hover highlights target element
                badge.addEventListener("mouseenter", function () {
                    el.style.outline = "3px dashed #ff9800";
                    el.style.outlineOffset = "3px";
                    el.style.boxShadow = "0 0 25px rgba(255, 152, 0, 0.4)";
                    el.style.transform = "scale(1.006)";
                });
                
                badge.addEventListener("mouseleave", function () {
                    el.style.outline = "";
                    el.style.outlineOffset = "";
                    el.style.boxShadow = "";
                    el.style.transform = "";
                });
                
                document.body.appendChild(badge);
            });
            
            positionBadges();
            
            window.addEventListener("scroll", positionBadges, { passive: true });
            window.addEventListener("resize", () => {
                positionBadges();
                adjustMobileLayout();
            });
        }

        function removeInspectorBadges() {
            const badges = document.querySelectorAll(".inspector-element-badge");
            badges.forEach(badge => badge.remove());
            
            window.removeEventListener("scroll", positionBadges);
            window.removeEventListener("resize", positionBadges);
        }

        function activateInspector() {
            isActive = true;
            document.body.classList.add("inspector-active");
            
            // Toggle button animation (Turns red/rotate and slides up above bottom drawer)
            toggleBtn.style.transform = "rotate(135deg)";
            toggleBtn.style.background = "linear-gradient(135deg, #f44336 0%, #d32f2f 100%)";
            
            adjustMobileLayout();

            // Slide up bottom drawer console
            anime({
                targets: drawer,
                bottom: 0,
                duration: 450,
                easing: 'cubicBezier(0.25, 0.8, 0.25, 1)'
            });

            // Adjust toggle button position dynamically based on actual drawer height
            const drawerHeight = drawer.offsetHeight;
            anime({
                targets: toggleContainer,
                bottom: drawerHeight + 25,
                duration: 450,
                easing: 'cubicBezier(0.25, 0.8, 0.25, 1)'
            });

            scanPageElements();
            updateBookmarkTabUI();
            createInspectorBadges();
            bindInspectEvents();
        }

        function deactivateInspector() {
            isActive = false;
            document.body.classList.remove("inspector-active");
            
            // Toggle button animation (Returns to orange/default and moves to bottom)
            toggleBtn.style.transform = "rotate(0deg)";
            toggleBtn.style.background = "linear-gradient(135deg, #ff9800 0%, #ff5722 100%)";
            
            anime({
                targets: toggleContainer,
                bottom: 25,
                duration: 400,
                easing: 'easeInQuad'
            });

            // Slide down bottom drawer console
            const drawerHeight = drawer.offsetHeight;
            anime({
                targets: drawer,
                bottom: -drawerHeight - 50,
                duration: 400,
                easing: 'easeInQuad'
            });

            removeInspectorBadges();
            unbindInspectEvents();
            
            // Reset contents
            inspectTitle.innerText = "Chưa Chọn Thành Phần";
            inspectDesc.innerText = "Bật Thanh Tra Giao Diện bằng cách nhấn nút biểu tượng Code ở góc trái. Di chuột để xem viền nhấp nháy, click trực tiếp vào thành phần bất kỳ (hoặc nhấp vào icon code nổi ở góc) để hiển thị toàn bộ code và hướng dẫn hoạt động, rồi nhấn 'Lưu thư mục nhớ' nếu muốn lưu lại xem sau!";
            inspectCode.innerText = "// Code block...";
            lastSelectedId = null;
            updateBookmarkButtonUI(null);
            
            adjustMobileLayout();
        }

        // Hover element scales up its badge to link them visually
        function handleElementHover(e) {
            e.stopPropagation();
            if (!isActive) return;

            const id = this.getAttribute("data-inspect-id");
            const badge = document.querySelector(`.inspector-element-badge[data-target-id="${id}"]`);
            if (badge) {
                badge.style.transform = "scale(1.25)";
            }
        }

        function handleElementHoverLeave(e) {
            e.stopPropagation();
            if (!isActive) return;

            const id = this.getAttribute("data-inspect-id");
            const badge = document.querySelector(`.inspector-element-badge[data-target-id="${id}"]`);
            if (badge) {
                badge.style.transform = "";
            }
        }

        // Intercept clicks on inspectable elements to view code (no auto-bookmark)
        function handleElementClick(e) {
            if (!isActive) return;
            
            e.preventDefault();
            e.stopPropagation();
            
            const id = this.getAttribute("data-inspect-id");
            if (id) {
                // Inspect component only
                inspectComponent(id);
            }
        }

        function bindInspectEvents() {
            const elements = document.querySelectorAll("[data-inspect-id]");
            elements.forEach(el => {
                el.addEventListener("mouseenter", handleElementHover);
                el.addEventListener("mouseleave", handleElementHoverLeave);
                el.addEventListener("click", handleElementClick, true); // Use capture phase to intercept before other click handlers
            });
        }

        function unbindInspectEvents() {
            const elements = document.querySelectorAll("[data-inspect-id]");
            elements.forEach(el => {
                el.removeEventListener("mouseenter", handleElementHover);
                el.removeEventListener("mouseleave", handleElementHoverLeave);
                el.removeEventListener("click", handleElementClick, true);
            });
        }

        // Manual Bookmark button click action
        bookmarkActionBtn.addEventListener("click", function () {
            if (!isActive || !lastSelectedId) return;
            toggleBookmark(lastSelectedId);
        });

        // Copy button action
        copyBtn.addEventListener("click", function () {
            if (!isActive || !lastSelectedId) return;

            const codeText = inspectCode.innerText;
            navigator.clipboard.writeText(codeText).then(function () {
                const originalText = copyBtn.innerHTML;
                copyBtn.innerHTML = `<i class="fa-solid fa-check text-success"></i> <span class="text-success">Copied!</span>`;
                setTimeout(function () {
                    copyBtn.innerHTML = originalText;
                }, 2000);
            }).catch(function (err) {
                console.error("Could not copy text: ", err);
            });
        });

        // Segment Tabs Event switching
        tabBtnComponents.addEventListener("click", () => {
            tabBtnComponents.classList.add("active-tab-style");
            tabBtnComponents.style.background = "rgba(255,255,255,0.08)";
            tabBtnBookmarks.classList.remove("active-tab-style");
            tabBtnBookmarks.style.background = "transparent";
            tabBtnBookmarks.style.color = "#6c757d";
            
            tabContentComponents.classList.remove("d-none");
            tabContentBookmarks.classList.add("d-none");
        });

        tabBtnBookmarks.addEventListener("click", () => {
            tabBtnBookmarks.classList.add("active-tab-style");
            tabBtnBookmarks.style.background = "rgba(255,255,255,0.08)";
            tabBtnComponents.classList.remove("active-tab-style");
            tabBtnComponents.style.background = "transparent";
            tabBtnComponents.style.color = "#6c757d";
            
            tabContentBookmarks.classList.remove("d-none");
            tabContentComponents.classList.add("d-none");
            updateBookmarkTabUI();
        });
        
        // Initial bookmarks check count
        bookmarkCountBadge.innerText = getBookmarks().length;
        adjustMobileLayout();
    });
</script>
