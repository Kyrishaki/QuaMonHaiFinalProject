        function renderWorkflowUI(data) {
            inspectWorkflowContainer.innerHTML = "";
            let steps = data.workflow;
            const id = lastSelectedId;
            
            if (!steps || steps.length === 0) {
                steps = workflowDb[id] || [];
                if (steps.length === 0) {
                    // Context-aware smart MVC generator based on properties present
                    const hasController = !!data.controller || (data.desc && data.desc.toLowerCase().includes("controller"));
                    const hasModel = !!data.model || (data.desc && (data.desc.toLowerCase().includes("model") || data.desc.toLowerCase().includes("csdl") || data.desc.toLowerCase().includes("database")));
                    
                    steps = [
                        {
                            title: "1. Hiển thị Giao diện (Razor View CSHTML)",
                            desc: `Thành phần <strong>${data.title}</strong> được kết xuất trên trình duyệt. Lắng nghe sự kiện người dùng tương tác.`
                        }
                    ];
                    
                    if (hasController) {
                        steps.push({
                            title: "2. Gửi Yêu cầu & Nhận xử lý (C# Controller)",
                            desc: "Request được gửi lên Backend. Controller tiếp nhận tham số từ URL/Form và xử lý kiểm duyệt bảo mật."
                        });
                    } else {
                        steps.push({
                            title: "2. Định tuyến URL & Xử lý (Routing Engine)",
                            desc: "Hệ thống định tuyến ASP.NET Core phân tích yêu cầu để ánh xạ URL đến tài nguyên xử lý tương thích."
                        });
                    }
                    
                    if (hasModel) {
                        steps.push({
                            title: "3. Truy vấn Dữ liệu thực thể (Entity Framework Model)",
                            desc: "Entity Framework Core truy vấn cơ sở dữ liệu SQL Server qua các Class Entity Model để lấy hoặc cập nhật thông tin."
                        });
                    } else {
                        steps.push({
                            title: "3. Chuyển tải dữ liệu (ViewBag / ViewBag Binding)",
                            desc: "Nạp dữ liệu cấu hình hoặc trạng thái từ Session, Cookie hoặc ViewBag để chuẩn bị kết xuất giao diện phản hồi."
                        });
                    }
                    
                    steps.push({
                        title: "4. Render phản hồi & Đồng bộ DOM (UI Rendering)",
                        desc: "Máy chủ trả về kết quả. JavaScript client-side cập nhật lại giao diện DOM và kích hoạt các hiệu ứng hoạt họa mượt mà."
                    });
            }
        }

            const timeline = document.createElement("div");
            timeline.className = "workflow-timeline";
            
            steps.forEach((step, idx) => {
                const stepEl = document.createElement("div");
                stepEl.className = "workflow-step";
                stepEl.style.animationDelay = `${idx * 0.12}s`;
                
                stepEl.innerHTML = `
                    <div class="workflow-badge ${idx === 0 ? 'workflow-badge-pulsing' : ''}">${idx + 1}</div>
                    <div class="workflow-card">
                        <h6 class="fw-bold text-warning mb-1" style="font-size: 0.82rem;"><i class="fa-solid fa-circle-check text-success me-1.5" style="font-size:0.75rem;"></i>${step.title}</h6>
                        <p class="text-white-50 small mb-0 lh-sm" style="font-size:0.75rem;">${step.desc}</p>
                    </div>
                `;
                timeline.appendChild(stepEl);
            });
            
            inspectWorkflowContainer.appendChild(timeline);
        }

        function updateSubTabUI() {
            const data = inspectorDb[lastSelectedId];
            if (!data) return;

            btnSubView.classList.remove("active");
            btnSubController.classList.remove("active");
            btnSubModel.classList.remove("active");
            btnSubWorkflow.classList.remove("active");

            if (activeSubTab === "workflow") {
                inspectCodeWrapper.classList.add("d-none");
                inspectWorkflowContainer.classList.remove("d-none");
                btnSubWorkflow.classList.add("active");
                renderWorkflowUI(data);
            } else {
                inspectCodeWrapper.classList.remove("d-none");
                inspectWorkflowContainer.classList.add("d-none");

                if (activeSubTab === "view") {
                    btnSubView.classList.add("active");
                    inspectCode.innerHTML = data.code;
                } else if (activeSubTab === "controller") {
                    btnSubController.classList.add("active");
                    inspectCode.innerHTML = data.controller || `// Controller C# code not available.`;
                } else if (activeSubTab === "model") {
                    btnSubModel.classList.add("active");
                    inspectCode.innerHTML = data.model || `// Model C# code not available.`;
                }
            }
        }

        btnSubView.addEventListener("click", () => {
            activeSubTab = "view";
            updateSubTabUI();
        });

        btnSubController.addEventListener("click", () => {
            activeSubTab = "controller";
            updateSubTabUI();
        });

        btnSubModel.addEventListener("click", () => {
            activeSubTab = "model";
            updateSubTabUI();
        });

        btnSubWorkflow.addEventListener("click", () => {
            activeSubTab = "workflow";
            updateSubTabUI();
        });
