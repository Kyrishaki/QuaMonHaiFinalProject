            "wishlist-remove-btn": {
                title: "Nút Bỏ Thích AJAX Trong Lưới Yêu Thích (AJAX Remove Favorite Heart)",
                desc: `<strong>HƯỚNG DẪN HOẠT ĐỘNG:</strong><br>
1. <strong>Frontend:</strong> Khi click nút Tim Đỏ (Bỏ Thích), JavaScript kích hoạt request AJAX POST gửi <code>MaHh</code> lên action <code>ToggleFavorite</code>.<br>
2. <strong>Backend (CustomerController.cs):</strong><br>
&nbsp;&nbsp;&nbsp;- Tìm thực thể trong bảng <code>YeuThiches</code> tương ứng với <code>CustomerID</code> và <code>MaHh</code>.<br>
&nbsp;&nbsp;&nbsp;- Xóa thực thể ra khỏi DB và lưu thay đổi.<br>
&nbsp;&nbsp;&nbsp;- Trả về JSON <code>{ success: true, isFavorite: false }</code>.<br>
3. <strong>Hiệu ứng UI:</strong> Nhận response, jQuery chạy hiệu ứng <code>fadeOut(400)</code> làm biến mất card sản phẩm đó.`,
                code: `&lt;!-- Nút thả tim yêu thích trong Wishlist.cshtml --&gt;\n&lt;button class="remove-favorite-btn" data-id="@@hh.MaHh" data-inspect-id="wishlist-remove-btn"&gt;\n    &lt;i class="fa-solid fa-heart text-danger"&gt;&lt;/i&gt;\n&lt;/button&gt;\n\n// Javascript gửi AJAX và làm mờ biến mất phần tử\n\$('.remove-favorite-btn').click(function(e) {\n    var btn = \$(this); var id = btn.data('id');\n    \$.ajax({\n        url: '/Customer/ToggleFavorite', type: 'POST', data: { id: id },\n        success: function(res) {\n            if(res.success && !res.isFavorite) {\n                \$('#wishlist-item-' + id).fadeOut(400, function() { \$(this).remove(); });\n            }\n        }\n    });\n});\n\n// C# Backend cập nhật thông tin ToggleFavorite\n[HttpPost]\npublic async Task&lt;IActionResult&gt; ToggleFavorite(int id) {\n    if (User.Identity?.IsAuthenticated != true) return Json(new { success = false });\n    var customerId = User.Claims.SingleOrDefault(c =&gt; c.Type == "CustomerID")?.Value;\n    var yeuThich = await db.YeuThiches.FirstOrDefaultAsync(y =&gt; y.MaKh == customerId && y.MaHh == id);\n    bool isFavorite = false;\n    if (yeuThich != null) {\n        db.YeuThiches.Remove(yeuThich); isFavorite = false;\n    } else {\n        db.YeuThiches.Add(new YeuThich { MaKh = customerId, MaHh = id, NgayChon = DateTime.Now });\n        isFavorite = true;\n    }\n    await db.SaveChangesAsync();\n    return Json(new { success = true, isFavorite = isFavorite });\n}`
            },
            "forgot-password-form": {
                title: "Form Yêu Cầu Quên Mật Khẩu (Forgot Password Verification Request)",
                desc: `<strong>HƯỚNG DẪN HOẠT ĐỘNG:</strong><br>
1. <strong>Frontend:</strong> Khách hàng nhập Tên đăng nhập và Email đã đăng ký trong <code>ForgotPasswordVM</code>.<br>
2. <strong>Backend (CustomerController.cs [POST]):</strong><br>
&nbsp;&nbsp;&nbsp;- Kiểm tra CSDL khớp tài khoản và email.<br>
&nbsp;&nbsp;&nbsp;- Sinh mã OTP ngẫu nhiên 6 số và lưu OTP cùng Username vào Session.<br>
&nbsp;&nbsp;&nbsp;- Gửi Email chứa mã OTP để người dùng thực hiện khôi phục mật khẩu.`,
                code: `// C# ViewModel (ViewModels/ForgotPasswordVM.cs)\npublic class ForgotPasswordVM {\n    [Display(Name = "Tên đăng nhập"), Required]\n    public string UserName { get; set; }\n\n    [Display(Name = "Email đã đăng ký"), Required, EmailAddress]\n    public string Email { get; set; }\n}\n\n&lt;!-- Form gửi yêu cầu quên mật khẩu trong ForgotPassword.cshtml --&gt;\n&lt;form asp-action="ForgotPassword" method="post"&gt;\n    &lt;input asp-for="UserName" class="form-control" /&gt;\n    &lt;input asp-for="Email" class="form-control" /&gt;\n    &lt;button type="submit"&gt;GỬI MÃ OTP&lt;/button&gt;\n&lt;/form&gt;\n\n// C# Backend xử lý trong CustomerController.cs\n[HttpPost]\npublic async Task&lt;IActionResult&gt; ForgotPassword(ForgotPasswordVM model) {\n    if (!ModelState.IsValid) return View(model);\n    var khachHang = db.KhachHangs.SingleOrDefault(kh =&gt; kh.MaKh == model.UserName && kh.Email == model.Email);\n    if (khachHang == null || !khachHang.HieuLuc) {\n        ModelState.AddModelError("", "Thông tin không chính xác hoặc bị khóa.");\n        return View(model);\n    }\n    string otpCode = new Random().Next(100000, 999999).ToString();\n    HttpContext.Session.SetString("ResetPassword_OTP", otpCode);\n    HttpContext.Session.SetString("ResetPassword_User", khachHang.MaKh);\n    // Gửi mail bằng MailKit SMTP\n    var message = new MimeKit.MimeMessage();\n    message.From.Add(new MimeKit.MailboxAddress("HShop", "trathanhclassic123@gmail.com"));\n    message.To.Add(new MimeKit.MailboxAddress(khachHang.HoTen, khachHang.Email));\n    message.Subject = "Mã xác thực đặt lại mật khẩu";\n    message.Body = new MimeKit.TextPart("html") { Text = $"&lt;p&gt;Mã OTP của bạn là: &lt;b&gt;{otpCode}&lt;/b&gt;&lt;/p&gt;" };\n    using (var client = new MailKit.Net.Smtp.SmtpClient()) {\n        await client.ConnectAsync("smtp.gmail.com", 587, MailKit.Security.SecureSocketOptions.StartTls);\n        await client.AuthenticateAsync("trathanhclassic123@gmail.com", "sgpyhcoqqcpeziyj");\n        await client.SendAsync(message);\n        await client.DisconnectAsync(true);\n    }\n    return RedirectToAction("ResetPassword");\n}`
            },
            "reset-password-form": {
                title: "Form Đặt Lại Mật Khẩu Mới (Reset Password & OTP Validation)",
                desc: `<strong>HƯỚNG DẪN HOẠT ĐỘNG:</strong><br>
&nbsp;&nbsp;&nbsp;- Đọc mã OTP lưu trong Session, so sánh với mã người dùng điền.<br>
&nbsp;&nbsp;&nbsp;- Đọc <code>MaKh</code> đang muốn reset mật khẩu trong Session.<br>
&nbsp;&nbsp;&nbsp;- Lấy tài khoản khách hàng từ DB, tạo khóa bảo mật <code>RandomKey</code> mới, băm mật khẩu mới với RandomKey mới và lưu cập nhật vào CSDL.<br>
&nbsp;&nbsp;&nbsp;- Hủy thông tin lưu trong Session để vô hiệu hóa OTP và chuyển hướng về trang Đăng nhập.`,
                code: `&lt;!-- Form thiết lập lại mật khẩu mới trong ResetPassword.cshtml --&gt;\n&lt;form asp-action="ResetPassword" method="post" data-inspect-id="reset-password-form"&gt;\n    &lt;input asp-for="VerificationCode" class="form-control" required /&gt;\n    &lt;input asp-for="NewPassword" type="password" class="form-control" required /&gt;\n    &lt;input asp-for="ConfirmPassword" type="password" class="form-control" required /&gt;\n    &lt;button type="submit"&gt;HOÀN TẤT ĐẶT LẠI MẬT KHẨU&lt;/button&gt;\n&lt;/form&gt;\n\n// C# Backend xử lý lưu mật khẩu mới sau khi xác thực OTP\n[HttpPost]\npublic IActionResult ResetPassword(ResetPasswordVM model) {\n    var sessionOtp = HttpContext.Session.GetString("ResetPasswordCode");\n    var sessionUser = HttpContext.Session.GetString("ResetPasswordUser");\n    if (model.VerificationCode == sessionOtp && !string.IsNullOrEmpty(sessionUser)) {\n        var kh = db.KhachHangs.SingleOrDefault(k =&gt; k.MaKh == sessionUser);\n        kh.RandomKey = MyUtil.GenerateRandomKey();\n        kh.MatKhau = model.NewPassword.ToMd5Hash(kh.RandomKey);\n        db.Update(kh); db.SaveChanges();\n        HttpContext.Session.Remove("ResetPasswordCode");\n        return RedirectToAction("Login");\n    }\n}`
            },
