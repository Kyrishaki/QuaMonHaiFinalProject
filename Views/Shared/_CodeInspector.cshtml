            "chat-bubble": {
                title: "Bong Bóng Chat Hỗ Trợ (Chat Bubble)",
                desc: "Widget trò chuyện thời gian thực dành cho khách hàng. Không hiển thị nếu người dùng có vai trò là Admin hoặc Staff để tránh xung đột giao diện, hỗ trợ gửi nhanh yêu cầu tư vấn sản phẩm đang xem.",
                code: `&lt;!-- Kiểm tra quyền hiển thị Widget chat trong _ChatBubble.cshtml --&gt;\n@@if (shouldShowChat && !User.IsInRole("Admin") && !User.IsInRole("Staff")) {\n    &lt;div id="customer-chat-widget"&gt;\n        &lt;button id="chat-bubble-btn"&gt;&lt;i class="fa-comments"&gt;&lt;/i&gt;&lt;/button&gt;\n    &lt;/div&gt;\n}`
            },
            "profile-form": {
                title: "Cập Nhật Hồ Sơ (Profile Form)",
                desc: `<strong>HƯỚNG DẪN HOẠT ĐỘNG:</strong><br>\n1. <strong>Frontend:</strong> Form gửi thông tin cá nhân qua phương thức POST, sử dụng <code>enctype="multipart/form-data"</code> để hỗ trợ tải ảnh lên.<br>\n2. <strong>Backend (CustomerController.cs):</strong> Khớp dữ liệu từ Form POST vào Model <code>KhachHang</code>, lưu ảnh đại diện (nếu có) thông qua helper <code>MyUtil.UploadAvatar</code>, cập nhật Database và ký lại Claims cookie để đồng bộ giao diện.`,
                code: `&lt;!-- Markup trong Views/Customer/Profile.cshtml --&gt;\n&lt;form asp-action="Profile" method="post" enctype="multipart/form-data"&gt;\n    &lt;input type="hidden" asp-for="MaKh" /&gt;\n    &lt;div class="row g-3" data-inspect-id="profile-info-fields"&gt;...&lt;/div&gt;\n    &lt;button type="submit" class="btn btn-success"&gt;Lưu Thay Đổi&lt;/button&gt;\n&lt;/form&gt;\n\n// Model KhachHang (Models/KhachHang.cs)\npublic partial class KhachHang {\n    public string MaKh { get; set; } = null!;\n    public string? MatKhau { get; set; }\n    public string HoTen { get; set; } = null!;\n    public bool GioiTinh { get; set; }\n    public DateTime NgaySinh { get; set; }\n    public string? DiaChi { get; set; }\n    public string? DienThoai { get; set; }\n    public string Email { get; set; } = null!;\n    public string? Hinh { get; set; }\n}\n\n// C# Controller xử lý POST trong CustomerController.cs\n[Authorize], [HttpPost], [ValidateAntiForgeryToken]\npublic async Task&lt;IActionResult&gt; Profile(KhachHang model, IFormFile? fHinh) {\n    var customerId = User.Claims.SingleOrDefault(c =&gt; c.Type == "CustomerID")?.Value;\n    var khachHang = db.KhachHangs.SingleOrDefault(kh =&gt; kh.MaKh == customerId);\n    khachHang.HoTen = model.HoTen;\n    khachHang.Email = model.Email;\n    khachHang.DienThoai = model.DienThoai;\n    khachHang.DiaChi = model.DiaChi;\n    khachHang.NgaySinh = model.NgaySinh;\n    khachHang.GioiTinh = model.GioiTinh;\n    if (fHinh != null && fHinh.Length &gt; 0) {\n        var uniqueFileName = MyUtil.UploadAvatar(fHinh, "KhachHang");\n        if (!string.IsNullOrEmpty(uniqueFileName)) khachHang.Hinh = uniqueFileName;\n    }\n    db.Update(khachHang);\n    db.SaveChanges();\n    await SignInUserAsync(khachHang);\n    return RedirectToAction("Profile");\n}`
            },
            "profile-avatar-upload": {
                title: "Tải Ảnh Đại Diện & Xử Lý Lưu Trữ (Profile Avatar Upload & Storage)",
                desc: `<strong>HƯỚNG DẪN HOẠT ĐỘNG:</strong><br>\n1. <strong>Frontend:</strong> Chọn tệp ảnh tải lên thông qua input <code>type="file" name="fHinh"</code> bên trong form có mã hóa <code>multipart/form-data</code>.<br>\n2. <strong>Backend (CustomerController.cs [POST]):</strong> Lấy tệp và lưu trữ bằng phương thức helper <code>MyUtil.UploadAvatar(fHinh, "KhachHang")</code> để tạo tên tệp duy nhất, sau đó cập nhật đường dẫn vào trường Hinh của Khách hàng trong Database.`,
                code: `&lt;!-- Input Upload Ảnh trong Profile.cshtml --&gt;\n&lt;input type="file" name="fHinh" class="form-control" accept="image/*" /&gt;\n\n// Hàm Helper Xử lý Upload trong Helpers/MyUtil.cs\npublic static string UploadAvatar(IFormFile fHinh, string folder) {\n    try {\n        var fileName = Guid.NewGuid().ToString() + Path.GetExtension(fHinh.FileName);\n        var path = Path.Combine(Directory.GetCurrentDirectory(), "wwwroot", "img", "Hinh", folder, fileName);\n        using (var stream = new FileStream(path, FileMode.Create)) {\n            fHinh.CopyTo(stream);\n        }\n        return fileName;\n    } catch { return string.Empty; }\n}`
            },
            "profile-info-fields": {
                title: "Các Trường Thông Tin Cá Nhân (Profile Info Fields)",
                desc: `<strong>HƯỚNG DẪN HOẠT ĐỘNG:</strong><br>\n1. <strong>Tự Động Điền & Binding:</strong> Sử dụng tag helper <code>asp-for</code> để tự động ánh xạ dữ liệu của 6 trường: Họ và tên, Giới tính, Ngày sinh, Số điện thoại, Email, Địa chỉ liên hệ.<br>\n2. <strong>Cập Nhật Backend (CustomerController.cs):</strong> Cập nhật các trường tương ứng của thực thể KhachHang trong DB và thực hiện <code>db.SaveChanges()</code>.`,
                code: `&lt;!-- HTML hiển thị 6 trường trong Profile.cshtml --&gt;\n&lt;input asp-for="HoTen" required /&gt;\n&lt;input type="radio" asp-for="GioiTinh" value="true"&gt; Nam\n&lt;input type="radio" asp-for="GioiTinh" value="false"&gt; Nữ\n&lt;input asp-for="NgaySinh" type="date" /&gt;\n&lt;input asp-for="DienThoai" /&gt;\n&lt;input asp-for="Email" type="email" /&gt;\n&lt;input asp-for="DiaChi" /&gt;`
            },
            "change-password-form": {
                title: "Đổi Mật Khẩu Khách Hàng (Change Customer Password)",
                desc: `<strong>HƯỚNG DẪN HOẠT ĐỘNG:</strong><br>\n1. <strong>Validation:</strong> Dùng ViewModel <code>ChangePasswordVM</code> để kiểm tra Mật khẩu cũ, Mật khẩu mới tối thiểu 6 ký tự, và Xác nhận mật khẩu mới (sử dụng <code>[Compare]</code>).<br>\n2. <strong>Cập Nhật Backend:</strong> Kiểm tra so khớp mật khẩu cũ đã được mã hóa MD5 kết hợp với RandomKey, băm mật khẩu mới và lưu vào DB.`,
                code: `// C# ViewModel (ViewModels/ChangePasswordVM.cs)\npublic class ChangePasswordVM {\n    public string OldPassword { get; set; }\n    public string NewPassword { get; set; }\n    [Compare("NewPassword")]\n    public string ConfirmPassword { get; set; }\n}\n\n// C# Backend đổi mật khẩu trong CustomerController.cs\n[HttpPost]\npublic IActionResult ChangePassword(ChangePasswordVM model) {\n    var customerId = User.Claims.SingleOrDefault(c =&gt; c.Type == "CustomerID")?.Value;\n    var khachHang = db.KhachHangs.SingleOrDefault(kh =&gt; kh.MaKh == customerId);\n    var hashedOldPassword = model.OldPassword.ToMd5Hash(khachHang.RandomKey);\n    if (khachHang.MatKhau == hashedOldPassword) {\n        khachHang.MatKhau = model.NewPassword.ToMd5Hash(khachHang.RandomKey);\n        db.SaveChanges();\n    }\n}`
            },
            "login-form": {
                title: "Trang Đăng Nhập Tài Khoản (Customer Login Page Form)",
                desc: `<strong>HƯỚNG DẪN HOẠT ĐỘNG:</strong><br>\n1. <strong>Giao diện:</strong> Form nhập Tên đăng nhập và Mật khẩu. Hỗ trợ ghi nhớ ReturnUrl để chuyển hướng sau khi đăng nhập thành công.<br>\n2. <strong>Xác thực:</strong> Gửi dữ liệu về Controller để xác minh thông tin tài khoản qua Cookie Authentication.`,
                code: `&lt;!-- Form Đăng Nhập tổng thể trong Login.cshtml --&gt;\n&lt;form asp-action="Login" asp-route-returnurl="@@ViewBag.ReturnUrl" method="post"&gt;\n    &lt;div data-inspect-id="login-fields"&gt;...&lt;/div&gt;\n    &lt;div data-inspect-id="login-recaptcha"&gt;...&lt;/div&gt;\n    &lt;button type="submit" class="btn btn-primary"&gt;ĐĂNG NHẬP&lt;/button&gt;\n&lt;/form&gt;`
            },
            "login-fields": {
                title: "Thông Tin Tên Đăng Nhập & Mật Khẩu (Login Credentials Inputs)",
                desc: `<strong>HƯỚNG DẪN HOẠT ĐỘNG:</strong><br>
1. <strong>Frontend:</strong> Ô nhập Tên đăng nhập (UserName) và Mật khẩu (Password). Ràng buộc Validation kiểm tra dữ liệu đầu vào.<br>
2. <strong>C# Backend (CustomerController.cs [POST]):</strong><br>
&nbsp;&nbsp;&nbsp;- Sử dụng khóa muối <code>RandomKey</code> của thực thể KhachHang trong DB để băm MD5 mật khẩu và đối chiếu.<br>
&nbsp;&nbsp;&nbsp;- Đăng ký phiên đăng nhập qua Cookie Authentication: tạo danh sách các <code>Claim</code> bao gồm Mã khách hàng, Tên hiển thị và Vai trò (Role).`,
                code: `// C# ViewModel (ViewModels/LoginVM.cs)\npublic class LoginVM {\n    [Display(Name = "Tên đăng nhập"), Required(ErrorMessage = "Chưa nhập tên đăng nhập")]\n    [MaxLength(20, ErrorMessage = "Tối đa 20 ký tự")]\n    public string UserName { get; set; }\n\n    [Display(Name = "Mật khẩu"), Required(ErrorMessage = "Chưa nhập mật khẩu")]\n    [DataType(DataType.Password)]\n    public string Password { get; set; }\n    public string? RecaptchaResponse { get; set; }\n}\n\n&lt;!-- Nhóm input thông tin đăng nhập trong Login.cshtml --&gt;\n&lt;div class="form-floating mb-4"&gt;\n    &lt;input asp-for="UserName" class="form-control" placeholder="Tên đăng nhập" /&gt;\n&lt;/div&gt;\n&lt;div class="form-floating mb-4"&gt;\n    &lt;input asp-for="Password" type="password" class="form-control" /&gt;\n&lt;/div&gt;\n\n// C# Backend xử lý Claims trong CustomerController.cs\nvar khachHang = db.KhachHangs.SingleOrDefault(kh =&gt; kh.MaKh == model.UserName);\nif (khachHang != null && khachHang.MatKhau == model.Password.ToMd5Hash(khachHang.RandomKey)) {\n    string userRole = khachHang.VaiTro == 1 ? "Admin" : (khachHang.VaiTro == 2 ? "Staff" : "Customer");\n    var claims = new List&lt;Claim&gt; {\n        new Claim(ClaimTypes.Email, khachHang.Email ?? ""),\n        new Claim(ClaimTypes.Name, khachHang.HoTen ?? ""),\n        new Claim("CustomerID", khachHang.MaKh),\n        new Claim(ClaimTypes.Role, userRole)\n    };\n    var claimsIdentity = new ClaimsIdentity(claims, CookieAuthenticationDefaults.AuthenticationScheme);\n    await HttpContext.SignInAsync(new ClaimsPrincipal(claimsIdentity));\n}`
            },
            "login-recaptcha": {
                title: "Tích Hợp Google reCAPTCHA v2 (Google reCAPTCHA Verification)",
                desc: `<strong>HƯỚNG DẪN HOẠT ĐỘNG:</strong><br>
1. <strong>Frontend:</strong> Hiển thị Widget reCAPTCHA bằng thư viện JS và gán khóa công khai <code>SiteKey</code>.<br>
2. <strong>Backend:</strong> Gọi API Google Verify (gửi POST xác thực mã phản hồi <code>g-recaptcha-response</code>) bằng <code>HttpClient</code> kèm theo Secret Key bảo mật để kiểm duyệt Captcha.`,
                code: `&lt;!-- Google reCAPTCHA Widget trong Login.cshtml --&gt;\n&lt;script src="https://www.google.com/recaptcha/api.js" async defer&gt;&lt;/script&gt;\n&lt;div class="g-recaptcha" data-sitekey="6Le0Z-MsAAAAAB7YQK_ITslpZxYtzmtTi5h8O6Nr"&gt;&lt;/div&gt;\n\n// C# Backend gọi API Google Verify\nvar captchaResponse = Request.Form["g-recaptcha-response"];\nusing (var client = new HttpClient()) {\n    var secretKey = "6Le0Z-MsAAAAABmtR4FCdgxg4GekC-nY9L_4Tdob";\n    var response = await client.PostAsync("https://www.google.com/recaptcha/api/siteverify?secret=" + secretKey + "&response=" + captchaResponse, null);\n    var jsonString = await response.Content.ReadAsStringAsync();\n    dynamic jsonData = JsonConvert.DeserializeObject(jsonString);\n    if (jsonData.success != "true") {\n        ModelState.AddModelError("loi", "Xác thực robot không hợp lệ.");\n    }\n}`
            },
            "register-form": {
                title: "Trang Đăng Ký Tài Khoản Mới (Customer Registration Form)",
                desc: `<strong>HƯỚNG DẪN HOẠT ĐỘNG:</strong><br>
1. <strong>Giao diện:</strong> Form thu thập thông tin đăng ký thành viên mới của hệ thống.<br>
2. <strong>Xác thực:</strong> Kiểm tra Email qua OTP và các thông tin bắt buộc trước khi lưu vào Database.`,
                code: `&lt;!-- Form Đăng Ký thành viên trong Register.cshtml --&gt;\n&lt;form asp-action="Register" enctype="multipart/form-data" method="post"&gt;\n    &lt;div data-inspect-id="register-fields"&gt;...&lt;/div&gt;\n    &lt;div data-inspect-id="register-otp-section"&gt;...&lt;/div&gt;\n    &lt;button type="submit" class="btn btn-success"&gt;ĐĂNG KÝ TÀI KHOẢN&lt;/button&gt;\n&lt;/form&gt;`
            },
            "register-fields": {
                title: "Thông Tin Tài Khoản Đăng Ký (Member Registration Info Fields)",
                desc: `<strong>HƯỚNG DẪN HOẠT ĐỘNG:</strong><br>
1. <strong>Frontend:</strong> Nhập Tên đăng nhập, Mật khẩu, Họ tên, Giới tính, Ngày sinh, Điện thoại, Địa chỉ, Email và hình ảnh.<br>
2. <strong>C# Backend (CustomerController.cs [POST]):</strong><br>
&nbsp;&nbsp;&nbsp;- So khớp OTP verify qua email.<br>
&nbsp;&nbsp;&nbsp;- Map dữ liệu từ <code>RegisterVM</code> sang <code>KhachHang</code> bằng <code>AutoMapper</code>.<br>
&nbsp;&nbsp;&nbsp;- Tạo khóa muối bảo mật ngẫu nhiên, băm mật khẩu MD5, phân quyền Khách hàng mặc định và lưu DB.`,
                code: `// C# ViewModel (ViewModels/RegisterVM.cs)\npublic class RegisterVM {\n    [Display(Name = "Tên đăng nhập"), Required, MaxLength(20)]\n    public string MaKh { get; set; }\n\n    [Display(Name = "Mật Khẩu"), Required, DataType(DataType.Password)]\n    public string MatKhau { get; set; }\n\n    [Display(Name = "Họ Tên"), Required, MaxLength(50)]\n    public string HoTen { get; set; }\n    public bool GioiTinh { get; set; } = true;\n\n    [Display(Name = "Ngày sinh"), DataType(DataType.Date), AgeRange]\n    public DateTime? NgaySinh { get; set; }\n\n    [Display(Name = "Điện Thoại"), MaxLength(10), RegularExpression(@@"^0(3|5|7|8|9)\\d{8}$")]\n    public string DienThoai { get; set; }\n\n    [Display(Name = "Email"), Required, EmailAddress]\n    public string Email { get; set; }\n    public string? Hinh { get; set; }\n\n    [Display(Name = "Mã xác nhận Email"), Required]\n    public string VerificationCode { get; set; }\n}\n\n// C# Backend xử lý tạo mới tài khoản trong CustomerController.cs\n[HttpPost]\npublic IActionResult Register(RegisterVM model, IFormFile? Hinh) {\n    var sessionCode = HttpContext.Session.GetString("EmailVerifyCode");\n    if (string.IsNullOrEmpty(sessionCode) || model.VerificationCode != sessionCode) {\n        ModelState.AddModelError("VerificationCode", "Mã xác thực không chính xác.");\n    }\n    if (ModelState.IsValid) {\n        if (db.KhachHangs.Any(kh =&gt; kh.MaKh == model.MaKh)) {\n            ModelState.AddModelError("MaKh", "Tên đăng nhập đã tồn tại.");\n            return View(model);\n        }\n        var khachHang = _mapper.Map&lt;KhachHang&gt;(model);\n        khachHang.RandomKey = MyUtil.GenerateRandomKey();\n        khachHang.MatKhau = model.MatKhau.ToMd5Hash(khachHang.RandomKey);\n        khachHang.HieuLuc = true;\n        khachHang.VaiTro = 0;\n        if (Hinh != null && Hinh.Length &gt; 0) {\n            khachHang.Hinh = MyUtil.UploadAvatar(Hinh, "KhachHang");\n        } else {\n            khachHang.Hinh = "[API]:" + model.HoTen;\n        }\n        db.Add(khachHang); db.SaveChanges();\n        return RedirectToAction("Login");\n    }\n    return View(model);\n}`
            },
            "register-otp-section": {
                title: "Hệ Thống Gửi & Kiểm Tra Mã OTP Email (Email OTP Dispatcher)",
                desc: `<strong>HƯỚNG DẪN HOẠT ĐỘNG:</strong><br>
1. <strong>Frontend:</strong> Khi click nút 'Gửi mã', JavaScript gửi request AJAX POST chứa email nhập tới <code>/Customer/SendVerificationCode</code>.<br>
2. <strong>Backend:</strong> Sinh ngẫu nhiên mã OTP 6 số, lưu vào Session <code>EmailVerifyCode</code>. Khởi tạo đối tượng <code>MimeMessage</code> và kết nối máy chủ SMTP Gmail của MailKit qua Port 587 bảo mật TLS để gửi email.`,
                code: `&lt;!-- Nút bấm và ô nhập mã OTP trong Register.cshtml --&gt;\n&lt;input asp-for="Email" id="emailInput" /&gt;\n&lt;button type="button" id="btnSendCode"&gt;Gửi mã&lt;/button&gt;\n&lt;div id="verificationSection" style="display:none;"&gt;\n    &lt;input asp-for="VerificationCode" /&gt;\n&lt;/div&gt;\n\n// JavaScript xử lý gửi AJAX lấy mã OTP\n\$("#btnSendCode").click(function () {\n    var email = \$("#emailInput").val();\n    \$.post('/Customer/SendVerificationCode', { email: email }, function (res) {\n        if (res.success) { \$("#verificationSection").slideDown(); }\n    });\n});\n\n// C# gửi Email SMTP Gmail qua MailKit trong CustomerController.cs\n[HttpPost]\npublic async Task&lt;IActionResult&gt; SendVerificationCode(string email) {\n    if (string.IsNullOrEmpty(email)) return Json(new { success = false });\n    string otpCode = new Random().Next(100000, 999999).ToString();\n    HttpContext.Session.SetString("EmailVerifyCode", otpCode);\n    var message = new MimeKit.MimeMessage();\n    message.From.Add(new MimeKit.MailboxAddress("HShop", "trathanhclassic123@gmail.com"));\n    message.To.Add(new MimeKit.MailboxAddress("", email));\n    message.Subject = "Mã xác thực đăng ký tài khoản";\n    message.Body = new MimeKit.TextPart("html") { Text = $"&lt;h3&gt;Mã xác thực của bạn là: &lt;b style='color:red'&gt;{otpCode}&lt;/b&gt;&lt;/h3&gt;" };\n    using (var client = new MailKit.Net.Smtp.SmtpClient()) {\n        await client.ConnectAsync("smtp.gmail.com", 587, MailKit.Security.SecureSocketOptions.StartTls);\n        await client.AuthenticateAsync("trathanhclassic123@gmail.com", "sgpyhcoqqcpeziyj");\n        await client.SendAsync(message);\n        await client.DisconnectAsync(true);\n    }\n    return Json(new { success = true });\n}`
            },
            "blog-list": {
