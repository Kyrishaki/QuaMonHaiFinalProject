            "detail-specs": {
                title: "Thông Số Danh Mục & Tồn Kho (Details Specifications Summary)",
                desc: "Hiển thị các thông tin nền tảng của sản phẩm bao gồm Tên danh mục phân loại, Tên nhà cung cấp và số lượng hàng hóa thực tế còn trong kho hàng để khách tiện theo dõi.",
                code: `&lt;!-- Hiển thị danh mục & tồn kho trong Details.cshtml --&gt;\n&lt;span&gt;Danh mục: @@(Model.MaLoaiNavigation?.TenLoai ?? "N/A")&lt;/span&gt;\n&lt;span&gt;Nhà cung cấp: @@(Model.MaNccNavigation?.TenCongTy ?? "N/A")&lt;/span&gt;\n&lt;span&gt;Tồn kho: @@Model.SoLuong&lt;/span&gt;`
            },
            "detail-qty-select": {
                title: "Bộ Chọn Số Lượng Thêm Vào Giỏ (Details Quantity Selector Buttons)",
                desc: "Bộ nút cộng trừ tăng giảm số lượng sản phẩm muốn mua. Khống chế giới hạn số lượng mua tối đa bằng số lượng sản phẩm còn tồn kho bằng mã JavaScript phía Client-side.",
                code: `&lt;!-- Bộ tăng giảm số lượng trong Details.cshtml --&gt;\n&lt;button onclick="decreaseQty()"&gt;-&lt;/button&gt;\n&lt;input id="quantityInput" value="1" readonly /&gt;\n&lt;button onclick="increaseQty()"&gt;+&lt;/button&gt;\n\n// JS tăng giảm số lượng mua hàng\nfunction increaseQty() {\n    var val = parseInt(\$('#quantityInput').val());\n    var max = parseInt(\$('#quantityInput').data('max'));\n    if (val &lt; max) \$('#quantityInput').val(val + 1);\n}`
            },
            "detail-add-to-cart": {
                title: "Thao Tác Thêm Giỏ Hàng AJAX (Details Add To Cart AJAX Button)",
                desc: "Nút thêm sản phẩm vào giỏ hàng qua AJAX POST. Gửi yêu cầu gồm mã hàng hóa và số lượng chọn mua lên Controller và cập nhật badge giỏ hàng ngay lập tức.",
                code: `// AJAX thêm giỏ hàng trong Details.cshtml\n\$('#addToCartBtn').click(function() {\n    var id = \$(this).data('id'); \n    var qty = parseInt(\$('#quantityInput').val());\n    \$.post('/Cart/AddToCartAjax', { id: id, quantity: qty }, function(res) {\n        if(res.success) { \$('.cart-badge').text(res.count); }\n    });\n});`
            },
            "detail-wishlist-toggle": {
                title: "Nút Yêu Thích Sản Phẩm AJAX (Details AJAX Wishlist Heart Toggle)",
                desc: "Thả tim yêu thích sản phẩm. Gửi request AJAX POST lên để thêm hoặc xóa sản phẩm khỏi bảng Yêu Thích trong CSDL dựa vào phiên đăng nhập của khách hàng hiện tại.",
                code: `// AJAX thay đổi yêu thích sản phẩm trong Details.cshtml\n\$('.toggle-favorite-btn').click(function() {\n    var id = \$(this).data('id');\n    \$.post('/Customer/ToggleFavorite', { id: id }, function(res) {\n        // Toggle icon tim...\n    });\n});`
            },
            "detail-tabs-nav": {
                title: "Bộ Tab Mô Tả & Đánh Giá (Details Info Nav Tabs)",
                desc: "Thanh tiêu đề tab chuyển đổi giao diện giữa phần hiển thị Nội dung mô tả chi tiết của hàng hóa và lưới Danh sách ý kiến đánh giá phản hồi từ khách hàng.",
                code: `&lt;!-- Tab điều hướng nội dung chi tiết trong Details.cshtml --&gt;\n&lt;ul class="nav nav-tabs" id="productTab"&gt;\n    &lt;button data-bs-target="#description-pane" class="nav-link active"&gt;Mô tả sản phẩm&lt;/button&gt;\n    &lt;button data-bs-target="#reviews-pane" class="nav-link"&gt;Đánh giá&lt;/button&gt;\n&lt;/ul&gt;`
            },
            "detail-desc-tab": {
                title: "Nội Dung Mô Tả Chi Tiết (Details Description Pane)",
                desc: "Khu vực render văn bản mô tả kỹ thuật, chức năng và hướng dẫn sử dụng của hàng hóa được người quản trị soạn thảo trong Database.",
                code: `&lt;!-- Pane hiển thị mô tả trong Details.cshtml --&gt;\n&lt;div class="tab-pane fade show active" id="description-pane"&gt;\n    &lt;p style="white-space: pre-line;"&gt;@@Model.MoTa&lt;/p&gt;\n&lt;/div&gt;`
            },
            "detail-reviews-list": {
                title: "Danh Sách Ý Kiến Đánh Giá (Details Customer Reviews Feed)",
                desc: "Hiển thị danh sách các phản hồi đánh giá của khách hàng đối với hàng hóa. Tự động hiển thị tên khách hàng, số lượng sao đánh giá, thời gian bình luận và nội dung phản hồi chi tiết.",
                code: `&lt;!-- Danh sách phản hồi bình luận trong Details.cshtml --&gt;\n@@foreach (var r in (List&lt;BinhLuan&gt;)ViewBag.Reviews) {\n    &lt;div class="review-item"&gt;\n        &lt;h6&gt;@@r.MaKhNavigation?.HoTen&lt;/h6&gt;\n        &lt;span&gt;@@r.Sao sao&lt;/span&gt;\n        &lt;p&gt;@@r.NoiDung&lt;/p&gt;\n    &lt;/div&gt;\n}`
            },
            "detail-reviews-form": {
                title: "Hộp Nhập Gửi Đánh Giá Sản Phẩm (Details Add Review Form)",
                desc: "<strong>HƯỚNG DẪN HOẠT ĐỘNG:</strong><br>1. <strong>Kiểm duyệt mua hàng:</strong> Chỉ những khách hàng đã mua sản phẩm này thành công mới được quyền đánh giá.<br>2. <strong>Giới hạn lượt đánh giá:</strong> Số lượng đánh giá tối đa bằng tổng số lượng sản phẩm đó khách hàng đã từng mua.<br>3. <strong>Backend:</strong> Lưu bình luận mới vào Database qua <code>HangHoasController.cs [POST SendReview]</code>.",
                code: `// C# Backend xử lý lưu đánh giá trong HangHoasController.cs\n[HttpPost]\npublic async Task&lt;IActionResult&gt; SendReview(int maHh, int sao, string noiDung) {\n    var customerId = User.Claims.SingleOrDefault(c =&gt; c.Type == "CustomerID")?.Value;\n    var maxReviews = await _context.ChiTietHds\n        .Where(ct =&gt; ct.MaHdNavigation.MaKh == customerId && ct.MaHh == maHh && ct.MaHdNavigation.MaTrangThai != -1)\n        .SumAsync(ct =&gt; ct.SoLuong);\n    var writtenReviews = await _context.BinhLuans.CountAsync(bl =&gt; bl.MaKh == customerId && bl.MaHh == maHh);\n    if (maxReviews &gt; 0 && writtenReviews &lt; maxReviews) {\n        var review = new BinhLuan { MaHh = maHh, MaKh = customerId, Sao = sao, NoiDung = noiDung, Ngay = DateTime.Now };\n        _context.BinhLuans.Add(review); await _context.SaveChangesAsync();\n    }\n}`
            },
            "detail-related-products": {
                title: "Sản Phẩm Tương Tự (Details Related Products Grid)",
                desc: "Hiển thị danh sách các sản phẩm khác cùng loại danh mục hàng hóa (MaLoai) để gợi ý mua sắm thêm cho khách hàng.",
                code: `&lt;!-- Lưới sản phẩm tương tự trong Details.cshtml --&gt;\n@@foreach (var item in (List&lt;HangHoa&gt;)ViewBag.RelatedProducts) {\n    &lt;div class="col-md-3"&gt;\n        &lt;a asp-action="Details" asp-route-id="@@item.MaHh"&gt;@@item.TenHh&lt;/a&gt;\n    &lt;/div&gt;\n}`
            },
            "admin-chat-dashboard": {
                title: "Bảng Điều Khiển Chat Hỗ Trợ (Admin Support Chat Dashboard)",
                desc: "<strong>HƯỚNG DẪN HOẠT ĐỘNG:</strong><br>1. <strong>Tải danh sách phòng:</strong> Gọi GET <code>GetActiveRooms</code> hiển thị số tin nhắn chưa đọc.<br>2. <strong>Xem hội thoại:</strong> Gọi GET <code>GetRoomMessages</code> để lấy lịch sử tin nhắn và đánh dấu đã đọc.<br>3. <strong>Trả lời tin nhắn:</strong> Admin gửi POST lên <code>ReplyMessage</code> để lưu phản hồi vào Database.",
                code: `// C# Controller xử lý chat admin trong Controllers/AdminController.cs\n[Authorize(Roles = "Admin,Staff")]\npublic class AdminController : Controller {\n    public async Task&lt;IActionResult&gt; GetActiveRooms() {\n        var rooms = await _context.ChatMessages.GroupBy(m =&gt; m.ChatRoomId)\n            .Select(g =&gt; new { RoomId = g.Key, LastTime = g.Max(m =&gt; m.Timestamp) })\n            .OrderByDescending(r =&gt; r.LastTime).ToListAsync();\n        return Json(resultList);\n    }\n    public async Task&lt;IActionResult&gt; GetRoomMessages(string roomId) {\n        var unread = await _context.ChatMessages.Where(m =&gt; m.ChatRoomId == roomId && m.IsFromCustomer && !m.IsRead).ToListAsync();\n        foreach(var m in unread) m.IsRead = true; await _context.SaveChangesAsync();\n        return Json(messages);\n    }\n}`
            },
            "admin-order-management": {
                title: "Quản Lý Đơn Hàng Hệ Thống (Admin Orders Manager)",
                desc: "<strong>HƯỚNG DẪN HOẠT ĐỘNG:</strong><br>1. <strong>Hiển thị danh sách:</strong> Lấy toàn bộ danh sách đơn hàng kèm trạng thái.<br>2. <strong>Cập nhật trạng thái đơn:</strong> Admin gửi POST lên <code>UpdateOrderStatus</code> để cập nhật trạng thái.",
                code: `// C# Cập nhật trạng thái đơn hàng trong Controllers/AdminController.cs\n[HttpPost], [ValidateAntiForgeryToken]\npublic async Task&lt;IActionResult&gt; UpdateOrderStatus(int id, int statusId) {\n    var order = await _context.Orders.FirstOrDefaultAsync(h =&gt; h.MaHd == id);\n    if (order != null) {\n        order.MaTrangThai = statusId;\n        _context.Update(order); await _context.SaveChangesAsync();\n    }\n    return RedirectToAction(nameof(OrderHistory));\n}`
            },
            "admin-review-management": {
                title: "Quản Lý Đánh Giá Hệ Thống (Admin Reviews Moderator)",
                desc: "<strong>HƯỚNG DẪN HOẠT ĐỘNG:</strong><br>1. <strong>Kiểm duyệt phản hồi:</strong> Xem danh sách tất cả bình luận đánh giá.<br>2. <strong>Xóa đánh giá:</strong> Nhấp xóa gửi POST lên <code>DeleteReview</code> để xóa khỏi DB.",
                code: `// C# Xóa đánh giá của khách hàng trong Controllers/AdminController.cs\n[HttpPost], [ValidateAntiForgeryToken]\npublic async Task&lt;IActionResult&gt; DeleteReview(int id) {\n    var review = await _context.BinhLuans.FirstOrDefaultAsync(bl =&gt; bl.MaBl == id);\n    if (review != null) {\n        _context.BinhLuans.Remove(review); await _context.SaveChangesAsync();\n    }\n    return RedirectToAction(nameof(ReviewManagement));\n}`
            },
            "admin-user-management": {
                title: "Quản Lý Tài Khoản Thành Viên (Admin Users Manager)",
                desc: "<strong>HƯỚNG DẪN HOẠT ĐỘNG:</strong><br>1. <strong>Tìm kiếm thành viên:</strong> Hiển thị danh sách khách hàng.<br>2. <strong>Khóa tài khoản:</strong> Đổi trạng thái Hiệu lực (HieuLuc) của tài khoản khách hàng.<br>3. <strong>Phân quyền thành viên:</strong> Thay đổi vai trò (VaiTro) tài khoản.",
                code: `// C# Thay đổi quyền hạn tài khoản trong Controllers/AdminController.cs\n[HttpPost], [ValidateAntiForgeryToken]\npublic async Task&lt;IActionResult&gt; ChangeRole(string id, int vaiTro) {\n    var kh = await _context.KhachHangs.FirstOrDefaultAsync(k =&gt; k.MaKh == id);\n    if (kh != null) {\n        kh.VaiTro = vaiTro;\n        _context.Update(kh); await _context.SaveChangesAsync();\n    }\n    return RedirectToAction(nameof(UserManagement));\n}`
            },
            "order-history": {
                title: "Lịch Sử Mua Hàng Khách Hàng (Customer Orders History)",
                desc: "Trang hiển thị danh sách đơn hàng đã mua của khách hàng hiện tại. Hỗ trợ tìm kiếm theo mã đơn hàng, tên người nhận và lọc danh sách đơn hàng theo trạng thái vận đơn.",
                code: `// C# Khách hàng xem lịch sử đơn hàng trong Controllers/CartController.cs\npublic async Task&lt;IActionResult&gt; OrderHistory(string searchQuery, int? statusId) {\n    var customerId = GetCustomerId();\n    var query = _Context.HoaDons.Include(h =&gt; h.ChiTietHds).ThenInclude(c =&gt; c.MaHhNavigation)\n        .Where(h =&gt; h.MaKh == customerId).AsQueryable();\n    if (statusId.HasValue) query = query.Where(h =&gt; h.MaTrangThai == statusId.Value);\n    var dsHoaDon = await query.OrderByDescending(h =&gt; h.NgayDat).ToListAsync();\n    return View(dsHoaDon);\n}`
            },
            "about-content": {
                title: "Thông Tin Giới Thiệu Cửa Hàng (About Us Page Content)",
                desc: "Bố cục lưới Grid hiển thị thông tin giới thiệu về cửa hàng công nghệ QuaMonHai bao gồm lịch sử hình thành phát triển, sứ mệnh phục vụ khách hàng và đội ngũ nhân sự.",
                code: `&lt;!-- Lưới bố cục giới thiệu trong AboutUs.cshtml --&gt;\n&lt;div class="container-xxl py-5 mt-5" data-inspect-id="about-content"&gt;\n    &lt;div class="row g-5"&gt;\n        &lt;div class="col-lg-6"&gt;\n            &lt;h1&gt;Chào mừng bạn đến với QuaMonHai&lt;/h1&gt;\n        &lt;/div&gt;\n    &lt;/div&gt;\n&lt;/div&gt;`
            },
            "customer-sidebar": {
                title: "Thanh Tác Vụ Khách Hàng (Customer Cabinet Sidebar Menu)",
                desc: "Thanh menu dọc bên trái của bảng quản lý tài khoản khách hàng, chứa liên kết nhanh dẫn đến trang thông tin hồ sơ cá nhân, đổi mật khẩu, lịch sử mua hàng, danh sách yêu thích và đăng xuất.",
                code: `&lt;!-- Menu tác vụ khách hàng trong _CustomerSidebar.cshtml --&gt;\n&lt;div class="customer-sidebar" data-inspect-id="customer-sidebar"&gt;\n    &lt;a asp-action="Profile" asp-controller="Customer"&gt;Thông tin cá nhân&lt;/a&gt;\n    &lt;a asp-action="ChangePassword"&gt;Đổi mật khẩu&lt;/a&gt;\n&lt;/div&gt;`
            },
            "wishlist-table": {
                title: "Danh Sách Sản Phẩm Yêu Thích (Wishlist Goods Grid)",
                desc: "Lưới hiển thị các sản phẩm được khách hàng thả tim yêu thích để lưu lại xem sau. Cho phép xóa nhanh sản phẩm ra khỏi danh sách yêu thích bằng AJAX.",
                code: `&lt;!-- Lưới sản phẩm yêu thích trong Wishlist.cshtml --&gt;\n&lt;div id="wishlist-container" class="row g-4" data-inspect-id="wishlist-table"&gt;\n    @@foreach (var hh in Model) {\n        &lt;div id="wishlist-item-@@hh.MaHh"&gt;...&lt;/div&gt;\n    }\n&lt;/div&gt;`
            },


            "order-success": {
                title: "Trang Xác Nhận Đặt Hàng Thành Công (Order Success Page)",
                desc: `<strong>HƯỚNG DẪN HOẠT ĐỘNG:</strong><br>
1. <strong>Model:</strong> Nhận đối tượng <code>HoaDon</code> từ Controller sau khi checkout thành công.<br>
2. <strong>Hiển thị:</strong> Render mã đơn hàng, tên người nhận, địa chỉ, phương thức thanh toán và danh sách sản phẩm.<br>
3. <strong>Controller (CartController.cs):</strong> Action <code>CheckOut [POST]</code> tạo HoaDon, lưu DB và redirect sang trang Success.`,
                code: `// Model: Models/HoaDon.cs\npublic partial class HoaDon {\n    public int MaHd { get; set; }\n    public string? MaKh { get; set; }\n    public string HoTen { get; set; } = null!;\n    public long? SoDienThoai { get; set; }\n    public string? DiaChi { get; set; }\n    public string? CachThanhToan { get; set; }\n    public DateTime? NgayDat { get; set; }\n    public int MaTrangThai { get; set; }\n    public decimal? PhiVanChuyen { get; set; }\n    public ICollection&lt;ChiTietHd&gt; ChiTietHds { get; set; }\n}\n\n// Controller: CartController.cs [POST]\npublic async Task&lt;IActionResult&gt; CheckOut(CheckOutVM model) {\n    var hoaDon = new HoaDon {\n        MaKh = GetCustomerId(),\n        HoTen = model.HoTen,\n        SoDienThoai = model.SoDienThoai,\n        DiaChi = model.DiaChi,\n        CachThanhToan = model.CachThanhToan,\n        NgayDat = DateTime.Now,\n        MaTrangThai = 0,\n        PhiVanChuyen = 30000\n    };\n    _Context.HoaDons.Add(hoaDon);\n    await _Context.SaveChangesAsync();\n    // Thêm chi tiết hóa đơn, xóa giỏ hàng session\n    return RedirectToAction("OrderSuccess", new { id = hoaDon.MaHd });\n}`
            },
            "order-summary-info": {
                title: "Thông Tin Tóm Tắt Đơn Hàng (Order Info Summary Card)",
                desc: "Hiển thị chi tiết đơn hàng: Mã đơn, tên người nhận, số điện thoại, phương thức thanh toán và địa chỉ giao hàng.",
                code: `&lt;!-- Card tóm tắt đơn trong OrderSuccess.cshtml --&gt;\n&lt;div class="card bg-light border-0 rounded-3 mb-4" data-inspect-id="order-summary-info"&gt;\n    &lt;div class="card-body p-4"&gt;\n        &lt;h5&gt;&lt;i class="fa-solid fa-file-invoice"&gt;&lt;/i&gt;Thông tin đơn hàng&lt;/h5&gt;\n        &lt;span&gt;#@@Model.MaHd&lt;/span&gt;\n        &lt;span&gt;@@Model.HoTen&lt;/span&gt;\n        &lt;span&gt;@@(Model.CachThanhToan == "cod" ? "Thanh toán khi nhận hàng" : Model.CachThanhToan)&lt;/span&gt;\n        &lt;span&gt;@@Model.DiaChi&lt;/span&gt;\n    &lt;/div&gt;\n&lt;/div&gt;`
            },
            "order-success-items": {
                title: "Danh Sách Sản Phẩm Đã Mua (Order Success Items List)",
                desc: "Liệt kê tất cả sản phẩm trong đơn hàng vừa đặt thành công kèm hình ảnh, tên, số lượng và thành tiền. Tính tổng cộng phí vận chuyển và giảm giá.",
                code: `&lt;!-- Hiển thị sản phẩm trong OrderSuccess.cshtml --&gt;\n@@foreach (var cthd in Model.ChiTietHds) {\n    &lt;div class="list-group-item p-3"&gt;\n        &lt;img src="~/img/Hinh/HangHoa/@@cthd.MaHhNavigation.Hinh" /&gt;\n        &lt;h6&gt;@@cthd.MaHhNavigation.TenHh&lt;/h6&gt;\n        &lt;small&gt;Số lượng: @@cthd.SoLuong&lt;/small&gt;\n        &lt;span&gt;@@((cthd.DonGia * cthd.SoLuong).ToString("N0"))₫&lt;/span&gt;\n    &lt;/div&gt;\n}\n\n// Tổng thanh toán gồm phí vận chuyển:\n@@((Model.ChiTietHds.Sum(c => c.DonGia * c.SoLuong) + Model.PhiVanChuyen - Model.ChiTietHds.Sum(c => c.GiamGia)).ToString("N0"))₫`
            },
            "order-success-actions": {
                title: "Nút Hành Động Sau Đặt Hàng (Order Success Action Buttons)",
                desc: "Hai nút điều hướng sau khi đặt hàng thành công: Xem lịch sử đơn hàng và Tiếp tục mua sắm.",
                code: `&lt;!-- Nút điều hướng trong OrderSuccess.cshtml --&gt;\n&lt;a href="/Cart/OrderHistory" class="btn btn-outline-success"&gt;\n    &lt;i class="fa-solid fa-clock-rotate-left"&gt;&lt;/i&gt;Lịch sử đơn hàng\n&lt;/a&gt;\n&lt;a href="/" class="btn btn-success"&gt;\n    &lt;i class="fa-solid fa-bag-shopping"&gt;&lt;/i&gt;Tiếp tục mua sắm\n&lt;/a&gt;`
            },
            "product-create-form": {
                title: "Form Thêm Mới Sản Phẩm - Admin (Product Create Form)",
                desc: `<strong>HƯỚNG DẪN HOẠT ĐỘNG:</strong><br>
1. <strong>Phân quyền:</strong> Chỉ Admin/Staff mới truy cập được (Authorize Role).<br>
2. <strong>Upload ảnh:</strong> File ảnh được nhận qua <code>IFormFile fHinh</code> và lưu vào <code>wwwroot/img/Hinh/HangHoa/</code>.<br>
3. <strong>Controller (HangHoasController.cs [POST]):</strong> Map dữ liệu form vào Model HangHoa, lưu DB và redirect về Index.`,
