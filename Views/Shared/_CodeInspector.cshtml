                title: "Badge Đã Bán Sản Phẩm (Product Card Sold Count)",
                desc: "Hiển thị tổng số lượng sản phẩm đã được bán thành công (không tính các đơn hàng bị hủy - mã trạng thái = -1). Dữ liệu được đếm tối ưu tại Controller bằng cách GroupBy theo mã hàng hóa trên bảng Chi tiết hóa đơn và truyền qua ViewBag.",
                code: `// GroupBy đếm số lượng đã bán tại HangHoasController / HomeController\nvar soldCounts = await _context.ChiTietHds\n    .Where(ct =&gt; productIds.Contains(ct.MaHh) && ct.MaHdNavigation.MaTrangThai != -1)\n    .GroupBy(ct =&gt; ct.MaHh)\n    .Select(g =&gt; new { MaHh = g.Key, TotalSold = g.Sum(ct =&gt; ct.SoLuong) })\n    .ToDictionaryAsync(x =&gt; x.MaHh, x =&gt; x.TotalSold);\nViewBag.SoldCounts = soldCounts;`
            },
            "product-actions": {
                title: "Thanh Nút Thao Tác (Product Card Actions)",
                desc: "Nút hành động được phân quyền chi tiết. Nếu là khách thường thì hiển thị nút 'Chi tiết' và nút 'Thêm giỏ' (AJAX cập nhật số lượng tức thời). Nếu là Admin/Nhân viên thì hiển thị nút 'Sửa' và 'Xóa/Kích hoạt' sản phẩm.",
                code: `&lt;!-- Nút thao tác phân quyền trong Index.cshtml --&gt;\n&lt;div class="btn-group mt-auto"&gt;\n    &lt;a asp-action="Details" asp-route-id="@@item.MaHh"&gt;Chi tiết&lt;/a&gt;\n    @@if (User.IsInRole("Admin") || User.IsInRole("Staff")) {\n        &lt;a asp-action="Edit" asp-route-id="@@item.MaHh"&gt;Sửa&lt;/a&gt;\n    } else {\n        &lt;button type="button" data-id="@@item.MaHh" class="add-to-cart-ajax"&gt;Thêm giỏ&lt;/button&gt;\n    }\n&lt;/div&gt;`
            },
            "cart-table": {
                title: "Danh Sách Hàng Trong Giỏ (Cart Item Rows)",
                desc: "Bảng hiển thị các sản phẩm đã chọn mua. Hỗ trợ cập nhật số lượng trực tuyến qua AJAX, tính lại thành tiền của dòng sản phẩm và xóa sản phẩm khỏi giỏ hàng kèm theo hiệu ứng phai mờ (fadeOut) đẹp mắt.",
                code: `// AJAX xóa sản phẩm khỏi giỏ hàng trong Cart/Index.cshtml\n$('.delete-cart-item-ajax').click(function() {\n    var id = $(this).data('id');\n    $.ajax({\n        url: '/Cart/DeleteAjax', type: 'POST', data: { id: id },\n        success: function(res) {\n            $('#row-' + id).fadeOut(300, function() { \n                $(this).remove(); \n                calculateCheckedTotal(); \n            });\n        }\n    });\n});`
            },
            "cart-totals": {
                title: "Tổng Kết & Thanh Toán Giỏ Hàng (Cart Totals Summary)",
                desc: "Chứa nút chọn tất cả, tổng số lượng sản phẩm được chọn và tổng số tiền thanh toán thực tế (được tính động qua JavaScript). Nút 'Mua Hàng' sẽ tự động kích hoạt (enable) khi có ít nhất một sản phẩm được tích chọn.",
                code: `// JS tính toán tổng tiền dựa trên checkbox được chọn trong Cart/Index.cshtml\nfunction calculateCheckedTotal() {\n    let total = 0, count = 0;\n    $('.item-checkbox:checked').each(function () {\n        let row = $(this).closest('.cart-item-row');\n        let price = parseFloat(row.find('.unit-price').data('price'));\n        let qty = parseInt(row.find('.qty-input').val());\n        total += price * qty;\n        count++;\n    });\n    $('#final-total').text(total + "$");\n    $('#btn-checkout').prop('disabled', count === 0);\n}`
            },
            "checkout-address": {
                title: "Địa Chỉ Giao Hàng & API Địa Chính (Checkout Address & API)",
                desc: "Khung thông tin người nhận hàng. Cho phép lấy nhanh địa chỉ đã lưu trong hồ sơ cá nhân hoặc điền địa chỉ mới thông qua việc gọi API địa chính công cộng Việt Nam để lấy động danh mục Tỉnh -> Quận -> Phường.",
                code: `// AJAX gọi API lấy thông tin Tỉnh/Quận/Xã Việt Nam\nasync function onProvinceChange(provinceCode) {\n    const response = await fetch('https://provinces.open-api.vn/api/p/' + provinceCode + '?depth=2');\n    const data = await response.json();\n    districtSelect.innerHTML = '&lt;option value=""&gt;Chọn Quận/Huyện&lt;/option&gt;';\n    data.districts.forEach(d =&gt; {\n        // Thêm option quận mới...\n    });\n}`
