            code: `<span class="cm">// ViewModel: ViewModels/RegisterVM.cs</span>\n<span class="kw">public class</span> <span class="vr">RegisterVM</span> {\n    [<span class="vr">Display</span>(Name = <span class="st">"Tên đăng nhập"</span>), <span class="vr">Required</span>, <span class="vr">MaxLength</span>(20)]\n    <span class="kw">public string</span> MaKh { <span class="kw">get</span>; <span class="kw">set</span>; }\n\n    [<span class="vr">Display</span>(Name = <span class="st">"Mật Khẩu"</span>), <span class="vr">Required</span>, <span class="vr">DataType</span>(<span class="vr">DataType</span>.Password)]\n    <span class="kw">public string</span> MatKhau { <span class="kw">get</span>; <span class="kw">set</span>; }\n\n    [<span class="vr">Display</span>(Name = <span class="st">"Họ Tên"</span>), <span class="vr">Required</span>, <span class="vr">MaxLength</span>(50)]\n    <span class="kw">public string</span> HoTen { <span class="kw">get</span>; <span class="kw">set</span>; }\n    <span class="kw">public bool</span> GioiTinh { <span class="kw">get</span>; <span class="kw">set</span>; } = <span class="kw">true</span>;\n\n    [<span class="vr">Display</span>(Name = <span class="st">"Ngày sinh"</span>), <span class="vr">DataType</span>(<span class="vr">DataType</span>.Date), <span class="vr">AgeRange</span>]\n    <span class="kw">public DateTime</span>? NgaySinh { <span class="kw">get</span>; <span class="kw">set</span>; }\n\n    [<span class="vr">Display</span>(Name = <span class="st">"Điện Thoại"</span>), <span class="vr">MaxLength</span>(10), <span class="vr">RegularExpression</span>(@@"^0(3|5|7|8|9)\\d{8}$")]\n    <span class="kw">public string</span> DienThoai { <span class="kw">get</span>; <span class="kw">set</span>; }\n\n    [<span class="vr">Display</span>(Name = <span class="st">"Email"</span>), <span class="vr">Required</span>, <span class="vr">EmailAddress</span>]\n    <span class="kw">public string</span> Email { <span class="kw">get</span>; <span class="kw">set</span>; }\n    <span class="kw">public string</span>? Hinh { <span class="kw">get</span>; <span class="kw">set</span>; }\n\n    [<span class="vr">Display</span>(Name = <span class="st">"Mã xác nhận Email"</span>), <span class="vr">Required</span>]\n    <span class="kw">public string</span> VerificationCode { <span class="kw">get</span>; <span class="kw">set</span>; }\n}\n\n&lt;!-- Markup trong Register.cshtml --&gt;\n&lt;input asp-for="MaKh" class="form-control" /&gt; ...\n\n// C# Backend xử lý tạo mới tài khoản trong CustomerController.cs\n[HttpPost]\npublic IActionResult Register(RegisterVM model, IFormFile? Hinh) {\n    var sessionCode = HttpContext.Session.GetString("EmailVerifyCode");\n    if (model.VerificationCode == sessionCode && ModelState.IsValid) {\n        var khachHang = _mapper.Map&lt;KhachHang&gt;(model);\n        khachHang.RandomKey = MyUtil.GenerateRandomKey();\n        khachHang.MatKhau = model.MatKhau.ToMd5Hash(khachHang.RandomKey);\n        khachHang.HieuLuc = true;\n        khachHang.VaiTro = 0;\n        db.Add(khachHang); db.SaveChanges();\n    }\n}`,
