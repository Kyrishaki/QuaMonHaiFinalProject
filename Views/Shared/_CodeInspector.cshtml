            "team-member-card": {
                title: "Hiệu Ứng Ảnh Động Thành Viên (Team Member 3-Zone Hover)",
                desc: "Thẻ thành viên nhóm phát triển. Ảnh thẻ có 3 phân vùng hover vô hình ở lề Trái, Giữa, Phải. Di chuột vào từng vùng sẽ thay đổi khoảng cách dịch chuyển 'translateX' của slider wrapper để đổi ảnh mượt mà mà không cần JS.",
                code: `/* CSS trượt vùng hover của thẻ thành viên trong AboutUs.cshtml */\n.hover-left:hover ~ .image-slider-wrapper { transform: translateX(0%); }\n.hover-center:hover ~ .image-slider-wrapper { transform: translateX(-33.333%); }\n.hover-right:hover ~ .image-slider-wrapper { transform: translateX(-66.666%); }`
