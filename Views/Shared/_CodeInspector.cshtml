@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "Index";
}

<!-- Code Inspector Trigger Toggle (Floating bottom-left) -->
<div id="code-inspector-toggle-container" class="position-fixed" style="left: 25px; bottom: 25px; z-index: 1000000; transition: transform 0.3s ease;">
    <button id="btn-toggle-inspector" class="btn d-flex align-items-center justify-content-center shadow-lg" 
            title="Bật/Tắt Trình thanh tra Code"
            style="width: 55px; height: 55px; border-radius: 50%; border: 2px solid #fff; background: linear-gradient(135deg, #ff9800 0%, #ff5722 100%); color: white; transition: all 0.3s; box-shadow: 0 4px 15px rgba(255,87,34,0.4) !important;">
        <i class="fa-solid fa-code fs-4"></i>
    </button>
</div>

<!-- Full-screen Blurred Backdrop Overlay -->
<div id="inspector-backdrop" style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(10, 10, 10, 0.45); backdrop-filter: blur(5px); -webkit-backdrop-filter: blur(5px); z-index: 999990; pointer-events: none; opacity: 0; transition: opacity 0.4s ease;"></div>

<!-- Notification Toast for bookmark confirmation -->
<div id="inspector-toast" class="position-fixed px-4 py-3 text-white rounded-3 shadow-lg" 
     style="left: 50%; bottom: 440px; transform: translateX(-50%) translateY(20px); opacity: 0; background: rgba(129, 196, 8, 0.95); backdrop-filter: blur(5px); border: 1.5px solid rgba(255,255,255,0.25); z-index: 1000002; transition: all 0.3s ease; pointer-events: none; font-weight: bold; font-family: 'Open Sans', sans-serif;">
</div>

<!-- Horizontal Bottom Drawer Console -->
<div id="inspector-bottom-drawer" class="shadow-lg" 
     style="position: fixed; bottom: -500px; left: 0; right: 0; width: 100vw; height: 480px; background: rgba(20, 20, 20, 0.94); backdrop-filter: blur(25px); -webkit-backdrop-filter: blur(25px); border-top: 3px solid #ff5722; z-index: 999999; display: flex; overflow: hidden; color: #fff; font-family: 'Open Sans', sans-serif; transition: bottom 0.4s cubic-bezier(0.25, 0.8, 0.25, 1);">
    
    <!-- Left Column: Pages Metadata, Scanned Elements, Bookmarks -->
    <div class="d-flex flex-column" style="width: 330px; border-right: 1.5px solid rgba(255,255,255,0.1); background: rgba(26, 26, 26, 0.85); flex-shrink: 0;">
        
        <!-- Header -->
        <div class="d-flex align-items-center justify-content-between p-3 text-white" style="background: linear-gradient(90deg, #ff9800 0%, #ff5722 100%);">
            <div class="d-flex align-items-center gap-2">
                <i class="fa-solid fa-terminal fs-5"></i>
                <h5 class="m-0 fw-bold" style="font-family: 'Lora', serif; font-size: 1.05rem; letter-spacing: 0.5px;">DEV CONSOLE</h5>
            </div>
            <button id="btn-close-drawer" class="btn btn-sm btn-link text-white p-0 border-0 text-decoration-none">
                <i class="fa fa-times fs-5"></i>
            </button>
        </div>

        <!-- Metadata & Path Info -->
        <div class="px-3 py-2 bg-black bg-opacity-20 border-bottom border-secondary border-opacity-10 small">
            <div class="d-flex flex-column gap-1 font-monospace" style="color: #e6c587; font-size: 0.75rem;">
                <div><strong>Route:</strong> /@controller/@action</div>
                <div><strong>View:</strong> Views/@controller/@(action).cshtml</div>
            </div>
        </div>

        <!-- Segmented Tab Header -->
        <div class="d-flex border-bottom border-secondary border-opacity-25" style="font-size: 0.85rem;">
            <button id="tab-btn-components" class="btn btn-sm flex-grow-1 text-white border-0 py-2.5 rounded-0 fw-bold active-tab-style" style="background: rgba(255,255,255,0.05); border-bottom: 2.5px solid #ff9800 !important;">
                CẤU PHẦN TRANG
            </button>
            <button id="tab-btn-bookmarks" class="btn btn-sm flex-grow-1 text-secondary border-0 py-2.5 rounded-0 fw-bold" style="background: transparent;">
                THƯ MỤC NHỚ (<span id="bookmark-count">0</span>)
            </button>
        </div>

        <!-- Tab Body Scrollable lists -->
        <div class="flex-grow-1 overflow-auto scrollbar-custom p-2">
            <!-- 1. List Page Components Scanned -->
            <div id="tab-content-components" class="d-flex flex-column gap-1">
                <!-- Populated dynamically via JS -->
            </div>
            
            <!-- 2. List Bookmarks saved -->
            <div id="tab-content-bookmarks" class="d-none d-flex flex-column gap-1">
                <!-- Populated dynamically via JS -->
            </div>
        </div>
    </div>

    <!-- Right Column: Title, Description, Actions, Horizontal Code View -->
    <div id="inspector-card-body-content" class="flex-grow-1 p-3 d-flex flex-column overflow-hidden">
        
        <!-- Component Header & Action buttons -->
        <div class="d-flex align-items-center justify-content-between mb-2">
            <div class="d-flex align-items-center overflow-hidden">
                <!-- Mobile Back Button -->
                <button id="btn-mobile-back" class="btn btn-sm btn-outline-warning me-2 border-0" 
                        style="border-radius: 6px; background: rgba(255,152,0,0.12); padding: 5px 10px; display: none; align-items: center; justify-content: center; color: #ff9800;">
                    <i class="fa-solid fa-arrow-left fs-6"></i>
                </button>
                <h5 id="inspect-title" class="fw-bold text-warning m-0 text-truncate" style="font-family: 'Lora', serif; font-size: 1.25rem;">
                    Chưa Chọn Thành Phần
                </h5>
            </div>
            <div class="d-flex align-items-center gap-2">
                <!-- Save Bookmark Action -->
                <button id="btn-bookmark-action" class="btn btn-sm btn-outline-warning border-0 px-3 py-1.5 fw-semibold d-flex align-items-center gap-1.5" style="font-size: 0.8rem; border-radius: 6px; background: rgba(255,152,0,0.08);">
                    <i class="fa-regular fa-star"></i> <span>Lưu thư mục nhớ</span>
                </button>
                <!-- Copy Code Action -->
                <button id="btn-copy-code" class="btn btn-sm btn-outline-light border-0 px-3 py-1.5 fw-semibold d-flex align-items-center gap-1.5" style="font-size: 0.8rem; border-radius: 6px; background: rgba(255,255,255,0.08);">
                    <i class="fa-regular fa-copy"></i> <span>Copy Code</span>
                </button>
            </div>
        </div>

        <!-- Description -->
        <div class="mb-3 px-3 py-2 rounded bg-white bg-opacity-5 border-start border-warning border-3">
            <p id="inspect-desc" class="small text-white-50 m-0 lh-base overflow-auto scrollbar-custom" style="max-height: 120px; min-height: 38px;">
                Bật <strong>Thanh Tra Giao Diện</strong> bằng cách nhấn nút biểu tượng Code ở góc trái. Di chuột để xem viền nhấp nháy, <strong>click trực tiếp vào thành phần bất kỳ (hoặc nhấp vào icon code nổi ở góc)</strong> để hiển thị toàn bộ code và hướng dẫn hoạt động, rồi nhấn <strong>Lưu thư mục nhớ</strong> nếu muốn lưu lại xem sau!
            </p>
        </div>

        <!-- Sub-tabs for View, Controller, Model, Workflow -->
        <div class="d-flex gap-2 mb-2 font-monospace" id="inspect-sub-tabs" style="font-size: 0.75rem; border-bottom: 1.5px solid rgba(255,255,255,0.06); padding-bottom: 6px;">
            <button id="btn-sub-view" class="btn btn-sm btn-outline-warning border-0 px-3 py-1 fw-bold active" style="border-radius: 4px; transition: all 0.2s;">
                <i class="fa-solid fa-file-code me-1"></i> VIEW (cshtml)
            </button>
            <button id="btn-sub-controller" class="btn btn-sm btn-outline-info border-0 px-3 py-1 fw-bold text-secondary d-none" style="border-radius: 4px; transition: all 0.2s;">
                <i class="fa-solid fa-gears me-1"></i> CONTROLLER (cs)
            </button>
            <button id="btn-sub-model" class="btn btn-sm btn-outline-success border-0 px-3 py-1 fw-bold text-secondary d-none" style="border-radius: 4px; transition: all 0.2s;">
                <i class="fa-solid fa-database me-1"></i> MODEL (cs)
            </button>
            <button id="btn-sub-workflow" class="btn btn-sm btn-outline-danger border-0 px-3 py-1 fw-bold text-secondary d-none" style="border-radius: 4px; transition: all 0.2s;">
                <i class="fa-solid fa-circle-play me-1"></i> CƠ CHẾ HOẠT ĐỘNG (Flow)
            </button>
        </div>

        <!-- Wide Code Container (No wrapping, horizontal scrolling) -->
        <div class="flex-grow-1 d-flex flex-column overflow-hidden position-relative" id="inspect-code-wrapper">
            <div class="position-absolute top-0 end-0 m-2 z-3">
                <span class="badge bg-dark text-warning border border-secondary border-opacity-50 font-monospace" style="font-size: 0.65rem;">CODE CONSOLE</span>
            </div>
            <pre class="bg-black bg-opacity-40 p-3 rounded-4 font-monospace small scrollbar-custom flex-grow-1 m-0" style="overflow: auto; line-height: 1.45; border: 1.5px solid rgba(255,255,255,0.06);"><code id="inspect-code" style="color: #abb2bf; display: block; white-space: pre;">// Code block...</code></pre>
        </div>

        <!-- Animated Workflow Diagram Container -->
        <div id="inspect-workflow-container" class="flex-grow-1 overflow-auto scrollbar-custom p-3 bg-black bg-opacity-40 rounded-4 border border-secondary border-opacity-10 d-none">
            <!-- Workflow content dynamically generated -->
        </div>
    </div>
</div>

<style>
    /* Active sub-tab styles */
    #btn-sub-view.active {
        color: #ff9800 !important;
        background: rgba(255, 152, 0, 0.15) !important;
        border: 1.5px solid rgba(255, 152, 0, 0.35) !important;
    }
    #btn-sub-controller.active {
        color: #0dcaf0 !important;
        background: rgba(13, 202, 240, 0.15) !important;
        border: 1.5px solid rgba(13, 202, 240, 0.35) !important;
    }
    #btn-sub-model.active {
        color: #198754 !important;
        background: rgba(25, 135, 84, 0.15) !important;
        border: 1.5px solid rgba(25, 135, 84, 0.35) !important;
    }

    #btn-sub-workflow.active {
        color: #dc3545 !important;
        background: rgba(220, 53, 69, 0.15) !important;
        border: 1.5px solid rgba(220, 53, 69, 0.35) !important;
    }

    /* Workflow Timeline Styling */
    .workflow-timeline {
        position: relative;
        padding-left: 26px;
        margin: 5px 0;
    }
    .workflow-timeline::before {
        content: '';
        position: absolute;
        left: 8px;
        top: 5px;
        bottom: 5px;
        width: 2px;
        background: rgba(255, 255, 255, 0.12);
    }
    .workflow-step {
        position: relative;
        margin-bottom: 18px;
        opacity: 0;
        transform: translateY(12px);
        animation: slideInUp 0.35s forwards ease-out;
    }
    .workflow-badge {
        position: absolute;
        left: -26px;
        top: 2px;
        width: 18px;
        height: 18px;
        border-radius: 50%;
        background: #333;
        border: 1.5px solid #222;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.6rem;
        font-weight: bold;
        color: #fff;
        z-index: 2;
    }
    .workflow-badge-pulsing {
        background: linear-gradient(135deg, #ff5722 0%, #ff9800 100%) !important;
        box-shadow: 0 0 8px rgba(255, 87, 34, 0.5);
        animation: pulseBadge 1.2s infinite alternate ease-in-out;
    }
    .workflow-card {
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.06);
        border-radius: 6px;
        padding: 8px 12px;
        transition: all 0.25s ease;
    }
    .workflow-card:hover {
        background: rgba(255, 255, 255, 0.06);
        border-color: rgba(255, 255, 255, 0.12);
        transform: translateX(3px);
    }
    
    @@keyframes slideInUp {
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    @@keyframes pulseBadge {
        0% { transform: scale(1); box-shadow: 0 0 4px rgba(255, 87, 34, 0.4); }
        100% { transform: scale(1.12); box-shadow: 0 0 12px rgba(255, 87, 34, 0.7); }
    }

    /* Backdrop active state for blurring */
    body.inspector-active #inspector-backdrop {
        opacity: 1 !important;
    }

    /* Elevate annotated components above blurred backdrop */
    body.inspector-active [data-inspect-id] {
        position: relative !important;
        z-index: 999995 !important;
        cursor: help !important;
        transition: outline 0.15s ease, box-shadow 0.15s ease, transform 0.15s ease;
    }
    body.inspector-active [data-inspect-id]:hover {
        outline: 3px dashed #ff9800 !important;
        outline-offset: 3px;
        box-shadow: 0 0 25px rgba(255, 152, 0, 0.4) !important;
        transform: scale(1.006);
    }

    /* Floating badge icon for inspectable components */
    .inspector-element-badge {
        position: absolute;
        z-index: 999997;
        width: 26px;
        height: 26px;
        border-radius: 50%;
        background: linear-gradient(135deg, #ff9800 0%, #ff5722 100%);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 3px 8px rgba(0,0,0,0.3);
        cursor: pointer;
        transition: transform 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275), box-shadow 0.2s ease;
        pointer-events: auto;
    }
    .inspector-element-badge i {
        font-size: 11px;
    }
    .inspector-element-badge:hover {
        transform: scale(1.25) !important;
        box-shadow: 0 4px 12px rgba(255, 87, 34, 0.6) !important;
        background: linear-gradient(135deg, #ffb74d 0%, #ff5722 100%);
    }

    /* Highlight syntax tokens inside pre code */
    .kw { color: #c678dd; font-weight: bold; } /* keyword */
    .tg { color: #e06c75; } /* html tag */
    .at { color: #d19a66; } /* attribute */
    .st { color: #98c379; } /* string */
    .cm { color: #5c6370; font-style: italic; } /* comment */
    .fn { color: #61afef; } /* function */
    .vr { color: #e5c07b; } /* variable/type */

    /* Sidebar active tab style */
    .active-tab-style {
        color: #fff !important;
        border-bottom: 2.5px solid #ff5722 !important;
        background: rgba(255,255,255,0.08) !important;
    }

    /* Custom scrollbar formatting */
    .scrollbar-custom::-webkit-scrollbar {
        width: 6px;
        height: 6px;
    }
    .scrollbar-custom::-webkit-scrollbar-track {
        background: rgba(0, 0, 0, 0.2);
        border-radius: 5px;
    }
    .scrollbar-custom::-webkit-scrollbar-thumb {
        background: rgba(255, 255, 255, 0.15);
        border-radius: 5px;
    }
    .scrollbar-custom::-webkit-scrollbar-thumb:hover {
        background: rgba(255, 255, 255, 0.3);
    }

    /* Mobile-specific responsive styles for the Code Inspector */
    @@media (max-width: 767px) {
        #inspector-bottom-drawer {
            height: 75vh !important;
            flex-direction: column !important;
            border-top-left-radius: 16px;
            border-top-right-radius: 16px;
        }
        /* Make the left list column full-width */
        #inspector-bottom-drawer > div:first-child {
            width: 100% !important;
            height: 100% !important;
            border-right: none !important;
            background: rgba(26, 26, 26, 0.98) !important;
        }
        /* Make the right detail column full-width */
        #inspector-card-body-content {
            width: 100% !important;
            height: 100% !important;
            padding: 12px !important;
            background: rgba(20, 20, 20, 0.98) !important;
        }
        /* Simplify margins and gaps for smaller viewports */
        #inspect-desc {
            max-height: 80px !important;
            font-size: 0.75rem !important;
        }
        #inspect-sub-tabs {
            flex-wrap: wrap !important;
            gap: 4px !important;
        }
        #inspect-sub-tabs button {
            padding: 4px 8px !important;
            font-size: 0.65rem !important;
        }
        #btn-bookmark-action span, #btn-copy-code span {
            display: none !important; /* Hide button text on mobile to save space, keeping only the icons */
        }
        #btn-bookmark-action, #btn-copy-code {
            padding: 6px !important;
            width: 32px !important;
            height: 32px !important;
            display: inline-flex !important;
            align-items: center;
            justify-content: center;
        }
        #inspect-code-wrapper pre {
            font-size: 0.65rem !important;
            padding: 8px !important;
        }
        /* Floating action toggle button */
        #btn-toggle-inspector {
            width: 48px !important;
            height: 48px !important;
        }
    }
</style>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        let isActive = false;
        let lastSelectedId = null;

        const toggleBtn = document.getElementById("btn-toggle-inspector");
        const toggleContainer = document.getElementById("code-inspector-toggle-container");
        const closeDrawerBtn = document.getElementById("btn-close-drawer");
        const backdrop = document.getElementById("inspector-backdrop");
        const drawer = document.getElementById("inspector-bottom-drawer");
        const toast = document.getElementById("inspector-toast");
        const mobileBackBtn = document.getElementById("btn-mobile-back");
        
        const inspectTitle = document.getElementById("inspect-title");
        const inspectDesc = document.getElementById("inspect-desc");
        const inspectCode = document.getElementById("inspect-code");
        
        const copyBtn = document.getElementById("btn-copy-code");
        const bookmarkActionBtn = document.getElementById("btn-bookmark-action");
        const bookmarkCountBadge = document.getElementById("bookmark-count");

        const tabBtnComponents = document.getElementById("tab-btn-components");
        const tabBtnBookmarks = document.getElementById("tab-btn-bookmarks");
        const tabContentComponents = document.getElementById("tab-content-components");
        const tabContentBookmarks = document.getElementById("tab-content-bookmarks");

        const btnSubView = document.getElementById("btn-sub-view");
        const btnSubController = document.getElementById("btn-sub-controller");
        const btnSubModel = document.getElementById("btn-sub-model");
        const btnSubWorkflow = document.getElementById("btn-sub-workflow");

        const inspectCodeWrapper = document.getElementById("inspect-code-wrapper");
        const inspectWorkflowContainer = document.getElementById("inspect-workflow-container");
        
        let activeSubTab = "view"; // "view", "controller", "model", "workflow"
        const workflowDb = {
            "navbar": [
                {
                    title: "1. Lắng nghe sự kiện Cuộn chuột (Scroll Event)",
                    desc: "JavaScript lắng nghe sự kiện scroll trên đối tượng window để theo dõi tọa độ cuộn màn hình."
                },
                {
                    title: "2. Kiểm tra mốc tọa độ 300px",
                    desc: "Nếu vị trí cuộn vượt quá 300px, JS thêm class 'custom-sticky' vào header, ngược lại loại bỏ class để trả về nguyên bản."
                },
                {
                    title: "3. Cố định phần tử (Sticky Style)",
                    desc: "Class 'custom-sticky' áp dụng CSS 'position: fixed; top: 0;' giúp Navbar bám dính đầu trang kèm hiệu ứng trượt mượt mà."
                }
            ],
            "navbar-brand": [
                {
                    title: "1. Nạp Tài nguyên Thương hiệu",
                    desc: "Trình duyệt tải logo, phông chữ nghệ thuật 'Lora' serif từ Google Fonts."
                },
                {
                    title: "2. Xử lý định dạng màu thương hiệu",
                    desc: "Áp dụng màu Primary (Xanh lá) và Secondary (Cam) với kiểu nghiêng 'italic' độc đáo ở chữ 'Hai'."
                },
                {
                    title: "3. Liên kết trang chủ (Index Routing)",
                    desc: "Tag Helper chèn URL trang chủ '/Home/Index' vào thẻ Anchor, giúp người dùng chuyển hướng nhanh chóng khi click."
                }
            ],
            "navbar-links": [
                {
                    title: "1. Lấy Route hiện tại (RouteData)",
                    desc: "Razor đọc tham số Route của Controller và Action đang xử lý yêu cầu phía máy chủ."
                },
                {
                    title: "2. Đối chiếu Menu Item",
                    desc: "So sánh Route hiện tại với đường dẫn của từng liên kết điều hướng trên Navbar chính."
                },
                {
                    title: "3. Gán trạng thái kích hoạt (Active Class)",
                    desc: "Tự động thêm class 'active' vào thẻ liên kết tương thích để tô sáng vị trí người dùng trên menu."
                }
            ],
            "navbar-cart": [
                {
                    title: "1. Đọc Session Giỏ Hàng",
                    desc: "Razor đọc danh sách CartItem từ Session 'GioHang' khi nạp trang."
                },
                {
                    title: "2. Sum SoLuong sản phẩm",
                    desc: "Nếu Session tồn tại, Razor tính tổng số lượng: soLuongGioHang = cart.Sum(c => c.SoLuong)."
                },
                {
                    title: "3. Hiển thị Badge đỏ nổi bật",
                    desc: "Nếu số lượng lớn hơn 0, một thẻ span badge vòng tròn đỏ được render động hiển thị số lượng."
                },
                {
                    title: "4. Đồng bộ AJAX thời gian thực",
                    desc: "Khi khách hàng click 'Thêm vào giỏ' ở bất kỳ đâu, AJAX POST cập nhật lại số lượng này ngay lập tức."
                }
            ],
            "search-input": [
                {
                    title: "1. Nhập từ khóa sản phẩm",
                    desc: "Người dùng nhập văn bản tên sản phẩm muốn tìm kiếm vào ô input ở Sidebar."
                },
                {
                    title: "2. Submit GET request đến HomeController",
                    desc: "Khi nhấn biểu tượng Kính lúp, hệ thống submit form gửi tham số searchQuery qua URL."
                },
                {
                    title: "3. Lọc danh sách bằng EF LINQ",
                    desc: "Hành động Index nhận searchQuery, lọc các HangHoa có TenHh chứa từ khóa và trả về View hiển thị kết quả."
                }
            ],
            "categories-list": [
                {
                    title: "1. Tải danh mục loại sản phẩm",
                    desc: "Hệ thống truy vấn danh sách các thực thể Loai từ DB kết hợp Include các HangHoa thuộc loại đó."
                },
                {
                    title: "2. Đếm số lượng sản phẩm động",
                    desc: "Razor đọc số lượng sản phẩm của từng loại thông qua thuộc tính Loai.HangHoas.Count để hiển thị lên badge."
                },
                {
                    title: "3. Lọc danh sách theo MaLoai",
                    desc: "Nhấp vào tên loại sẽ chèn tham số loaiId vào URL để lọc sản phẩm của danh mục được chọn."
                }
            ],
