            "order-lookup-timeline": {
                title: "Trực Quan Tiến Độ Vận Chuyển (Order Tracking Timeline)",
                desc: "Thanh tiến trình hiển thị quy trình giao vận. Kiểm tra tham số trạng thái đơn hàng (0: Mới đặt, 1: Đang chuẩn bị, 2: Đã giao, 3: Đã hủy) để tô màu sắc xanh lá/cam/đỏ tương ứng.",
                code: `&lt;!-- Tiến trình trạng thái vận đơn trong LookupOrder.cshtml --&gt;\n@@{ int currentStatus = Model.MaTrangThai; }\n&lt;div class="timeline-container"&gt;\n    &lt;div class="@@(currentStatus >= 0 ? \"bg-primary\" : \"\")"&gt;Mới đặt&lt;/div&gt;\n    &lt;div class="@@(currentStatus == 1 || currentStatus >= 2 ? \"bg-warning\" : \"\")"&gt;Đang chuẩn bị&lt;/div&gt;\n&lt;/div&gt;`
