@inject LTWEB_QuaMonHai_CuoiKy.Data.Hshop2023Context DbContext
<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="utf-8">
    <title>QuaMonHai - @ViewData["Title"]</title>
    <meta content="width=device-width, initial-scale=1.0" name="viewport">

    <link href="~/img/favicon.ico" rel="icon">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;500&family=Lora:wght@600;700&display=swap" rel="stylesheet">

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet">

    <link href="~/lib/animate/animate.min.css" rel="stylesheet">
    <link href="~/lib/owlcarousel/assets/owl.carousel.min.css" rel="stylesheet">

    <link href="~/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/css/style.css" rel="stylesheet">
    <style>
        /* Style for Floating Side Ad Banners */
        .ad-banner-container {
            position: fixed;
            top: 170px; /* Below the header/navbar */
            width: 220px; /* Big and wide format */
            z-index: 1050;
            transition: all 0.3s ease-in-out;
            animation: pulseZoom 2.5s infinite ease-in-out;
        }
        .left-ad {
            left: 20px;
        }
        .right-ad {
            right: 20px;
        }
        .ad-banner-card {
            display: block;
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.25) !important;
            border: 2px solid #81c408;
            transition: all 0.3s ease;
            background: #111;
        }
        .ad-banner-card:hover {
            border-color: #ffb300;
            box-shadow: 0 20px 45px rgba(129, 196, 8, 0.3) !important;
        }
        .ad-badge {
            text-align: center;
            font-size: 0.75rem;
            font-weight: bold;
            padding: 6px 0;
            letter-spacing: 1px;
            text-transform: uppercase;
        }
        .ad-img-container {
            width: 100%;
            height: 200px;
            background: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 10px;
            overflow: hidden;
        }
        .ad-product-img {
            max-width: 100%;
            max-height: 100%;
            object-fit: contain;
            transition: transform 0.5s ease;
        }
        .ad-banner-card:hover .ad-product-img {
            transform: scale(1.1);
        }
        .ad-info {
            border-top: 1px solid rgba(255,255,255,0.1);
            text-align: center;
        }
        .ad-title {
            font-size: 0.9rem;
            font-weight: 600;
            color: #fff;
            line-height: 1.4;
            height: 2.8em; /* Force height of 2 lines */
            overflow: hidden;
        }
        .text-primary-color {
            color: #81c408 !important;
        }
        .text-truncate-2 {
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }
        .ad-info .btn-primary {
            background-color: #81c408 !important;
            border-color: #81c408 !important;
            color: #fff !important;
            transition: all 0.3s ease;
        }
        .ad-info .btn-primary:hover {
            background-color: #ffb300 !important;
            border-color: #ffb300 !important;
        }

        /* Zoom in/out pulse animation */
        @@keyframes pulseZoom {
            0% {
                transform: scale(1);
            }
            50% {
                transform: scale(1.03); /* Subtle zoom */
            }
            100% {
                transform: scale(1);
            }
        }

        /* Adjust page container margins on ultra-wide screens to prevent overlap if necessary */
        @@media (min-width: 1400px) and (max-width: 1600px) {
            .ad-banner-container {
                width: 160px;
                top: 190px;
            }
            .ad-img-container {
                height: 150px;
            }
            .ad-title {
                font-size: 0.8rem;
            }
            .left-ad {
                left: 5px;
            }
            .right-ad {
                right: 5px;
            }
        }
    </style>
</head>

<body>
    <div id="spinner" class="show bg-white position-fixed translate-middle w-100 vh-100 top-50 start-50 d-flex align-items-center justify-content-center">
        <div class="spinner-border text-primary" role="status"></div>
    </div>
    @{
        var title = ViewData["Title"]?.ToString();
        bool hasHeader = title == "Cửa hàng của chúng tôi";

        // Lấy 2 sản phẩm ngẫu nhiên làm quảng cáo
        var randomProducts = DbContext.HangHoas
            .Where(h => h.HieuLuc && h.SoLuong > 0)
            .OrderBy(x => Guid.NewGuid()) // Ngẫu nhiên hóa trong database SQL Server
            .Take(2)
            .ToList();

        var leftProduct = randomProducts.FirstOrDefault();
        var rightProduct = randomProducts.Skip(1).FirstOrDefault();

        // Chỉ hiển thị ở trang sản phẩm chính (Home/Index, HangHoas/Index) và chi tiết (HangHoas/Details)
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
        
        bool showSideAds = (currentController == "Home" && currentAction == "Index") || 
                            (currentController == "HangHoas" && currentAction == "Index") || 
                            (currentController == "HangHoas" && currentAction == "Details");
    }

    <partial view name="_Navbar" />

    @if (hasHeader) {
        <partial view name="_Header" />
    }

    <main class="@(hasHeader ? "has-header" : "no-header")">
        @RenderBody()
    </main>

    <partial view name="_Footer" />

    <a href="#" class="btn btn-lg btn-primary btn-lg-square rounded-circle back-to-top"><i class="bi bi-arrow-up"></i></a>

    <partial name="_ChatBubble" />

    <script src="https://code.jquery.com/jquery-3.4.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/wow/wow.min.js"></script>
    <script src="~/lib/easing/easing.min.js"></script>
    <script src="~/lib/waypoints/waypoints.min.js"></script>
    <script src="~/lib/owlcarousel/owl.carousel.min.js"></script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/animejs/3.2.1/anime.min.js"></script>
    <script src="~/js/main.js"></script>

    @if (showSideAds)
    {
        <!-- Floating Side Ad Banners (Visible on XXL screens, >= 1400px) -->
        @if (leftProduct != null)
        {
            var leftImgUrl = leftProduct.Hinh != null && leftProduct.Hinh.StartsWith("http") 
                ? leftProduct.Hinh 
                : Url.Content("~/img/Hinh/HangHoa/" + (string.IsNullOrEmpty(leftProduct.Hinh) ? "no-image.jpg" : leftProduct.Hinh));

            <div class="ad-banner-container left-ad d-none d-xxl-block">
                <a asp-controller="HangHoas" asp-action="Details" asp-route-id="@leftProduct.MaHh" class="ad-banner-card text-decoration-none">
                    <div class="ad-badge bg-danger text-white">GỢI Ý CHO BẠN</div>
                    <div class="ad-img-container">
                        <img src="@leftImgUrl" alt="@leftProduct.TenHh" class="ad-product-img">
                    </div>
                    <div class="ad-info p-3 bg-dark text-white rounded-bottom">
                        <h6 class="ad-title mb-1 text-truncate-2">@leftProduct.TenHh</h6>
                        <div class="d-flex flex-column align-items-center gap-1 mt-2 mb-1">
                            @if (leftProduct.GiamGia > 0)
                            {
                                <span class="text-muted text-decoration-line-through small">$@((leftProduct.DonGia ?? 0).ToString("N0"))</span>
                                <span class="text-primary-color fw-bold">$@leftProduct.GiaSauGiam.ToString("N0")</span>
                            }
                            else
                            {
                                <span class="text-white fw-bold">$@((leftProduct.DonGia ?? 0).ToString("N0"))</span>
                            }
                        </div>
                    </div>
                </a>
            </div>
        }

        @if (rightProduct != null)
        {
            var rightImgUrl = rightProduct.Hinh != null && rightProduct.Hinh.StartsWith("http") 
                ? rightProduct.Hinh 
                : Url.Content("~/img/Hinh/HangHoa/" + (string.IsNullOrEmpty(rightProduct.Hinh) ? "no-image.jpg" : rightProduct.Hinh));

            <div class="ad-banner-container right-ad d-none d-xxl-block">
                <a asp-controller="HangHoas" asp-action="Details" asp-route-id="@rightProduct.MaHh" class="ad-banner-card text-decoration-none">
                    <div class="ad-badge bg-warning text-dark fw-bold">SIÊU GIẢM GIÁ</div>
                    <div class="ad-img-container">
                        <img src="@rightImgUrl" alt="@rightProduct.TenHh" class="ad-product-img">
                    </div>
                    <div class="ad-info p-3 bg-dark text-white rounded-bottom">
                        <h6 class="ad-title mb-1 text-truncate-2">@rightProduct.TenHh</h6>
                        <div class="d-flex flex-column align-items-center gap-1 mt-2 mb-1">
                            @if (rightProduct.GiamGia > 0)
                            {
                                <span class="text-muted text-decoration-line-through small">$@((rightProduct.DonGia ?? 0).ToString("N0"))</span>
                                <span class="text-primary-color fw-bold">$@rightProduct.GiaSauGiam.ToString("N0")</span>
                            }
                            else
                            {
                                <span class="text-white fw-bold">$@((rightProduct.DonGia ?? 0).ToString("N0"))</span>
                            }
                        </div>
                    </div>
                </a>
            </div>
        }
    }

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>