    <script>
        function openCustomerChat(e) {
            if (e) e.preventDefault();
            const bubbleBtn = document.getElementById("chat-bubble-btn");
            const chatWindow = document.getElementById("chat-window");
            if (bubbleBtn && chatWindow) {
                if (chatWindow.style.display === "none" || !chatWindow.classList.contains("animate__fadeInUp")) {
                    bubbleBtn.click();
                }
                document.getElementById("customer-chat-widget").scrollIntoView({ behavior: 'smooth', block: 'end' });
            } else {
                // If bubble doesn't exist on this page, redirect to home page and trigger it (or since we enabled it on all pages, it should exist)
                window.location.href = "/?openChat=true";
            }
        }
    </script>
