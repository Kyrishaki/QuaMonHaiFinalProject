@using Microsoft.AspNetCore.Http
@using LTWEB_QuaMonHai_CuoiKy.Helpers
@using LTWEB_QuaMonHai_CuoiKy.ViewModels
@inject IHttpContextAccessor HttpContextAccessor
@inject LTWEB_QuaMonHai_CuoiKy.Data.Hshop2023Context DbContext

@{
    // Lấy số lượng sản phẩm trong giỏ hàng từ Session
    var cartSession = HttpContextAccessor.HttpContext.Session.Get<List<CartItem>>("MyCart");
    int soLuongGioHang = cartSession != null ? cartSession.Sum(c => c.SoLuong) : 0;

    // Lấy tên hiển thị mới nhất từ Database để tránh lỗi phông chữ từ Cookie cũ
    string displayName = User.Identity?.Name ?? "";
    if (User.Identity?.IsAuthenticated == true) {
        var customerId = User.Claims.SingleOrDefault(c => c.Type == "CustomerID")?.Value;
        if (!string.IsNullOrEmpty(customerId)) {
            var khachHang = DbContext.KhachHangs.FirstOrDefault(kh => kh.MaKh == customerId);
            if (khachHang != null) {
                displayName = khachHang.HoTen;
            }
        }
    }
}

<div class="container-fluid custom-sticky px-0">
    <div class="top-bar row gx-0 align-items-center d-none d-lg-flex border-bottom">
        <div class="col-lg-6 px-5 text-start">
            <small class="text-muted"><i class="fa fa-map-marker-alt text-primary me-2"></i>Thành phố Biên Hòa, Đồng Nai</small>
            <small class="text-muted ms-4"><i class="fa fa-envelope text-primary me-2"></i>quamonhai@gmail.com</small>
        </div>
        <div class="col-lg-6 px-5 text-end">
            <small class="text-muted">Theo dõi chúng tôi:</small>
            <a class="text-body ms-3" href="#"><i class="fab fa-facebook-f"></i></a>
            <a class="text-body ms-3" href="#"><i class="fab fa-x-twitter"></i></a>
            <a class="text-body ms-3" href="#"><i class="fab fa-linkedin-in"></i></a>
            <a class="text-body ms-3" href="#"><i class="fab fa-instagram"></i></a>
        </div>
    </div>

    <nav class="navbar navbar-expand-lg navbar-light py-lg-0 px-lg-5 shadow-sm">
        <a asp-controller="Home" asp-action="Index" class="navbar-brand ms-4 ms-lg-0">
            <h1 class="fw-bold m-0 text-primary" style="font-family: 'Lora', serif;">QuaMon<span class="text-secondary" style="font-style: italic;">Hai</span></h1>
        </a>
        <button type="button" class="navbar-toggler me-4" data-bs-toggle="collapse" data-bs-target="#navbarCollapse">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarCollapse">
            <div class="navbar-nav ms-auto p-4 p-lg-0">
                <a asp-controller="Home" asp-action="Index" class="nav-item nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active text-primary" : "")">Trang chủ</a>
                <a asp-controller="Home" asp-action="Privacy" class="nav-item nav-link">Bảo mật</a>
                <div class="nav-item dropdown">
                    <a href="#" class="nav-link dropdown-toggle" data-bs-toggle="dropdown">Trang tin</a>
                    <div class="dropdown-menu m-0 rounded-0">
                        <a href="#" class="dropdown-item">Bài viết</a>
                        <a asp-controller="Home" asp-action="VeChungToi" class="dropdown-item">Về chúng tôi</a>
                    </div>
                </div>
                <a asp-controller="Cart" asp-action="LookupOrder" class="nav-item nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "LookupOrder" ? "active text-primary" : "")">Tra cứu đơn hàng</a>
                <a href="#" class="nav-item nav-link">Liên hệ</a>
            </div>

            <div class="d-none d-lg-flex ms-2 align-items-center">
                <a class="btn-sm-square bg-white rounded-circle ms-3 shadow-sm border text-decoration-none d-flex align-items-center justify-content-center" href="#" data-bs-toggle="modal" data-bs-target="#searchModal">
                    <i class="fa fa-search text-primary"></i>
                </a>

                <div class="nav-item dropdown ms-3">
                    <a href="#" class="nav-link dropdown-toggle d-flex align-items-center gap-2 bg-white rounded-pill px-3 py-1 shadow-sm border" data-bs-toggle="dropdown">
                        <div class="bg-primary rounded-circle d-flex align-items-center justify-content-center" style="width: 30px; height: 30px;">
                            <i class="fa fa-user text-white" style="font-size: 0.8rem;"></i>
                        </div>
                        @if (User.Identity.IsAuthenticated) {
                            <span class="fw-bold text-dark" style="font-size: 0.85rem;">@displayName</span>
                        }
                    </a>
                    <div class="dropdown-menu dropdown-menu-end mt-2 shadow border-0 rounded-3">
                        @if (User.Identity.IsAuthenticated) {
                            <a asp-controller="Customer" asp-action="Profile" class="dropdown-item py-2">
                                <i class="fa fa-id-card me-2 text-info"></i>Hồ sơ cá nhân
                            </a>
                            <a asp-controller="Cart" asp-action="OrderHistory" class="dropdown-item py-2">
                                <i class="fa fa-clock-rotate-left me-2 text-success"></i>Lịch sử mua hàng
                            </a>
                            <a asp-controller="Customer" asp-action="Wishlist" class="dropdown-item py-2">
                                <i class="fa fa-heart me-2 text-danger"></i>Sản phẩm yêu thích
                            </a>
                            @if (User.IsInRole("Admin")) {
                                <a asp-controller="HangHoas" asp-action="Index" class="dropdown-item py-2">
                                    <i class="fa fa-cogs me-2 text-warning"></i>Quản lý sản phẩm
                                </a>
                                <a asp-controller="Admin" asp-action="UserManagement" class="dropdown-item py-2">
                                    <i class="fa fa-users me-2 text-primary"></i>Quản lý người dùng
                                </a>
                                <a asp-controller="Admin" asp-action="OrderHistory" class="dropdown-item py-2">
                                    <i class="fa fa-history me-2 text-info"></i>Quản lý đơn hàng
                                </a>
                                <a asp-controller="Admin" asp-action="ReviewManagement" class="dropdown-item py-2">
                                    <i class="fa fa-comments me-2 text-secondary"></i>Quản lý đánh giá
                                </a>
                            }
                            <div class="dropdown-divider"></div>
                            <a asp-controller="Customer" asp-action="Logout" class="dropdown-item py-2 text-danger">
                                <i class="fa fa-sign-out-alt me-2"></i>Đăng xuất
                            </a>
                        }
                        else {
                            <a asp-controller="Customer" asp-action="Login" class="dropdown-item py-2">Đăng nhập</a>
                            <a asp-controller="Customer" asp-action="Register" class="dropdown-item py-2">Đăng ký</a>
                        }
                    </div>
                </div>

                <a class="btn-sm-square bg-white rounded-circle ms-3 shadow-sm border text-decoration-none d-flex align-items-center justify-content-center position-relative" asp-controller="Cart" asp-action="Index">
                    <i class="fa fa-shopping-bag text-primary"></i>

                    @if (soLuongGioHang > 0) {
                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size: 0.65rem;">
                            @soLuongGioHang
                        </span>
                    }
                </a>
            </div>
        </div>
    </nav>
</div>

<div class="modal fade" id="searchModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-fullscreen">
        <div class="modal-content" style="background: rgba(255, 255, 255, 0.9);">
            <div class="modal-header border-0">
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body d-flex align-items-center justify-content-center">
                <form asp-controller="Home" asp-action="Index" method="get" class="input-group" style="max-width: 600px;">
                    <input type="text" name="searchQuery" class="form-control bg-transparent border-primary p-3" placeholder="Tìm sản phẩm...">
                    <button type="submit" class="btn btn-primary px-4"><i class="fa fa-search"></i></button>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    /* ... (Phần CSS cũ giữ nguyên) ... */
    .custom-sticky {
        position: fixed !important;
        top: 0 !important;
        left: 0;
        right: 0;
        width: 100% !important;
        z-index: 2000 !important;
        background-color: #ffffff !important;
        display: block !important;
        visibility: visible !important;
        transition: all 0.3s ease;
    }

    body {
        padding-top: 20px !important;
    }

    /* Fix layout overlap: Push main content down ONLY on pages without a header carousel/banner */
    #searchModal ~ main.no-header {
        padding-top: 140px;
    }

    @@media (max-width: 991.98px) {
        #searchModal ~ main.no-header {
            padding-top: 85px;
        }
    }

    /* Pages WITH header carousel already have their own top margins, so main shouldn't have extra padding-top */
    #searchModal ~ main.has-header {
        padding-top: 0;
    }

    .custom-sticky.scrolled .top-bar {
        display: none !important;
    }

    .sticky-top {
        position: fixed !important;
        top: 0 !important;
    }
</style>

<script>
    // ... (Phần JS phụ trợ giữ nguyên) ...
    window.addEventListener('scroll', function() {
        const navbar = document.querySelector('.custom-sticky');
        if (window.scrollY > 50) { navbar.classList.add('shadow', 'scrolled'); }
        else { navbar.classList.remove('shadow', 'scrolled'); }
    });
</script>