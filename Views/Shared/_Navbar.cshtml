<!-- Navbar Start -->
<div class="container-fluid fixed-top px-0 wow fadeIn" data-wow-delay="0.1s">
    <div class="top-bar row gx-0 align-items-center d-none d-lg-flex">
        <div class="col-lg-6 px-5 text-start">
            <small><i class="fa fa-map-marker-alt me-2"></i>Thành phố Biên Hòa, Đồng Nai</small>
            <small class="ms-4"><i class="fa fa-envelope me-2"></i>QuaMonHai@Gmail.com.vn</small>
        </div>
        <div class="col-lg-6 px-5 text-end">
            <small>Theo dõi chúng tôi:</small>
            <a class="text-body ms-3" href="#"><i class="fab fa-facebook-f"></i></a>
            <a class="text-body ms-3" href="#"><i class="fab fa-twitter-x"></i></a>
            <a class="text-body ms-3" href="#"><i class="fab fa-linkedin-in"></i></a>
            <a class="text-body ms-3" href="#"><i class="fab fa-instagram"></i></a>
        </div>
    </div>

    <nav class="navbar navbar-expand-lg navbar-light py-lg-0 px-lg-5 wow fadeIn" data-wow-delay="0.1s">
        <a asp-controller="Home" asp-action="Index" class="navbar-brand ms-4 ms-lg-0">
            <!-- Nhúng phông chữ nghệ thuật từ Google Fonts -->
            <link href="https://fonts.googleapis.com/css2?family=Great+Vibes&display=swap" rel="stylesheet">

            <!-- Kiểu dáng CSS cho chữ ký -->
            <style>
                .my-signature {
                    font-family: 'Great Vibes', cursive;
                    font-size: 2.5rem; 
                    margin: 0;
                    padding: 10px;
                    display: inline-block;
                    text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.15); /* Chỉnh lại bóng đổ nhẹ hơn cho hợp với chữ nhỏ */
                    transform: rotate(-3deg);
                }

                .sig-green {
                    color: #2E7D32;
                }

                .sig-orange {
                    color: #FF8C00;
                }
            </style>

            <!-- Nội dung chữ ký -->
            <h1 class="my-signature">
                <span class="sig-green">Qu</span><span class="sig-orange">a</span><span class="sig-green">M</span><span class="sig-orange">o</span><span class="sig-green">nH</span><span class="sig-orange">a</span><span class="sig-green">i</span>
            </h1>
        </a>
        <button type="button" class="navbar-toggler me-4" data-bs-toggle="collapse" data-bs-target="#navbarCollapse">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarCollapse">
            <div class="navbar-nav ms-auto p-4 p-lg-0">
                <a asp-controller="Home" asp-action="Home" class="nav-item nav-link active">Trang chủ</a>
                <a asp-controller="Home" asp-action="Index" class="nav-item nav-link">Cửa hàng</a>
                <a asp-controller="Home" asp-action="Privacy" class="nav-item nav-link">Bảo mật</a>
                <div class="nav-item dropdown">
                    <a href="#" class="nav-link dropdown-toggle" data-bs-toggle="dropdown">Trang thông tin</a>
                    <div class="dropdown-menu m-0">
                        <a href="#" class="dropdown-item">Bài viết (Blog)</a>
                        <a href="#" class="dropdown-item">Về chúng tôi</a>
                    </div>
                </div>
                <a href="#" class="nav-item nav-link">Liên hệ</a>
            </div>
            <div class="d-none d-lg-flex ms-2 align-items-center">
                <a class="btn-sm-square bg-white rounded-circle ms-3" href="#">
                    <small class="fa fa-search text-body"></small>
                </a>

                <!-- BẮT ĐẦU: KHU VỰC TÀI KHOẢN -->
                <div class="nav-item dropdown ms-3">
                    <a href="#" class="nav-link dropdown-toggle d-flex align-items-center gap-2" data-bs-toggle="dropdown" style="padding: 0.5rem 1rem;">
                        <i class="fa fa-user text-body fs-5"></i>
                        @if (User.Identity.IsAuthenticated) {
                            // Hiển thị tên người dùng nếu đã đăng nhập
                            <span class="fw-bold text-primary">@User.Identity.Name</span>
                        }
                    </a>
                    <div class="dropdown-menu dropdown-menu-end m-0 shadow-sm border-0">
                        @if (User.Identity.IsAuthenticated) {
                            <a asp-controller="KhachHang" asp-action="Profile" class="dropdown-item"><i class="fa fa-id-card me-2 text-info"></i>Hồ sơ của tôi</a>

                            // Nếu là Admin, có thể thêm link vào trang quản trị riêng
                            @if (User.IsInRole("Admin")) {
                                <a asp-controller="HangHoas" asp-action="Index" class="dropdown-item"><i class="fa fa-cogs me-2 text-warning"></i>Quản lý sản phẩm</a>
                            }

                            <hr class="dropdown-divider">
                            <a asp-controller="KhachHang" asp-action="DangXuat" class="dropdown-item text-danger"><i class="fa fa-sign-out-alt me-2"></i>Đăng xuất</a>
                        }
                        else {
                            <a asp-controller="KhachHang" asp-action="DangNhap" class="dropdown-item"><i class="fa fa-sign-in-alt me-2 text-primary"></i>Đăng nhập</a>
                            <a asp-controller="KhachHang" asp-action="DangKy" class="dropdown-item"><i class="fa fa-user-plus me-2 text-primary"></i>Đăng ký tài khoản</a>
                        }
                    </div>
                </div>
                <!-- KẾT THÚC: KHU VỰC TÀI KHOẢN -->

                <a class="btn-sm-square bg-white rounded-circle ms-3" href="~/Cart/Index">
                    <small class="fa fa-shopping-bag text-body"></small>
                </a>
            </div>
        </div>
    </nav>
</div>
<!-- Navbar End -->