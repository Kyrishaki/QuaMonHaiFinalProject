@using Microsoft.AspNetCore.Http
@using LTWEB_QuaMonHai_CuoiKy.Helpers
@using LTWEB_QuaMonHai_CuoiKy.ViewModels
@inject IHttpContextAccessor HttpContextAccessor
@inject LTWEB_QuaMonHai_CuoiKy.Data.Hshop2023Context DbContext

@{
    // Lấy số lượng sản phẩm trong giỏ hàng từ Session
    var cartSession = HttpContextAccessor.HttpContext.Session.Get<List<CartItem>>("MyCart");
    int soLuongGioHang = cartSession != null ? cartSession.Sum(c => c.SoLuong) : 0;

    // Lấy tên hiển thị mới nhất từ Database để tránh lỗi phông chữ từ Cookie cũ
    string displayName = User.Identity?.Name ?? "";
    LTWEB_QuaMonHai_CuoiKy.Models.KhachHang khachHang = null;
    if (User.Identity?.IsAuthenticated == true) {
        var customerId = User.Claims.SingleOrDefault(c => c.Type == "CustomerID")?.Value;
        if (!string.IsNullOrEmpty(customerId)) {
            khachHang = DbContext.KhachHangs.FirstOrDefault(kh => kh.MaKh == customerId);
            if (khachHang != null) {
                displayName = khachHang.HoTen;
            }
        }
    }

    var avatarUrl = "";
    if (User.Identity?.IsAuthenticated == true) {
        // 1. Nếu có tag nhận diện API
        if (khachHang != null && khachHang.Hinh != null && khachHang.Hinh.StartsWith("[API]:"))
        {
            string userName = khachHang.Hinh.Replace("[API]:", "");
            avatarUrl = Url.Content($"~/api/Avatar/generate?name={Uri.EscapeDataString(userName)}");
        }
        // 2. Nếu có ảnh thật tự upload (loại trừ các chuỗi mặc định)
        else if (khachHang != null && !string.IsNullOrEmpty(khachHang.Hinh) && khachHang.Hinh != "default-avatar.jpg" && khachHang.Hinh != "avatar.jpg")
        {
            avatarUrl = Url.Content("~/img/Hinh/KhachHang/" + khachHang.Hinh);
        }
        // 3. ÉP BUỘC: Quay về gọi API vẽ chữ
        else
        {
            avatarUrl = Url.Content($"~/api/Avatar/generate?name={Uri.EscapeDataString(khachHang?.HoTen ?? "User")}");
        }
    }
}

<div class="container-fluid custom-sticky px-0" data-inspect-id="navbar">
    <div class="top-bar row gx-0 align-items-center d-none d-lg-flex border-bottom">
        <div class="col-lg-6 px-5 text-start">
            <small class="text-muted"><i class="fa fa-map-marker-alt text-primary me-2"></i>Thành phố Biên Hòa, Đồng Nai</small>
            <small class="text-muted ms-4"><i class="fa fa-envelope text-primary me-2"></i>quamonhai@gmail.com</small>
        </div>
        <div class="col-lg-6 px-5 text-end">
            <small class="text-muted">Theo dõi chúng tôi:</small>
            <a class="text-body ms-3" asp-controller="Social" asp-action="Facebook" target="_blank"><i class="fab fa-facebook-f"></i></a>
            <a class="text-body ms-3" asp-controller="Social" asp-action="X" target="_blank"><i class="fab fa-x-twitter"></i></a>
            <a class="text-body ms-3" asp-controller="Social" asp-action="LinkedIn" target="_blank"><i class="fab fa-linkedin-in"></i></a>
            <a class="text-body ms-3" asp-controller="Social" asp-action="Instagram" target="_blank"><i class="fab fa-instagram"></i></a>
        </div>
    </div>

    <nav class="navbar navbar-expand-lg navbar-light py-lg-0 px-lg-5 shadow-sm">
        <a asp-controller="Home" asp-action="Index" class="navbar-brand ms-4 ms-lg-0" data-inspect-id="navbar-brand">
            <h1 class="fw-bold m-0 text-primary" style="font-family: 'Lora', serif;">QuaMon<span class="text-secondary" style="font-style: italic;">Hai</span></h1>
        </a>
        <button type="button" class="navbar-toggler me-4" data-bs-toggle="collapse" data-bs-target="#navbarCollapse">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarCollapse">
            <div class="navbar-nav ms-auto p-4 p-lg-0" data-inspect-id="navbar-links">
                <a asp-controller="Home" asp-action="Index" class="nav-item nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active text-primary" : "")">Trang chủ</a>
                <div class="nav-item dropdown">
                    <a href="#" class="nav-link dropdown-toggle" data-bs-toggle="dropdown">Trang tin</a>
                    <div class="dropdown-menu m-0 rounded-0">
                        <a asp-controller="Home" asp-action="Blog" class="dropdown-item">Bài viết</a>
                        <a asp-controller="Home" asp-action="AboutUs" class="dropdown-item">Về chúng tôi</a>
                    </div>
                </div>
                <a asp-controller="Cart" asp-action="LookupOrder" class="nav-item nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "LookupOrder" ? "active text-primary" : "")">Tra cứu đơn hàng</a>
            </div>

            <div class="d-none d-lg-flex ms-2 align-items-center">
                <a class="btn-sm-square bg-white rounded-circle ms-3 shadow-sm border text-decoration-none d-flex align-items-center justify-content-center" href="#" data-bs-toggle="modal" data-bs-target="#searchModal">
                    <i class="fa fa-search text-primary"></i>
                </a>

                <div class="nav-item dropdown ms-3" data-inspect-id="navbar-user">
                    <a href="#" class="nav-link dropdown-toggle d-flex align-items-center gap-2 bg-white rounded-pill px-3 py-1 shadow-sm border" data-bs-toggle="dropdown">
                        <div class="bg-primary rounded-circle d-flex align-items-center justify-content-center position-relative overflow-hidden" style="width: 30px; height: 30px;">
                            @if (User.Identity?.IsAuthenticated == true) {
                                <img src="@avatarUrl" 
                                     alt="Avatar" 
                                     class="w-100 h-100 object-fit-cover"
                                     onerror="this.src='/api/Avatar/generate?name=@(Uri.EscapeDataString(khachHang?.HoTen ?? "User"))';"
                                     style="object-fit: cover;" />
                            } else {
                                <i class="fa fa-user text-white" style="font-size: 0.8rem;"></i>
                            }
                            @if (User.IsInRole("Admin") || User.IsInRole("Staff")) {
                                <span id="admin-chat-global-badge" class="position-absolute top-0 start-100 translate-middle p-1 bg-danger border border-light rounded-circle d-none animate__animated animate__heartBeat animate__infinite" style="width: 10px; height: 10px; background-color: #ff5722 !important;"></span>
                            }
                        </div>
                        @if (User.Identity.IsAuthenticated) {
                            <span class="fw-bold text-dark" style="font-size: 0.85rem;">@displayName</span>
                        }
                    </a>
                    <div class="dropdown-menu dropdown-menu-end mt-2 shadow border-0 rounded-3" style="min-width: 220px;">
                        @if (User.Identity.IsAuthenticated) {
                            <h6 class="dropdown-header text-uppercase fw-bold text-muted ps-3 py-2" style="font-size: 0.7rem; letter-spacing: 1px;">Khách Hàng</h6>
                            <a asp-controller="Customer" asp-action="Profile" class="dropdown-item py-2 ps-3">
                                <i class="fa fa-id-card me-2 text-info" style="width: 20px;"></i>Hồ sơ cá nhân
                            </a>
                            <a asp-controller="Cart" asp-action="OrderHistory" class="dropdown-item py-2 ps-3">
                                <i class="fa fa-clock-rotate-left me-2 text-success" style="width: 20px;"></i>Lịch sử mua hàng
                            </a>
                            <a asp-controller="Customer" asp-action="Wishlist" class="dropdown-item py-2 ps-3">
                                <i class="fa fa-heart me-2 text-danger" style="width: 20px;"></i>Sản phẩm yêu thích
                            </a>
                            @if (User.IsInRole("Admin") || User.IsInRole("Staff")) {
                                <div class="dropdown-divider"></div>
                                <h6 class="dropdown-header text-uppercase fw-bold text-warning ps-3 py-2" style="font-size: 0.7rem; letter-spacing: 1px;">
                                    @(User.IsInRole("Admin") ? "Quản Trị Viên (Admin)" : "Nhân viên (Staff)")
                                </h6>
                                <a asp-controller="HangHoas" asp-action="Index" class="dropdown-item py-2 ps-3">
                                    <i class="fa fa-cogs me-2 text-warning" style="width: 20px;"></i>Quản lý sản phẩm
                                </a>
                                <a asp-controller="Admin" asp-action="UserManagement" class="dropdown-item py-2 ps-3">
                                    <i class="fa fa-users me-2 text-primary" style="width: 20px;"></i>Quản lý người dùng
                                </a>
                                <a asp-controller="Admin" asp-action="OrderHistory" class="dropdown-item py-2 ps-3">
                                    <i class="fa fa-history me-2 text-info" style="width: 20px;"></i>Quản lý đơn hàng
                                </a>
                                <a asp-controller="Admin" asp-action="ReviewManagement" class="dropdown-item py-2 ps-3">
                                    <i class="fa fa-comments me-2 text-secondary" style="width: 20px;"></i>Quản lý đánh giá
                                </a>
                                <a asp-controller="Admin" asp-action="ChatDashboard" class="dropdown-item py-2 ps-3 d-flex align-items-center justify-content-between">
                                    <span><i class="fa-solid fa-headset me-2 text-warning" style="width: 20px;"></i>Quản lý hỗ trợ</span>
                                    <span id="admin-chat-menu-badge" class="badge bg-danger rounded-pill d-none animate__animated animate__pulse animate__infinite" style="font-size: 0.7rem; background-color: #ff5722 !important;">0</span>
                                </a>
                            }
                            <div class="dropdown-divider"></div>
                            <a asp-controller="Customer" asp-action="Logout" class="dropdown-item py-2 ps-3 text-danger">
                                <i class="fa fa-sign-out-alt me-2" style="width: 20px;"></i>Đăng xuất
                            </a>
                        }
                        else {
                            <a asp-controller="Customer" asp-action="Login" class="dropdown-item py-2">Đăng nhập</a>
                            <a asp-controller="Customer" asp-action="Register" class="dropdown-item py-2">Đăng ký</a>
                        }
                    </div>
                </div>

                <a class="btn-sm-square bg-white rounded-circle ms-3 shadow-sm border text-decoration-none d-flex align-items-center justify-content-center position-relative" asp-controller="Cart" asp-action="Index" data-inspect-id="navbar-cart">
                    <i class="fa fa-shopping-bag text-primary"></i>

                    @if (soLuongGioHang > 0) {
                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size: 0.65rem;">
                            @soLuongGioHang
                        </span>
                    }
                </a>
            </div>
        </div>
    </nav>
</div>

<div class="modal fade" id="searchModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-fullscreen">
        <div class="modal-content" style="background: rgba(255, 255, 255, 0.9);">
            <div class="modal-header border-0">
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body d-flex align-items-center justify-content-center">
                <form asp-controller="Home" asp-action="Index" method="get" class="input-group" style="max-width: 600px;" data-inspect-id="search-product">
                    <input type="text" name="searchQuery" class="form-control bg-transparent border-primary p-3" placeholder="Tìm sản phẩm...">
                    <button type="submit" class="btn btn-primary px-4"><i class="fa fa-search"></i></button>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    /* ... (Phần CSS cũ giữ nguyên) ... */
    .custom-sticky {
        position: fixed !important;
        top: 0 !important;
        left: 0;
        right: 0;
        width: 100% !important;
        z-index: 2000 !important;
        background-color: #ffffff !important;
        display: block !important;
        visibility: visible !important;
        transition: all 0.3s ease;
    }

    body {
        padding-top: 20px !important;
    }

    /* Fix layout overlap: Push main content down ONLY on pages without a header carousel/banner */
    #searchModal ~ main.no-header {
        padding-top: 140px;
    }

    @@media (max-width: 991.98px) {
        #searchModal ~ main.no-header {
            padding-top: 85px;
        }
    }

    /* Pages WITH header carousel already have their own top margins, so main shouldn't have extra padding-top */
    #searchModal ~ main.has-header {
        padding-top: 0;
    }

    .custom-sticky.scrolled .top-bar {
        display: none !important;
    }

    .sticky-top {
        position: fixed !important;
        top: 0 !important;
    }
</style>

<script>
    // ... (Phần JS phụ trợ giữ nguyên) ...
    window.addEventListener('scroll', function() {
        const navbar = document.querySelector('.custom-sticky');
        if (window.scrollY > 50) { navbar.classList.add('shadow', 'scrolled'); }
        else { navbar.classList.remove('shadow', 'scrolled'); }
    });
</script>

@if (User.Identity?.IsAuthenticated == true && (User.IsInRole("Admin") || User.IsInRole("Staff"))) {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            let lastUnreadCount = 0;
            const globalBadge = document.getElementById("admin-chat-global-badge");
            const menuBadge = document.getElementById("admin-chat-menu-badge");

            function checkAdminUnreadMessages() {
                const isDashboard = window.location.pathname.toLowerCase().includes("/admin/chatdashboard");

                $.ajax({
                    url: '/Admin/GetTotalUnreadCount',
                    type: 'GET',
                    success: function (res) {
                        const count = res.count;

                        if (count > 0) {
                            if (globalBadge) globalBadge.classList.remove("d-none");
                            if (menuBadge) {
                                menuBadge.innerText = count + " tin mới";
                                menuBadge.classList.remove("d-none");
                            }

                            if (count > lastUnreadCount && !isDashboard) {
                                showSupportToast("Có tin nhắn hỗ trợ mới! Bạn có " + count + " cuộc trò chuyện đang chờ.");
                            }
                        } else {
                            if (globalBadge) globalBadge.classList.add("d-none");
                            if (menuBadge) {
                                menuBadge.innerText = "0";
                                menuBadge.classList.add("d-none");
                            }
                        }

                        lastUnreadCount = count;
                    },
                    error: function (err) {
                        console.error("Lỗi kiểm tra tin nhắn hỗ trợ", err);
                    }
                });
            }

            function showSupportToast(message) {
                $('#supportToastAlert').remove();
                const toastHtml = '<div id="supportToastAlert" class="position-fixed bottom-0 start-0 p-3" style="z-index: 99999;">' +
                                  '<div class="toast align-items-center text-white bg-warning border-0 show" role="alert" aria-live="assertive" aria-atomic="true" style="background: linear-gradient(135deg, #ffb229 0%, #ff5722 100%) !important;">' +
                                  '<div class="d-flex">' +
                                  '<div class="toast-body fw-bold">' +
                                  '<i class="fa fa-bell me-2 animate__animated animate__swing animate__infinite"></i>' + message +
                                  '</div>' +
                                  '<button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close" onclick="$(this).closest(\'#supportToastAlert\').remove();"></button>' +
                                  '</div></div></div>';
                $('body').append(toastHtml);
                setTimeout(function() {
                    $('#supportToastAlert').fadeOut(500, function() { $(this).remove(); });
                }, 5000);
            }

            checkAdminUnreadMessages();
            setInterval(checkAdminUnreadMessages, 10000);
        });
    </script>
}