@model IEnumerable<LTWEB_QuaMonHai_CuoiKy.Models.ApiProduct>

@{
    ViewData["Title"] = "Sản phẩm từ DummyJSON";
}

<div class="container py-5">
    <h2 class="mb-4 text-center">Sản phẩm Quốc tế (DummyJSON API)</h2>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }

    <div class="row g-4">
        @foreach (var item in Model)
        {
            <div class="col-xl-3 col-lg-4 col-md-6">
                <div class="card h-100 shadow-sm">
                    <img src="@item.thumbnail" class="card-img-top" alt="@item.title" style="height: 200px; object-fit: contain; background: #f8f9fa; padding: 10px;">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title text-truncate" title="@item.title">@item.title</h5>
                        <p class="text-muted small mb-2">@item.brand | @item.category</p>
                        <div class="mt-auto">
                            <h5 class="text-primary fw-bold">$@item.price</h5>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>