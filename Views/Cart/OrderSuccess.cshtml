@model LTWEB_QuaMonHai_CuoiKy.Models.HoaDon
@{
    ViewData["Title"] = "Đặt hàng thành công";
}

<div class="container my-5 py-3">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <!-- Header Card with primary color background -->
                <div class="p-5 text-center text-white" style="background: linear-gradient(135deg, #3CB815 0%, #2f9410 100%);">
                    <div class="mb-4 d-inline-flex align-items-center justify-content-center bg-white rounded-circle shadow-sm" style="width: 80px; height: 80px;">
                        <i class="fa fa-check text-success fs-1 animate__animated animate__zoomIn"></i>
                    </div>
                    <h2 class="fw-bold mb-2">Đặt Hàng Thành Công!</h2>
                    <p class="mb-0 opacity-90">Cảm ơn bạn đã tin tưởng mua sắm tại QuaMonHai</p>
                </div>

                <div class="card-body p-4 p-md-5 bg-white">
                    <p class="text-center text-muted mb-4">
                        Hệ thống đã nhận được đơn hàng của bạn. Chúng tôi sẽ liên hệ để xác nhận và giao hàng trong thời gian sớm nhất.
                    </p>

                    @if (Model != null)
                    {
                        <!-- Order Summary Card -->
                        <div class="card bg-light border-0 rounded-3 mb-4">
                            <div class="card-body p-4">
                                <h5 class="fw-bold mb-3 text-dark border-bottom pb-2">
                                    <i class="fa-solid fa-file-invoice text-success me-2"></i>Thông tin đơn hàng
                                </h5>
                                
                                <div class="d-flex justify-content-between mb-2">
                                    <span class="text-muted">Mã đơn hàng:</span>
                                    <span class="fw-bold text-dark">#@Model.MaHd</span>
                                </div>
                                <div class="d-flex justify-content-between mb-2">
                                    <span class="text-muted">Người nhận:</span>
                                    <span class="fw-semibold text-dark">@Model.HoTen</span>
                                </div>
                                @if (Model.SoDienThoai.HasValue)
                                {
                                    <div class="d-flex justify-content-between mb-2">
                                        <span class="text-muted">Số điện thoại:</span>
                                        <span class="text-dark">0@Model.SoDienThoai</span>
                                    </div>
                                }
                                <div class="d-flex justify-content-between mb-2">
                                    <span class="text-muted">Phương thức thanh toán:</span>
                                    <span class="text-dark">
                                        @(Model.CachThanhToan == "cod" ? "Thanh toán khi nhận hàng (COD)" : Model.CachThanhToan)
                                    </span>
                                </div>
                                <div class="d-flex justify-content-between">
                                    <span class="text-muted">Địa chỉ nhận:</span>
                                    <span class="text-dark text-end ms-3" style="max-width: 60%;">@Model.DiaChi</span>
                                </div>
                            </div>
                        </div>

                        <!-- Product details -->
                        <div class="card border-0 shadow-sm rounded-3 mb-4 overflow-hidden">
                            <div class="card-header bg-light border-0 py-3">
                                <h5 class="mb-0 fw-bold text-dark">
                                    <i class="fa-solid fa-box text-success me-2"></i>Sản phẩm đã mua
                                </h5>
                            </div>
                            <div class="list-group list-group-flush">
                                @foreach (var cthd in Model.ChiTietHds)
                                {
                                    <div class="list-group-item p-3 border-light">
                                        <div class="row align-items-center g-3">
                                            <div class="col-auto">
                                                <img src="~/img/Hinh/HangHoa/@cthd.MaHhNavigation.Hinh" 
                                                     alt="@cthd.MaHhNavigation.TenHh" 
                                                     class="img-fluid rounded border shadow-sm" 
                                                     style="width: 60px; height: 60px; object-fit: cover;" />
                                            </div>
                                            <div class="col">
                                                <h6 class="mb-1 fw-bold text-dark text-truncate" style="max-width: 250px;">@cthd.MaHhNavigation.TenHh</h6>
                                                <small class="text-muted">Số lượng: @cthd.SoLuong</small>
                                            </div>
                                            <div class="col-auto text-end">
                                                <span class="fw-semibold text-dark">@((cthd.DonGia * cthd.SoLuong).ToString("N0"))₫</span>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                            <div class="card-footer bg-light border-0 p-4">
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="text-muted fw-semibold">Tổng thanh toán (gồm vận chuyển):</span>
                                    <span class="fs-4 fw-bold text-success">@((Model.ChiTietHds.Sum(c => c.DonGia * c.SoLuong) + Model.PhiVanChuyen - Model.ChiTietHds.Sum(c => c.GiamGia)).ToString("N0"))₫</span>
                                </div>
                            </div>
                        </div>
                    }

                    <!-- Navigation Action Buttons -->
                    <div class="d-flex flex-column flex-sm-row gap-3 justify-content-center mt-4">
                        <a href="/Cart/OrderHistory" class="btn btn-outline-success px-4 py-2 rounded-pill fw-bold w-100 w-sm-auto transition">
                            <i class="fa-solid fa-clock-rotate-left me-2"></i>Lịch sử đơn hàng
                        </a>
                        <a href="/" class="btn btn-success px-4 py-2 rounded-pill fw-bold w-100 w-sm-auto text-white shadow-sm transition" style="background-color: #3CB815; border-color: #3CB815;">
                            <i class="fa-solid fa-bag-shopping me-2"></i>Tiếp tục mua sắm
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
