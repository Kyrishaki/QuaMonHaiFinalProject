@model IEnumerable<LTWEB_QuaMonHai_CuoiKy.ViewModels.CartItem>
@{
    ViewData["Title"] = "Thanh Toán";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Thanh Toán - Qua Môn Nhóm</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        body {
            background-color: #f5f5f5;
        }

        .text-quamon {
            color: #198754;
        }

        .bg-quamon {
            background-color: #198754;
            color: white;
        }

        /* Custom Radio cho Phương thức vận chuyển */
        .shipping-label {
            cursor: pointer;
            transition: all 0.2s;
        }

        .shipping-radio:checked + .shipping-label {
            border-color: #198754 !important;
            background-color: #f8fff9;
        }
    </style>
</head>
<body>
    <header class="bg-white border-bottom py-3 mb-4 shadow-sm">
        <div class="container d-flex align-items-center">
            <a href="/" class="text-quamon fs-4 fw-bold text-decoration-none d-flex align-items-center gap-2">
                <i class="fa-solid fa-bag-shopping"></i> Qua Môn Nhóm
            </a>
            <span class="fs-5 border-start ms-3 ps-3 text-secondary">Thanh Toán</span>
        </div>
    </header>

    <main class="container">
        <form asp-action="PlaceOrder" asp-controller="Cart" method="POST" data-inspect-id="checkout-form">

            <input type="hidden" name="HoTen" id="hiddenHoTen" value="" />
            <input type="hidden" name="DiaChi" id="hiddenDiaChi" value="" />
            <input type="hidden" name="SoDienThoai" id="hiddenSoDienThoai" value="" />
            <input type="hidden" name="MaGg" id="selectedMaGg" value="" />

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger mb-3">
                    <i class="fa-solid fa-circle-exclamation me-2"></i> @TempData["Error"]
                </div>
            }

            <div class="card shadow-sm mb-3 border-0" data-inspect-id="checkout-address">
                <div class="card-body">
                    <h5 class="card-title text-quamon mb-3"><i class="fa-solid fa-location-dot me-2"></i>Địa Chỉ Nhận Hàng</h5>

                    <div id="selectedAddressInfo" class="d-none alert alert-light border mb-3">
                        <p class="fw-bold mb-1" id="addrName"></p>
                        <p class="text-muted mb-0 small" id="addrDetail"></p>
                    </div>

                    <button type="button" class="btn btn-outline-primary btn-sm" onclick="openAddressModal()">
                        <i class="fa-solid fa-plus me-1"></i> Thêm địa chỉ
                    </button>
                </div>
            </div>

            <div class="card shadow-sm mb-3 border-0 overflow-hidden" data-inspect-id="checkout-products-list">
                <div class="row g-0 bg-light border-bottom py-2 px-3 fw-bold text-secondary small text-center">
                    <div class="col-6 text-start">Sản phẩm</div>
                    <div class="col-2">Đơn giá</div>
                    <div class="col-2">Số lượng</div>
                    <div class="col-2 text-end">Thành tiền</div>
                </div>

                <div class="card-body p-0">
                    @if (Model != null)
                    {
                        foreach (var item in Model)
                        {
                            <input type="hidden" name="selectedIds" value="@item.MaHh" />
                            <div class="row g-0 align-items-center py-3 px-3 border-bottom text-center">
                                <div class="col-6 d-flex align-items-center text-start gap-3">
                                    <img src="~/img/Hinh/HangHoa/@item.Hinh" alt="@item.TenHh" class="border" style="width: 50px; height: 50px; object-fit: cover;">
                                    <span class="small text-truncate" style="max-width: 250px;">@item.TenHh</span>
                                </div>
                                <div class="col-2 small">@item.DonGia.ToString("N0")$</div>
                                <div class="col-2 small">@item.SoLuong</div>
                                <div class="col-2 text-end fw-bold small">@((item.DonGia * item.SoLuong).ToString("N0"))$</div>
                            </div>
                        }
                    }
                </div>
            </div>

            <div class="card shadow-sm mb-3 border-0" data-inspect-id="checkout-notes">
                <div class="card-body">
                    <h6 class="card-title fw-bold text-secondary mb-2">Ghi chú đơn hàng</h6>
                    <textarea name="GhiChu" rows="2" class="form-control" placeholder="Lưu ý cho người bán..."></textarea>
                </div>
            </div>

            <div class="card shadow-sm mb-3 border-0" data-inspect-id="checkout-shipping-methods">
                <div class="card-body">
                    <h6 class="card-title fw-bold text-secondary mb-3">Phương thức vận chuyển</h6>
                    <div class="d-flex flex-column gap-2">

                        <div class="position-relative">
                            <input type="radio" name="shipping_method" value="standard" id="ship_standard" class="shipping-radio d-none" data-price="2" checked onchange="calculateTotal()">
                            <label for="ship_standard" class="shipping-label border rounded p-3 d-flex justify-content-between align-items-center w-100">
                                <div><span class="fw-bold d-block">Giao hàng tiêu chuẩn</span><small class="text-muted">3-5 ngày</small></div>
                                <span class="text-success fw-bold">2$</span>
                            </label>
                        </div>

                        <div class="position-relative">
                            <input type="radio" name="shipping_method" value="express" id="ship_express" class="shipping-radio d-none" data-price="5" onchange="calculateTotal()">
                            <label for="ship_express" class="shipping-label border rounded p-3 d-flex justify-content-between align-items-center w-100">
                                <div><span class="fw-bold d-block">Giao hàng nhanh</span><small class="text-muted">1-2 ngày</small></div>
                                <span class="fw-bold">5$</span>
                            </label>
                        </div>

                    </div>
                </div>
            </div>

            <div class="card shadow-sm mb-3 border-0" data-inspect-id="checkout-vouchers-payment">
                <div class="card-body pb-0 border-bottom mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div class="fs-5"><i class="fa-solid fa-ticket text-quamon me-2"></i>Voucher Qua Môn</div>
                        <div class="d-flex align-items-center gap-2">
                            <span id="selectedVoucherLabel" class="badge bg-success d-none"></span>
                            <button type="button" class="btn btn-outline-primary btn-sm" onclick="voucherModalInstance.show()">Chọn Voucher</button>
                        </div>
                    </div>
                </div>
                <div class="card-body pt-0">
                    <h6 class="fw-bold text-secondary mb-3">Phương thức thanh toán</h6>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="payment_method" value="cod" id="pay_cod" checked>
                        <label class="form-check-label" for="pay_cod">Thanh toán khi nhận hàng</label>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm mb-4 border-primary" data-inspect-id="checkout-totals-summary">
                <div class="card-body">
                    <div class="row justify-content-end">
                        <div class="col-md-5 col-lg-4">

                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted">Tạm tính:</span>
                                <span class="fw-bold" id="display-subtotal" data-value="@((Model?.Sum(x => x.DonGia * x.SoLuong) ?? 0))">
                                    @((Model?.Sum(x => x.DonGia * x.SoLuong) ?? 0).ToString("N0"))$
                                </span>
                            </div>

                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted">Phí vận chuyển:</span>
                                <span class="fw-bold" id="display-shipping">2$</span>
                            </div>

                            <div class="d-flex justify-content-between mb-3 text-success d-none" id="discount-row">
                                <span>Giảm giá (<span id="discount-percent-label">0</span>%):</span>
                                <span class="fw-bold" id="display-discount">-0$</span>
                            </div>

                            <hr />

                            <div class="d-flex justify-content-between align-items-center mb-4">
                                <span class="text-muted fw-bold">Tổng thanh toán:</span>
                                <span class="text-quamon fs-3 fw-bold" id="display-final">
                                    @((Model?.Sum(x => x.DonGia * x.SoLuong) ?? 0).ToString("N0"))$
                                </span>
                            </div>

                            <button type="submit" class="btn bg-quamon w-100 py-2 fs-5">Đặt hàng</button>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </main>

    <div class="modal fade" id="addressModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold text-quamon"><i class="fa-solid fa-address-book me-2"></i>Thêm địa chỉ nhận hàng</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <!-- Khung thông tin tài khoản để bấm dùng nhanh -->
                    @if (ViewBag.Customer != null)
                    {
                        <div class="mb-3 p-3 bg-light border border-success border-opacity-25 rounded-3">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="fw-bold text-success small"><i class="fa-solid fa-circle-user me-1"></i> Sử dụng thông tin tài khoản</span>
                                <button type="button" class="btn btn-success btn-sm py-1 px-2 text-white" onclick="useAccountInfo()">
                                    <i class="fa-solid fa-circle-check me-1"></i> Tự động điền
                                </button>
                            </div>
                            <div class="text-secondary small" style="line-height: 1.6;">
                                <strong>Họ tên:</strong> @ViewBag.Customer.HoTen <br />
                                <strong>Số điện thoại:</strong> @ViewBag.Customer.DienThoai <br />
                                <strong>Địa chỉ đã lưu:</strong> @ViewBag.Customer.DiaChi
                            </div>
                        </div>
                    }

                    <div class="mb-3">
                        <label class="form-label fw-bold small">Họ tên *</label>
                        <input type="text" id="inputHoTen" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold small">Số điện thoại *</label>
                        <input type="text" id="inputDienThoai" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-quamon"><i class="fa-solid fa-map-location-dot me-1"></i> Địa chỉ nhận hàng (Theo địa chỉ Việt Nam) *</label>
                        <div class="row g-2 mb-2">
                            <div class="col-md-4">
                                <select id="inputProvince" class="form-select" onchange="onProvinceChange(this.value)">
                                    <option value="">Chọn Tỉnh/TP</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <select id="inputDistrict" class="form-select" disabled onchange="onDistrictChange(this.value)">
                                    <option value="">Chọn Quận/Huyện</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <select id="inputWard" class="form-select" disabled>
                                    <option value="">Chọn Phường/Xã</option>
                                </select>
                            </div>
                        </div>
                        <input type="text" id="inputStreet" class="form-control" placeholder="Số nhà, tên đường, thôn, xóm..." />
                    </div>
                    <p id="addrError" class="text-danger small d-none">Vui lòng điền đầy đủ thông tin.</p>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="button" onclick="saveAddress()" class="btn btn-success">Xác nhận</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="voucherModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Chọn mã giảm giá</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    @if (ViewBag.Vouchers != null)
                    {
                        foreach (var v in (List<LTWEB_QuaMonHai_CuoiKy.Models.GiamGia>)ViewBag.Vouchers)
                        {
                            <div class="d-flex justify-content-between align-items-center border rounded p-3 mb-2">
                                <div>
                                    <p class="fw-bold mb-0">@v.TenMa</p>
                                    <small class="text-muted">Giảm @v.PhanTramGiam%</small>
                                </div>
                                <button type="button" onclick="applyVoucher(@v.MaGg, '@v.TenMa', @v.PhanTramGiam)" class="btn btn-success btn-sm">Áp dụng</button>
                            </div>
                        }
                    }
                </div>
                <div class="modal-footer bg-light d-flex justify-content-between">
                    <button type="button" onclick="removeVoucher()" class="btn btn-link text-danger text-decoration-none small">✕ Bỏ mã giảm giá</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Thông tin tài khoản khách hàng để tự động điền
        const userHoTen = '@Html.Raw(ViewBag.Customer?.HoTen ?? "")';
        const userDienThoai = '@Html.Raw(ViewBag.Customer?.DienThoai ?? "")';
        const userDiaChi = '@Html.Raw(ViewBag.Customer?.DiaChi ?? "")';

        // 1. CÁC BIẾN TOÀN CỤC ĐỂ LƯU TRẠNG THÁI
        let currentDiscountPercent = 0; // Đang giảm bao nhiêu phần trăm
        let addressModalInstance;
        let voucherModalInstance;

        // Lấy giá trị Tạm tính ban đầu từ HTML (nhớ ép kiểu về số)
        const baseSubTotalElement = document.getElementById('display-subtotal');
        const baseSubTotal = baseSubTotalElement ? parseFloat(baseSubTotalElement.getAttribute('data-value')) : 0;

        document.addEventListener('DOMContentLoaded', function () {
            // Khởi tạo Modal của Bootstrap
            addressModalInstance = new bootstrap.Modal(document.getElementById('addressModal'));
            voucherModalInstance = new bootstrap.Modal(document.getElementById('voucherModal'));

            // GỌI HÀM TÍNH TOÁN NGAY KHI VỪA VÀO TRANG ĐỂ HIỂN THỊ GIÁ TRỊ MẶC ĐỊNH
            calculateTotal();

            // Tải danh mục Tỉnh/TP
            loadProvinces();
        });

        // ==========================================
        // CÁC HÀM TẢI ĐỊA CHỈ HÀNH CHÍNH VIỆT NAM (API)
        // ==========================================
        async function loadProvinces() {
            try {
                const response = await fetch('https://provinces.open-api.vn/api/p/');
                if (!response.ok) throw new Error("HTTP error " + response.status);
                const provinces = await response.json();
                const provinceSelect = document.getElementById('inputProvince');
                provinceSelect.innerHTML = '<option value="">Chọn Tỉnh/TP</option>';
                provinces.forEach(p => {
                    const option = document.createElement('option');
                    option.value = p.code;
                    option.textContent = p.name;
                    provinceSelect.appendChild(option);
                });
            } catch (error) {
                console.error("Failed to load provinces:", error);
            }
        }

        async function onProvinceChange(provinceCode) {
            const districtSelect = document.getElementById('inputDistrict');
            const wardSelect = document.getElementById('inputWard');
            
            districtSelect.innerHTML = '<option value="">Chọn Quận/Huyện</option>';
            districtSelect.disabled = true;
            wardSelect.innerHTML = '<option value="">Chọn Phường/Xã</option>';
            wardSelect.disabled = true;

            if (!provinceCode) return;

            try {
                const response = await fetch(`https://provinces.open-api.vn/api/p/${provinceCode}?depth=2`);
                if (!response.ok) throw new Error("HTTP error " + response.status);
                const data = await response.json();
                
                districtSelect.disabled = false;
                data.districts.forEach(d => {
                    const option = document.createElement('option');
                    option.value = d.code;
                    option.textContent = d.name;
                    districtSelect.appendChild(option);
                });
            } catch (error) {
                console.error("Failed to load districts:", error);
            }
        }

        async function onDistrictChange(districtCode) {
            const wardSelect = document.getElementById('inputWard');
            
            wardSelect.innerHTML = '<option value="">Chọn Phường/Xã</option>';
            wardSelect.disabled = true;

            if (!districtCode) return;

            try {
                const response = await fetch(`https://provinces.open-api.vn/api/d/${districtCode}?depth=2`);
                if (!response.ok) throw new Error("HTTP error " + response.status);
                const data = await response.json();
                
                wardSelect.disabled = false;
                data.wards.forEach(w => {
                    const option = document.createElement('option');
                    option.value = w.code;
                    option.textContent = w.name;
                    wardSelect.appendChild(option);
                });
            } catch (error) {
                console.error("Failed to load wards:", error);
            }
        }

        // ==========================================
        // CÁC HÀM XỬ LÝ TỰ ĐỘNG ĐIỀN THÔNG TIN TÀI KHOẢN
        // ==========================================
        function openAddressModal() {
            // Tự động điền nếu các trường đang rỗng
            if (!document.getElementById('inputHoTen').value) {
                document.getElementById('inputHoTen').value = userHoTen;
            }
            if (!document.getElementById('inputDienThoai').value) {
                document.getElementById('inputDienThoai').value = userDienThoai;
            }
            if (!document.getElementById('inputStreet').value && userDiaChi) {
                document.getElementById('inputStreet').value = userDiaChi;
            }
            addressModalInstance.show();
        }

        function useAccountInfo() {
            document.getElementById('inputHoTen').value = userHoTen;
            document.getElementById('inputDienThoai').value = userDienThoai;
            if (userDiaChi) {
                document.getElementById('inputStreet').value = userDiaChi;
                // Reset các dropdown hành chính nếu dùng địa chỉ thô có sẵn
                document.getElementById('inputProvince').value = "";
                document.getElementById('inputDistrict').innerHTML = '<option value="">Chọn Quận/Huyện</option>';
                document.getElementById('inputDistrict').disabled = true;
                document.getElementById('inputWard').innerHTML = '<option value="">Chọn Phường/Xã</option>';
                document.getElementById('inputWard').disabled = true;
            }
        }

        // ==========================================
        // 2. HÀM TÍNH TOÁN CHÍNH (Nòng cốt)
        // ==========================================
        function calculateTotal() {
            // A. Lấy phí ship đang được tích chọn (nếu có)
            const checkedShip = document.querySelector('input[name="shipping_method"]:checked');
            const shippingFee = checkedShip ? parseFloat(checkedShip.getAttribute('data-price')) : 0;

            // B. Tính tiền giảm giá (dựa trên Tạm tính)
            const discountAmount = (baseSubTotal * currentDiscountPercent) / 100;

            // C. Tính tổng thanh toán cuối cùng
            const finalTotal = baseSubTotal + shippingFee - discountAmount;

            // D. Đổ dữ liệu ra màn hình
            document.getElementById('display-shipping').textContent = formatMoney(shippingFee);

            // Xử lý dòng Giảm giá (Chỉ hiện khi có áp mã)
            const discountRow = document.getElementById('discount-row');
            if (currentDiscountPercent > 0) {
                if(discountRow) discountRow.classList.remove('d-none'); // Hiện dòng giảm giá
                document.getElementById('discount-percent-label').textContent = currentDiscountPercent;
                document.getElementById('display-discount').textContent = '-' + formatMoney(discountAmount);
            } else {
                if(discountRow) discountRow.classList.add('d-none'); // Ẩn dòng giảm giá
            }

            // Hiện Tổng tiền cuối cùng
            document.getElementById('display-final').textContent = formatMoney(finalTotal);
        }

        // Hàm format tiền tệ (Thêm dấu phẩy và chữ $)
        function formatMoney(amount) {
            return new Intl.NumberFormat('en-US').format(amount) + '$';
        }

        // ==========================================
        // 3. CÁC HÀM XỬ LÝ LƯU DỮ LIỆU
        // ==========================================
        function saveAddress() {
            const hoTen = document.getElementById('inputHoTen').value.trim();
            const sdt = document.getElementById('inputDienThoai').value.trim();
            
            const street = document.getElementById('inputStreet').value.trim();
            const provinceSelect = document.getElementById('inputProvince');
            const districtSelect = document.getElementById('inputDistrict');
            const wardSelect = document.getElementById('inputWard');

            let diaChi = "";

            if (!hoTen || !sdt) {
                const errEl = document.getElementById('addrError');
                errEl.textContent = "Vui lòng điền đầy đủ Họ tên và Số điện thoại.";
                errEl.classList.remove('d-none');
                return;
            }

            // Nếu người dùng chọn Tỉnh/TP từ dropdown hành chính
            if (provinceSelect.value) {
                if (!districtSelect.value || !wardSelect.value || !street) {
                    const errEl = document.getElementById('addrError');
                    errEl.textContent = "Vui lòng chọn đầy đủ Quận/Huyện, Phường/Xã và nhập số nhà/tên đường.";
                    errEl.classList.remove('d-none');
                    return;
                }
                const provinceName = provinceSelect.options[provinceSelect.selectedIndex].text;
                const districtName = districtSelect.options[districtSelect.selectedIndex].text;
                const wardName = wardSelect.options[wardSelect.selectedIndex].text;
                
                diaChi = street + ", " + wardName + ", " + districtName + ", " + provinceName;
            } else {
                // Sử dụng địa chỉ nhập tự do (ví dụ địa chỉ thô từ tài khoản)
                if (!street) {
                    const errEl = document.getElementById('addrError');
                    errEl.textContent = "Vui lòng nhập địa chỉ nhận hàng.";
                    errEl.classList.remove('d-none');
                    return;
                }
                diaChi = street;
            }

            // Gán hiển thị ra màn hình
            document.getElementById('addrError').classList.add('d-none');
            document.getElementById('addrName').textContent = hoTen + ' - ' + sdt;
            document.getElementById('addrDetail').textContent = diaChi;
            document.getElementById('selectedAddressInfo').classList.remove('d-none');

            // Gán vào Hidden Input để Submit form về Controller
            document.getElementById('hiddenHoTen').value = hoTen;
            document.getElementById('hiddenDiaChi').value = diaChi;
            document.getElementById('hiddenSoDienThoai').value = sdt;

            addressModalInstance.hide();
        }

        function applyVoucher(maGg, tenMa, phanTram) {
            // Lưu ID voucher vào form ẩn để submit
            document.getElementById('selectedMaGg').value = maGg;

            // Hiện tên Voucher ra ngoài
            const label = document.getElementById('selectedVoucherLabel');
            label.textContent = `✔ Áp dụng mã: ${tenMa}`;
            label.classList.remove('d-none');

            // GÁN PHẦN TRĂM GIẢM GIÁ VÀ YÊU CẦU TÍNH TOÁN LẠI
            currentDiscountPercent = parseFloat(phanTram);
            calculateTotal();

            // Đóng Modal
            voucherModalInstance.hide();
        }

        function removeVoucher() {
            // Xóa dữ liệu form
            document.getElementById('selectedMaGg').value = '';
            document.getElementById('selectedVoucherLabel').classList.add('d-none');

            // ĐƯA PHẦN TRĂM VỀ 0 VÀ TÍNH TOÁN LẠI
            currentDiscountPercent = 0;
            calculateTotal();

            // Đóng Modal
            voucherModalInstance.hide();
        }
    </script>
</body>
</html>