@model IEnumerable<LTWEB_QuaMonHai_CuoiKy.Models.HoaDon>
@{
    ViewData["Title"] = "Lịch sử đơn hàng";
    Func<double, string> formatPrice = (double price) => price % 1 == 0 ? price.ToString("N0") : price.ToString("N2");
}

<div class="container py-5 mt-5" style="max-width: 1200px;">
    <div class="row g-4">
        <!-- Sidebar cột trái (3/12) -->
        <div class="col-lg-3 col-md-4">
            <partial name="_CustomerSidebar" />
        </div>

        <!-- Nội dung chính cột phải (9/12) -->
        <div class="col-lg-9 col-md-8">
            <div class="card shadow-sm border-0 rounded-3 bg-white p-4">
                <!-- Header -->
                <div class="d-flex align-items-center gap-3 mb-4 border-bottom pb-3">
                    <div class="d-flex align-items-center justify-content-center bg-primary text-white rounded-circle shadow-sm" style="width: 50px; height: 50px; background-color: var(--primary) !important;">
                        <i class="fa-solid fa-clock-rotate-left fs-5"></i>
                    </div>
                    <div>
                        <h4 class="fw-bold text-dark m-0">Lịch sử đơn hàng</h4>
                        <p class="text-muted m-0 small text-uppercase tracking-wider fs-7">Theo dõi trạng thái và chi tiết các giao dịch mua sắm của bạn</p>
                    </div>
                </div>

                <!-- Search and Filter Form -->
                <div class="card border-0 rounded-3 p-3 bg-light mb-4 shadow-none">
                    <form asp-action="OrderHistory" asp-controller="Cart" method="get" class="row g-3 align-items-end">
                        <!-- Search Input -->
                        <div class="col-md-5">
                            <label class="form-label fw-bold text-secondary small">Tìm kiếm đơn hàng</label>
                            <div class="input-group">
                                <span class="input-group-text bg-white border-end-0 text-muted">
                                    <i class="fa-solid fa-search"></i>
                                </span>
                                <input type="text" name="searchQuery" value="@ViewBag.SearchQuery" 
                                       class="form-control bg-white border-start-0 ps-0 shadow-none"
                                       placeholder="Nhập mã đơn hàng hoặc tên người nhận..." />
                            </div>
                        </div>

                        <!-- Status Filter -->
                        <div class="col-md-4">
                            <label class="form-label fw-bold text-secondary small">Trạng thái</label>
                            <select name="statusId" class="form-select bg-white shadow-none">
                                <option value="">-- Tất cả trạng thái --</option>
                                <!option value="0" @(ViewBag.StatusId?.ToString() == "0" ? "selected" : "")>Mới đặt</!option>
                                <!option value="1" @(ViewBag.StatusId?.ToString() == "1" ? "selected" : "")>Đang xử lý</!option>
                                <!option value="2" @(ViewBag.StatusId?.ToString() == "2" ? "selected" : "")>Đã giao</!option>
                                <!option value="3" @(ViewBag.StatusId?.ToString() == "3" ? "selected" : "")>Đã hủy</!option>
                            </select>
                        </div>

                        <!-- Action Buttons -->
                        <div class="col-md-3 d-flex gap-2">
                            <button type="submit" class="btn btn-success w-100 rounded shadow-none fw-bold" style="background-color: var(--primary) !important; border-color: var(--primary) !important; height: 38px;">
                                <i class="fa-solid fa-filter me-1"></i> Tìm
                            </button>
                            @if (!string.IsNullOrEmpty(ViewBag.SearchQuery) || ViewBag.StatusId != null)
                            {
                                <a asp-action="OrderHistory" asp-controller="Cart" class="btn btn-outline-secondary rounded shadow-none d-flex align-items-center justify-content-center" style="height: 38px;">
                                    Xóa
                                </a>
                            }
                        </div>
                    </form>
                </div>

                @if (Model != null && Model.Any())
                {
                    <div class="d-flex flex-column gap-4">
                        @foreach (var order in Model)
                        {
                            <div class="card shadow-sm border border-light rounded-3 overflow-hidden mb-3">
                                <!-- Order Header -->
                                <div class="card-header bg-light py-3 px-4 border-bottom">
                                    <div class="row align-items-center g-3">
                                        <div class="col-md-8">
                                            <div class="d-flex flex-wrap align-items-center gap-3 gap-md-4">
                                                <div>
                                                    <small class="text-muted text-uppercase tracking-wider font-monospace d-block" style="font-size: 0.75rem;">Mã đơn hàng</small>
                                                    <strong class="text-dark">#@order.MaHd</strong>
                                                </div>
                                                <div class="d-none d-md-block border-end" style="height: 30px;"></div>
                                                <div>
                                                    <small class="text-muted text-uppercase tracking-wider font-monospace d-block" style="font-size: 0.75rem;">Ngày đặt</small>
                                                    <span class="text-secondary fw-semibold">@order.NgayDat.ToString("dd/MM/yyyy HH:mm")</span>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4 text-md-end text-start">
                                            @{
                                                string statusText = order.MaTrangThai switch {
                                                    0 => "Mới đặt",
                                                    1 => "Đang xử lý",
                                                    2 => "Đã giao",
                                                    3 => "Đã hủy",
                                                    _ => "Không xác định"
                                                };
                                                string statusIcon = order.MaTrangThai switch {
                                                    0 => "fa-box",
                                                    1 => "fa-spinner fa-spin",
                                                    2 => "fa-check-circle",
                                                    3 => "fa-times-circle",
                                                    _ => "fa-question-circle"
                                                };
                                                string customBadgeStyle = order.MaTrangThai switch {
                                                    0 => "background-color: rgba(13, 110, 253, 0.1) !important; color: #0d6efd !important; border-color: rgba(13, 110, 253, 0.2) !important;",
                                                    1 => "background-color: rgba(255, 193, 7, 0.1) !important; color: #f59e0b !important; border-color: rgba(255, 193, 7, 0.2) !important;",
                                                    2 => "background-color: rgba(60, 184, 21, 0.1) !important; color: var(--primary) !important; border-color: rgba(60, 184, 21, 0.2) !important;",
                                                    3 => "background-color: rgba(220, 53, 69, 0.1) !important; color: #dc3545 !important; border-color: rgba(220, 53, 69, 0.2) !important;",
                                                    _ => "background-color: rgba(108, 117, 125, 0.1) !important; color: #6c757d !important; border-color: rgba(108, 117, 125, 0.2) !important;"
                                                };
                                            }
                                            <span class="badge border px-3 py-2 fw-bold" style="@customBadgeStyle">
                                                <i class="fa-solid @statusIcon me-1"></i> @statusText
                                            </span>
                                        </div>
                                    </div>
                                </div>

                                <!-- Order Items -->
                                <div class="card-body p-3">
                                    <div class="d-flex flex-column gap-2">
                                        @foreach (var item in order.ChiTietHds)
                                        {
                                            <div class="d-flex flex-wrap align-items-center justify-content-between p-3 rounded-3 hover-bg-light transition" style="background-color: #fafafa;">
                                                <div class="d-flex align-items-center gap-3">
                                                    <div class="position-relative border rounded overflow-hidden" style="width: 60px; height: 60px;">
                                                        <img src="@Url.Content("~/img/Hinh/HangHoa/" + item.MaHhNavigation.Hinh)" 
                                                             alt="@item.MaHhNavigation.TenHh" 
                                                             class="w-100 h-100 object-fit-cover" 
                                                             style="object-fit: cover;" />
                                                    </div>
                                                    <div>
                                                        <h6 class="fw-bold text-dark mb-1 hover-primary pointer" style="font-size: 0.95rem;">
                                                            @item.MaHhNavigation.TenHh
                                                        </h6>
                                                        <small class="text-muted d-block">Đơn giá: $@formatPrice(item.DonGia) | Số lượng mua: <strong>@item.SoLuong</strong></small>
                                                    </div>
                                                </div>
                                                <div class="text-end mt-2 mt-sm-0">
                                                    <strong class="text-dark fs-6">$@formatPrice(item.DonGia * item.SoLuong)</strong>
                                                    @if (item.GiamGia > 0)
                                                    {
                                                        <div class="mt-1">
                                                            <span class="badge rounded px-2 py-1" style="font-size: 0.7rem; background-color: rgba(220, 53, 69, 0.1) !important; color: #dc3545 !important;">
                                                                Giảm -$@formatPrice(item.GiamGia)
                                                            </span>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>

                                <!-- Order Footer -->
                                <div class="card-footer bg-light border-top py-3 px-4">
                                    <div class="row align-items-center g-3">
                                        <div class="col-lg-8 col-md-7">
                                            <div class="d-flex align-items-start gap-2">
                                                <i class="fa-solid fa-location-dot mt-1 text-success fs-6" style="color: var(--primary) !important;"></i>
                                                <div>
                                                    <h6 class="fw-bold text-dark mb-1" style="font-size: 0.9rem;">@order.HoTen</h6>
                                                    <p class="text-muted small mb-0 fs-7">@order.DiaChi @(order.SoDienThoai.HasValue ? " - 0" + order.SoDienThoai : "")</p>
                                                </div>
                                            </div>
                                            <div class="d-flex flex-wrap gap-2 mt-3">
                                                <span class="badge bg-white text-dark border px-3 py-1.5 shadow-sm rounded-pill font-weight-normal fs-7">
                                                    <i class="fa-solid fa-truck text-success me-1" style="color: var(--primary) !important;"></i>
                                                    @(order.CachVanChuyen == "express" ? "Giao hàng nhanh" : order.CachVanChuyen == "economy" ? "Giao tiết kiệm" : "Giao tiêu chuẩn")
                                                </span>
                                                <span class="badge bg-white text-dark border px-3 py-1.5 shadow-sm rounded-pill font-weight-normal fs-7">
                                                    <i class="fa-solid fa-wallet text-info me-1"></i>
                                                    @(order.CachThanhToan == "cod" ? "Thanh toán khi nhận hàng" : "Chuyển khoản")
                                                </span>
                                            </div>
                                        </div>
                                        <div class="col-lg-4 col-md-5 text-md-end text-start">
                                            <div class="bg-white p-3 rounded shadow-sm border d-inline-block w-100" style="max-width: 320px;">
                                                <div class="d-flex justify-content-between mb-2 small text-secondary">
                                                    <span>Phí vận chuyển:</span>
                                                    <span>$@formatPrice(order.PhiVanChuyen)</span>
                                                </div>
                                                <div class="d-flex justify-content-between align-items-center border-top pt-2 mt-2">
                                                    <span class="text-dark fw-bold small">Tổng thanh toán:</span>
                                                    <span class="fs-5 fw-extrabold text-success" style="color: var(--primary) !important;">
                                                        $@formatPrice(order.ChiTietHds.Sum(c => c.DonGia * c.SoLuong) + order.PhiVanChuyen - order.ChiTietHds.Sum(c => c.GiamGia))
                                                    </span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="card border-0 py-5 text-center bg-white shadow-none">
                        <div class="card-body py-5 d-flex flex-column align-items-center">
                            <div class="d-flex align-items-center justify-content-center bg-light rounded-circle mb-4" style="width: 80px; height: 80px;">
                                <i class="fa-solid fa-receipt text-muted fs-2"></i>
                            </div>
                            <h5 class="fw-bold text-dark mb-2">Chưa có đơn hàng nào</h5>
                            <p class="text-muted mb-4 small px-3" style="max-width: 450px;">Không tìm thấy đơn hàng nào khớp với từ khóa tìm kiếm hoặc bạn chưa thực hiện bất kỳ giao dịch mua nào.</p>
                            <a href="/" class="btn btn-success rounded-pill px-4 py-2 fw-bold shadow-sm" style="background-color: var(--primary) !important; border-color: var(--primary) !important;">
                                <i class="fa-solid fa-basket-shopping me-2"></i> Bắt đầu mua sắm
                            </a>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<style>
    .hover-bg-light:hover {
        background-color: rgba(60, 184, 21, 0.04) !important;
        transition: background-color 0.2s ease;
    }
    .hover-primary:hover {
        color: var(--primary) !important;
        transition: color 0.2s ease;
        text-decoration: none;
    }
    .fw-extrabold {
        font-weight: 800;
    }
    .fs-7 {
        font-size: 0.8rem;
    }
</style>
