@model IEnumerable<LTWEB_QuaMonHai_CuoiKy.Models.HoaDon>
@{
    ViewData["Title"] = "Lịch sử đơn hàng";
}

<div class="container py-5 mt-5">
    <!-- Header -->
    <div class="d-flex align-items-center gap-3 mb-4 border-bottom pb-3">
        <div class="d-flex align-items-center justify-content-center bg-primary text-white rounded-circle shadow-sm" style="width: 55px; height: 55px; background-color: #81c408 !important;">
            <i class="fa-solid fa-clock-rotate-left fs-4"></i>
        </div>
        <div>
            <h2 class="fw-bold text-dark m-0" style="font-family: 'Lora', serif;">Lịch sử đơn hàng</h2>
            <p class="text-muted m-0 small">Theo dõi trạng thái và chi tiết các giao dịch của bạn</p>
        </div>
    </div>

    <!-- Search and Filter Form -->
    <div class="card shadow-sm border-0 rounded-3 p-4 bg-light mb-4">
        <form asp-action="OrderHistory" method="get" class="row g-3 align-items-end">
            <!-- Search Input -->
            <div class="col-md-5">
                <label class="form-label fw-bold text-secondary small">Tìm kiếm đơn hàng</label>
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0 text-muted">
                        <i class="fa-solid fa-search"></i>
                    </span>
                    <input type="text" name="searchQuery" value="@ViewBag.SearchQuery" 
                           class="form-control bg-white border-start-0 ps-0 shadow-none"
                           placeholder="Nhập mã đơn hàng hoặc tên người nhận..." />
                </div>
            </div>

            <!-- Status Filter -->
            <div class="col-md-4">
                <label class="form-label fw-bold text-secondary small">Trạng thái</label>
                <select name="statusId" class="form-select bg-white shadow-none">
                    <option value="">-- Tất cả trạng thái --</option>
                    <!option value="0" @(ViewBag.StatusId?.ToString() == "0" ? "selected" : "")>Mới đặt</!option>
                    <!option value="1" @(ViewBag.StatusId?.ToString() == "1" ? "selected" : "")>Đang xử lý</!option>
                    <!option value="2" @(ViewBag.StatusId?.ToString() == "2" ? "selected" : "")>Đã giao</!option>
                    <!option value="3" @(ViewBag.StatusId?.ToString() == "3" ? "selected" : "")>Đã hủy</!option>
                </select>
            </div>

            <!-- Action Buttons -->
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-success w-100 rounded shadow-none fw-bold" style="background-color: #81c408 !important; border-color: #81c408 !important;">
                    <i class="fa-solid fa-filter me-1"></i> Tìm kiếm
                </button>
                @if (!string.IsNullOrEmpty(ViewBag.SearchQuery) || ViewBag.StatusId != null)
                {
                    <a asp-action="OrderHistory" class="btn btn-outline-secondary rounded shadow-none">
                        Xóa
                    </a>
                }
            </div>
        </form>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="d-flex flex-column gap-4">
            @foreach (var order in Model)
            {
                <div class="card shadow-sm border-0 rounded-3 overflow-hidden mb-4">
                    <!-- Order Header -->
                    <div class="card-header bg-light py-3 px-4 border-bottom">
                        <div class="row align-items-center g-3">
                            <div class="col-md-8">
                                <div class="d-flex flex-wrap align-items-center gap-3 gap-md-4">
                                    <div>
                                        <small class="text-muted text-uppercase tracking-wider font-monospace d-block" style="font-size: 0.75rem;">Mã đơn hàng</small>
                                        <strong class="text-dark">#@order.MaHd</strong>
                                    </div>
                                    <div class="d-none d-md-block border-end" style="height: 30px;"></div>
                                    <div>
                                        <small class="text-muted text-uppercase tracking-wider font-monospace d-block" style="font-size: 0.75rem;">Ngày đặt</small>
                                        <span class="text-secondary fw-semibold">@order.NgayDat.ToString("dd/MM/yyyy HH:mm")</span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4 text-md-end text-start">
                                @{
                                    string statusText = order.MaTrangThai switch {
                                        0 => "Mới đặt",
                                        1 => "Đang xử lý",
                                        2 => "Đã giao",
                                        3 => "Đã hủy",
                                        _ => "Không xác định"
                                    };
                                    string statusIcon = order.MaTrangThai switch {
                                        0 => "fa-box",
                                        1 => "fa-spinner fa-spin",
                                        2 => "fa-check-circle",
                                        3 => "fa-times-circle",
                                        _ => "fa-question-circle"
                                    };
                                    string customBadgeStyle = order.MaTrangThai switch {
                                        0 => "background-color: rgba(13, 110, 253, 0.1) !important; color: #0d6efd !important; border-color: rgba(13, 110, 253, 0.2) !important;",
                                        1 => "background-color: rgba(255, 193, 7, 0.1) !important; color: #f59e0b !important; border-color: rgba(255, 193, 7, 0.2) !important;",
                                        2 => "background-color: rgba(129, 196, 8, 0.1) !important; color: #81c408 !important; border-color: rgba(129, 196, 8, 0.2) !important;",
                                        3 => "background-color: rgba(220, 53, 69, 0.1) !important; color: #dc3545 !important; border-color: rgba(220, 53, 69, 0.2) !important;",
                                        _ => "background-color: rgba(108, 117, 125, 0.1) !important; color: #6c757d !important; border-color: rgba(108, 117, 125, 0.2) !important;"
                                    };
                                }
                                <span class="badge border px-3 py-2 fw-bold" style="@customBadgeStyle">
                                    <i class="fa-solid @statusIcon me-1"></i> @statusText
                                </span>
                            </div>
                        </div>
                    </div>

                    <!-- Order Items -->
                    <div class="card-body p-4">
                        <div class="d-flex flex-column gap-3">
                            @foreach (var item in order.ChiTietHds)
                            {
                                <div class="d-flex flex-wrap align-items-center justify-content-between p-3 rounded-3 hover-bg-light transition" style="background-color: #fafafa;">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="position-relative" style="width: 70px; height: 70px;">
                                            <img src="@Url.Content("~/img/Hinh/HangHoa/" + item.MaHhNavigation.Hinh)" 
                                                 alt="@item.MaHhNavigation.TenHh" 
                                                 class="rounded shadow-sm border" 
                                                 style="width: 100%; height: 100%; object-fit: cover;" />
                                        </div>
                                        <div>
                                            <h6 class="fw-bold text-dark mb-1 hover-primary pointer">
                                                @item.MaHhNavigation.TenHh
                                            </h6>
                                            <small class="text-muted d-block">Đơn giá: @item.DonGia.ToString("N0")₫ | Số lượng mua: <strong>@item.SoLuong</strong></small>
                                        </div>
                                    </div>
                                    <div class="text-end mt-2 mt-sm-0">
                                        <strong class="text-dark fs-5">@((item.DonGia * item.SoLuong).ToString("N0"))₫</strong>
                                        @if (item.GiamGia > 0)
                                        {
                                            <div class="mt-1">
                                                <span class="badge rounded px-2 py-1" style="font-size: 0.75rem; background-color: rgba(220, 53, 69, 0.1) !important; color: #dc3545 !important;">
                                                    Giảm -@item.GiamGia.ToString("N0")₫
                                                </span>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Order Footer -->
                    <div class="card-footer bg-light border-top py-3 px-4">
                        <div class="row align-items-center g-4">
                            <div class="col-lg-8 col-md-7">
                                <div class="d-flex align-items-start gap-3">
                                    <i class="fa-solid fa-location-dot mt-1 text-success fs-5"></i>
                                    <div>
                                        <h6 class="fw-bold text-dark mb-1">@order.HoTen</h6>
                                        <p class="text-muted small mb-0">@order.DiaChi</p>
                                    </div>
                                </div>
                                <div class="d-flex flex-wrap gap-2 mt-3">
                                    <span class="badge bg-white text-dark border px-3 py-2 shadow-sm rounded-pill font-weight-normal">
                                        <i class="fa-solid fa-truck text-success me-1"></i>
                                        @(order.CachVanChuyen == "express" ? "Giao hàng nhanh" : order.CachVanChuyen == "economy" ? "Giao tiết kiệm" : "Giao tiêu chuẩn")
                                    </span>
                                    <span class="badge bg-white text-dark border px-3 py-2 shadow-sm rounded-pill font-weight-normal">
                                        <i class="fa-solid fa-wallet text-info me-1"></i>
                                        @(order.CachThanhToan == "cod" ? "Thanh toán khi nhận hàng" : "Chuyển khoản")
                                    </span>
                                </div>
                            </div>
                            <div class="col-lg-4 col-md-5 text-md-end text-start">
                                <div class="bg-white p-3 rounded shadow-sm border d-inline-block w-100" style="max-width: 320px;">
                                    <div class="d-flex justify-content-between mb-2 small text-secondary">
                                        <span>Phí vận chuyển:</span>
                                        <span>@order.PhiVanChuyen.ToString("N0")₫</span>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center border-top pt-2 mt-2">
                                        <span class="text-dark fw-bold">Tổng thanh toán:</span>
                                        <span class="fs-4 fw-extrabold text-success" style="color: #81c408 !important;">
                                            @((order.ChiTietHds.Sum(c => c.DonGia * c.SoLuong) + order.PhiVanChuyen - order.ChiTietHds.Sum(c => c.GiamGia)).ToString("N0"))₫
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0 rounded-3 py-5 text-center bg-white">
            <div class="card-body py-5 d-flex flex-column align-items-center">
                <div class="d-flex align-items-center justify-content-center bg-light rounded-circle mb-4" style="width: 100px; height: 100px;">
                    <i class="fa-solid fa-receipt text-muted fs-1"></i>
                </div>
                <h3 class="fw-bold text-dark mb-2">Chưa có đơn hàng nào</h3>
                <p class="text-muted mb-4 px-3" style="max-width: 450px;">Không tìm thấy đơn hàng nào khớp với từ khóa tìm kiếm hoặc bạn chưa thực hiện bất kỳ giao dịch mua nào.</p>
                <a href="/" class="btn btn-success rounded-pill px-4 py-2 fw-bold shadow-sm" style="background-color: #81c408 !important; border-color: #81c408 !important;">
                    <i class="fa-solid fa-basket-shopping me-2"></i> Bắt đầu mua sắm
                </a>
            </div>
        </div>
    }
</div>

<style>
    .hover-bg-light:hover {
        background-color: rgba(129, 196, 8, 0.04) !important;
        transition: background-color 0.2s ease;
    }
    .hover-primary:hover {
        color: #81c408 !important;
        transition: color 0.2s ease;
        text-decoration: none;
    }
    .fw-extrabold {
        font-weight: 800;
    }
</style>
