@model IEnumerable<LTWEB_QuaMonHai_CuoiKy.Models.HoaDon>
@{
    ViewData["Title"] = "Lịch sử đơn hàng";
}

<script src="https://cdn.tailwindcss.com"></script>
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<style>
    body { font-family: 'Inter', sans-serif; }
    .glass-card {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.2);
    }
</style>

<div class="max-w-6xl mx-auto px-4 py-10">
    <div class="flex items-center gap-4 mb-8 pb-4 border-b border-gray-200">
        <div class="w-14 h-14 rounded-full bg-gradient-to-tr from-green-500 to-emerald-400 flex items-center justify-center shadow-lg text-white">
            <i class="fa-solid fa-clock-rotate-left text-2xl"></i>
        </div>
        <div>
            <h2 class="text-3xl font-extrabold text-gray-800 tracking-tight">Lịch sử đơn hàng</h2>
            <p class="text-gray-500 mt-1">Theo dõi trạng thái và chi tiết các giao dịch của bạn</p>
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="space-y-8">
            @foreach (var order in Model)
            {
                <div class="glass-card rounded-2xl shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 overflow-hidden group border border-gray-100">
                    <!-- Order Header -->
                    <div class="bg-gradient-to-r from-gray-50 to-white px-6 py-4 border-b border-gray-100 flex flex-wrap justify-between items-center gap-4">
                        <div class="flex items-center gap-6">
                            <div>
                                <p class="text-xs text-gray-400 uppercase tracking-wider font-semibold mb-1">Mã đơn hàng</p>
                                <p class="font-bold text-gray-800">#@order.MaHd</p>
                            </div>
                            <div class="hidden sm:block w-px h-8 bg-gray-200"></div>
                            <div>
                                <p class="text-xs text-gray-400 uppercase tracking-wider font-semibold mb-1">Ngày đặt</p>
                                <p class="font-semibold text-gray-700">@order.NgayDat.ToString("dd/MM/yyyy HH:mm")</p>
                            </div>
                        </div>
                        <div>
                            @{
                                string statusClass = order.MaTrangThai switch {
                                    0 => "bg-blue-50 text-blue-600 border-blue-200",
                                    1 => "bg-amber-50 text-amber-600 border-amber-200",
                                    2 => "bg-emerald-50 text-emerald-600 border-emerald-200",
                                    3 => "bg-red-50 text-red-600 border-red-200",
                                    _ => "bg-gray-50 text-gray-600 border-gray-200"
                                };
                                string statusText = order.MaTrangThai switch {
                                    0 => "Mới đặt",
                                    1 => "Đang xử lý",
                                    2 => "Đã giao",
                                    3 => "Đã hủy",
                                    _ => "Không xác định"
                                };
                                string statusIcon = order.MaTrangThai switch {
                                    0 => "fa-box",
                                    1 => "fa-spinner fa-spin",
                                    2 => "fa-check-circle",
                                    3 => "fa-times-circle",
                                    _ => "fa-question-circle"
                                };
                            }
                            <span class="px-4 py-1.5 rounded-full text-sm font-semibold border flex items-center gap-2 shadow-sm @statusClass">
                                <i class="fa-solid @statusIcon"></i> @statusText
                            </span>
                        </div>
                    </div>

                    <!-- Order Items -->
                    <div class="p-6">
                        <div class="space-y-5">
                            @foreach (var item in order.ChiTietHds)
                            {
                                <div class="flex items-center justify-between p-3 hover:bg-gray-50 rounded-xl transition-colors">
                                    <div class="flex items-center gap-5">
                                        <div class="relative">
                                            <img src="~/img/Hinh/HangHoa/@item.MaHhNavigation.Hinh" alt="@item.MaHhNavigation.TenHh" class="w-20 h-20 object-cover rounded-lg shadow-sm border border-gray-100">
                                            <span class="absolute -top-2 -right-2 w-6 h-6 bg-gray-800 text-white text-xs font-bold rounded-full flex items-center justify-center shadow-md">
                                                x @item.SoLuong                                            
                                                </span>
                                        </div>
                                        <div>
                                            <p class="font-bold text-gray-800 text-lg hover:text-green-600 transition-colors cursor-pointer">@item.MaHhNavigation.TenHh</p>
                                            <p class="text-gray-500 text-sm mt-0.5">Đơn giá: @item.DonGia.ToString("N0")₫</p>
                                        </div>
                                    </div>
                                    <div class="text-right">
                                        <p class="font-bold text-gray-800 text-lg">@((item.DonGia * item.SoLuong).ToString("N0"))₫</p>
                                        @if (item.GiamGia > 0)
                                        {
                                            <p class="text-sm font-medium text-red-500 bg-red-50 px-2 py-0.5 rounded inline-block mt-1">Giảm -@item.GiamGia.ToString("N0")₫</p>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Order Footer -->
                    <div class="bg-gray-50 px-6 py-5 border-t border-gray-100 flex flex-col md:flex-row justify-between items-center gap-6">
                        <div class="flex flex-col gap-2 w-full md:w-2/3">
                            <div class="flex items-start gap-3">
                                <i class="fa-solid fa-location-dot mt-1 text-gray-400"></i>
                                <div>
                                    <p class="text-sm font-semibold text-gray-700">@order.HoTen</p>
                                    <p class="text-sm text-gray-500">@order.DiaChi</p>
                                </div>
                            </div>
                            <div class="flex items-center gap-4 mt-2 text-sm text-gray-600">
                                <span class="flex items-center gap-1.5 bg-white px-3 py-1 rounded-md border shadow-sm"><i class="fa-solid fa-truck text-green-500"></i> @(order.CachVanChuyen == "express" ? "Giao hàng nhanh" : order.CachVanChuyen == "economy" ? "Giao tiết kiệm" : "Giao tiêu chuẩn")</span>
                                <span class="flex items-center gap-1.5 bg-white px-3 py-1 rounded-md border shadow-sm"><i class="fa-solid fa-wallet text-blue-500"></i> @(order.CachThanhToan == "cod" ? "Thanh toán khi nhận hàng" : "Chuyển khoản")</span>
                            </div>
                        </div>
                        <div class="text-right w-full md:w-auto bg-white p-4 rounded-xl shadow-sm border border-gray-100 group-hover:border-green-200 transition-colors">
                            <div class="flex justify-between items-center gap-6 mb-1 text-sm">
                                <span class="text-gray-500">Phí vận chuyển:</span>
                                <span class="font-medium">@order.PhiVanChuyen.ToString("N0")₫</span>
                            </div>
                            <div class="flex justify-between items-center gap-6 border-t pt-2 mt-2">
                                <span class="text-gray-600 font-semibold">Tổng thanh toán:</span>
                                <span class="text-2xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-green-600 to-emerald-500">
                                    @((order.ChiTietHds.Sum(c => c.DonGia * c.SoLuong) + order.PhiVanChuyen - order.ChiTietHds.Sum(c => c.GiamGia)).ToString("N0"))₫
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="bg-white rounded-2xl shadow-sm p-16 text-center border border-gray-100 flex flex-col items-center justify-center min-h-[50vh]">
            <div class="w-32 h-32 bg-gradient-to-tr from-gray-50 to-gray-100 rounded-full flex items-center justify-center mb-6 shadow-inner">
                <i class="fa-solid fa-receipt text-gray-300 text-6xl drop-shadow-sm"></i>
            </div>
            <h3 class="text-2xl font-bold text-gray-800 mb-3 tracking-tight">Chưa có đơn hàng nào</h3>
            <p class="text-gray-500 mb-8 max-w-md text-lg">Bạn chưa thực hiện bất kỳ giao dịch mua nào. Hãy khám phá các sản phẩm tuyệt vời của chúng tôi!</p>
            <a href="/" class="group relative inline-flex items-center justify-center px-8 py-3.5 text-base font-bold text-white transition-all duration-200 bg-gradient-to-r from-green-500 to-emerald-600 border border-transparent rounded-full hover:shadow-lg hover:from-green-600 hover:to-emerald-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-600">
                <i class="fa-solid fa-basket-shopping me-2 group-hover:-translate-y-0.5 transition-transform"></i> Bắt đầu mua sắm
            </a>
        </div>
    }
</div>
