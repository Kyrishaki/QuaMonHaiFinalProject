@model LTWEB_QuaMonHai_CuoiKy.Models.HoaDon
@{
    ViewData["Title"] = "Tra cứu đơn hàng";
}

<div class="container py-5 mt-5">
    <!-- Header -->
    <div class="d-flex align-items-center gap-3 mb-5 border-bottom pb-3">
        <div class="d-flex align-items-center justify-content-center bg-primary text-white rounded-circle shadow-sm" style="width: 55px; height: 55px; background-color: #81c408 !important;">
            <i class="fa-solid fa-magnifying-glass fs-4"></i>
        </div>
        <div>
            <h2 class="fw-bold text-dark m-0" style="font-family: 'Lora', serif;">Tra cứu đơn hàng</h2>
            <p class="text-muted m-0 small">Kiểm tra nhanh tình trạng và tiến trình giao hàng của đơn hàng</p>
        </div>
    </div>

    <!-- Search Form Card -->
    <div class="row justify-content-center mb-5">
        <div class="col-lg-7">
            <div class="card shadow border-0 rounded-4 overflow-hidden" style="background: linear-gradient(135deg, #ffffff 0%, #f9fbf7 100%);">
                <div class="card-body p-4 p-md-5 text-center">
                    <div class="d-inline-flex align-items-center justify-content-center bg-light rounded-circle mb-3 shadow-inner" style="width: 70px; height: 70px;">
                        <i class="fa-solid fa-truck-fast text-success fs-3" style="color: #81c408 !important;"></i>
                    </div>
                    <h4 class="fw-bold text-dark mb-2">Tìm kiếm đơn hàng của bạn</h4>
                    <p class="text-muted small mb-4 px-md-4">Nhập mã đơn hàng (số hóa đơn được cấp khi thanh toán) để theo dõi tiến độ giao hàng chi tiết.</p>

                    <form asp-action="LookupOrder" method="get">
                        <div class="d-flex flex-column flex-sm-row gap-2">
                            <div class="input-group input-group-lg flex-grow-1 shadow-sm rounded">
                                <span class="input-group-text bg-white border-end-0 text-muted">
                                    <i class="fa-solid fa-hashtag"></i>
                                </span>
                                <input type="number" name="orderId" value="@ViewBag.OrderId" required
                                       class="form-control bg-white border-start-0 ps-0 shadow-none" 
                                       placeholder="Nhập mã số đơn hàng (Ví dụ: 1002)..." />
                            </div>
                            <button type="submit" class="btn btn-success btn-lg px-4 fw-bold shadow-sm rounded-3 transition-all" style="background-color: #81c408 !important; border-color: #81c408 !important;">
                                <i class="fa-solid fa-search me-1"></i> Tra cứu
                            </button>
                        </div>
                    </form>

                    @if (ViewBag.ErrorMessage != null)
                    {
                        <div class="alert alert-danger d-flex align-items-center rounded-3 mt-4 mb-0 text-start shadow-sm border-0" role="alert" style="background-color: rgba(220, 53, 69, 0.08); color: #dc3545;">
                            <i class="fa-solid fa-circle-exclamation me-2 fa-lg"></i>
                            <div>@ViewBag.ErrorMessage</div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Tracking Results -->
    @if (Model != null)
    {
        <div class="row g-4">
            <!-- Timeline & Status Details -->
            <div class="col-lg-8">
                <!-- Status Progress Card -->
                <div class="card shadow-sm border-0 rounded-3 mb-4">
                    <div class="card-body p-4">
                        <h5 class="fw-bold text-dark mb-4 border-bottom pb-2">
                            <i class="fa-solid fa-route text-success me-2" style="color: #81c408 !important;"></i>Tiến trình đơn hàng #@Model.MaHd
                        </h5>

                        <!-- Timeline steps -->
                        <div class="row justify-content-between position-relative my-4 timeline-container">
                            <div class="position-absolute top-50 start-0 end-0 translate-middle-y bg-light d-none d-md-block" style="height: 4px; z-index: 1;"></div>
                            
                            @{
                                int currentStatus = Model.MaTrangThai; // 0, 1, 2, 3
                            }

                            <!-- Step 1: Mới đặt -->
                            <div class="col-md-3 text-center mb-4 mb-md-0 position-relative" style="z-index: 2;">
                                <div class="d-inline-flex align-items-center justify-content-center rounded-circle shadow @(currentStatus >= 0 ? "bg-primary text-white" : "bg-white text-muted border")" 
                                     style="width: 50px; height: 50px; @(currentStatus >= 0 ? "background-color: #81c408 !important;" : "")">
                                    <i class="fa-solid fa-receipt"></i>
                                </div>
                                <h6 class="fw-bold mt-3 mb-1 @(currentStatus >= 0 ? "text-dark" : "text-muted")">Mới đặt</h6>
                                <p class="text-muted small m-0">Đơn hàng được ghi nhận</p>
                            </div>

                            <!-- Step 2: Đang xử lý -->
                            <div class="col-md-3 text-center mb-4 mb-md-0 position-relative" style="z-index: 2;">
                                <div class="d-inline-flex align-items-center justify-content-center rounded-circle shadow @(currentStatus == 1 || currentStatus >= 2 ? "bg-warning text-white" : currentStatus == 3 ? "bg-white text-muted border" : "bg-white text-muted border")" 
                                     style="width: 50px; height: 50px; @(currentStatus == 1 || currentStatus >= 2 ? "background-color: #f59e0b !important;" : "")">
                                    <i class="fa-solid fa-gears"></i>
                                </div>
                                <h6 class="fw-bold mt-3 mb-1 @(currentStatus == 1 || currentStatus >= 2 ? "text-dark" : "text-muted")">Đang chuẩn bị</h6>
                                <p class="text-muted small m-0">Đang chuẩn bị hàng hóa</p>
                            </div>

                            <!-- Step 3: Đang giao / Đã giao -->
                            @if (currentStatus == 3)
                            {
                                <div class="col-md-3 text-center mb-4 mb-md-0 position-relative" style="z-index: 2;">
                                    <div class="d-inline-flex align-items-center justify-content-center rounded-circle shadow bg-danger text-white" 
                                         style="width: 50px; height: 50px;">
                                        <i class="fa-solid fa-times-circle"></i>
                                    </div>
                                    <h6 class="fw-bold mt-3 mb-1 text-danger">Đã hủy</h6>
                                    <p class="text-muted small m-0">Đơn hàng đã bị hủy bỏ</p>
                                </div>
                            }
                            else
                            {
                                <div class="col-md-3 text-center mb-4 mb-md-0 position-relative" style="z-index: 2;">
                                    <div class="d-inline-flex align-items-center justify-content-center rounded-circle shadow @(currentStatus == 2 ? "bg-success text-white" : "bg-white text-muted border")" 
                                         style="width: 50px; height: 50px; @(currentStatus == 2 ? "background-color: #81c408 !important;" : "")">
                                        <i class="fa-solid fa-check-double"></i>
                                    </div>
                                    <h6 class="fw-bold mt-3 mb-1 @(currentStatus == 2 ? "text-dark" : "text-muted")">Đã giao</h6>
                                    <p class="text-muted small m-0">Giao hàng thành công</p>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Products Summary Card -->
                <div class="card shadow-sm border-0 rounded-3">
                    <div class="card-body p-4">
                        <h5 class="fw-bold text-dark mb-4 border-bottom pb-2">
                            <i class="fa-solid fa-box-open text-success me-2" style="color: #81c408 !important;"></i>Hàng hóa trong đơn hàng
                        </h5>
                        <div class="d-flex flex-column gap-3">
                            @foreach (var item in Model.ChiTietHds)
                            {
                                <div class="d-flex align-items-center justify-content-between p-3 rounded-3" style="background-color: #fafafa;">
                                    <div class="d-flex align-items-center gap-3">
                                        <div style="width: 60px; height: 60px;">
                                            <img src="@Url.Content("~/img/Hinh/HangHoa/" + item.MaHhNavigation.Hinh)" 
                                                 alt="@item.MaHhNavigation.TenHh" 
                                                 class="rounded shadow-sm border" 
                                                 style="width: 100%; height: 100%; object-fit: cover;" />
                                        </div>
                                        <div>
                                            <h6 class="fw-bold text-dark mb-1">
                                                @item.MaHhNavigation.TenHh
                                                
                                            </h6>
                                            <small class="text-muted">Đơn giá: @item.DonGia.ToString("N0")₫ | Số lượng: <strong>@item.SoLuong</strong></small>
                                        </div>
                                    </div>
                                    <div class="text-end">
                                        <strong class="text-dark">@((item.DonGia * item.SoLuong).ToString("N0"))₫</strong>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Receiver Details & Pricing Summary -->
            <div class="col-lg-4">
                <!-- Recipient Info Card -->
                <div class="card shadow-sm border-0 rounded-3 mb-4">
                    <div class="card-body p-4">
                        <h5 class="fw-bold text-dark mb-3 border-bottom pb-2">
                            <i class="fa-solid fa-address-book text-success me-2" style="color: #81c408 !important;"></i>Thông tin người nhận
                        </h5>
                        <div class="mb-3">
                            <small class="text-muted d-block small">Họ và tên</small>
                            <span class="fw-bold text-dark fs-6">@Model.HoTen</span>
                        </div>
                        <div class="mb-3">
                            <small class="text-muted d-block small">Địa chỉ nhận hàng</small>
                            <span class="text-secondary small fw-semibold">@Model.DiaChi</span>
                        </div>
                        @if (Model.MaKhNavigation != null && !string.IsNullOrEmpty(Model.MaKhNavigation.DienThoai))
                        {
                            <div class="mb-3">
                                <small class="text-muted d-block small">Số điện thoại</small>
                                <span class="text-secondary fw-semibold">@Model.MaKhNavigation.DienThoai</span>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(Model.GhiChu))
                        {
                            <div class="mb-0 bg-light p-2.5 rounded border border-light">
                                <small class="text-muted d-block small">Ghi chú giao hàng</small>
                                <span class="fst-italic text-secondary small">"@Model.GhiChu"</span>
                            </div>
                        }
                    </div>
                </div>

                <!-- Payment Details Card -->
                <div class="card shadow-sm border-0 rounded-3">
                    <div class="card-body p-4">
                        <h5 class="fw-bold text-dark mb-3 border-bottom pb-2">
                            <i class="fa-solid fa-file-invoice-dollar text-success me-2" style="color: #81c408 !important;"></i>Thông tin thanh toán
                        </h5>
                        
                        <div class="d-flex justify-content-between mb-2 text-secondary small">
                            <span>Tạm tính:</span>
                            <span class="fw-semibold">@Model.ChiTietHds.Sum(c => c.DonGia * c.SoLuong).ToString("N0")₫</span>
                        </div>
                        
                        @if (Model.ChiTietHds.Sum(c => c.GiamGia) > 0)
                        {
                            <div class="d-flex justify-content-between mb-2 text-danger small">
                                <span>Giảm giá:</span>
                                <span>-@Model.ChiTietHds.Sum(c => c.GiamGia).ToString("N0")₫</span>
                            </div>
                        }

                        <div class="d-flex justify-content-between mb-2 text-secondary small">
                            <span>Phí vận chuyển:</span>
                            <span class="fw-semibold">@Model.PhiVanChuyen.ToString("N0")₫</span>
                        </div>

                        <div class="d-flex justify-content-between mb-3 text-secondary small">
                            <span>Phương thức thanh toán:</span>
                            <span class="fw-semibold text-uppercase">@(Model.CachThanhToan == "cod" ? "COD (Tiền mặt)" : "Chuyển khoản")</span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center border-top pt-3 mt-3">
                            <span class="fw-bold text-dark">Tổng thanh toán:</span>
                            <span class="fs-4 fw-extrabold text-success" style="color: #81c408 !important;">
                                @((Model.ChiTietHds.Sum(c => c.DonGia * c.SoLuong) + Model.PhiVanChuyen - Model.ChiTietHds.Sum(c => c.GiamGia)).ToString("N0"))₫
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .fw-extrabold {
        font-weight: 800;
    }
    .shadow-inner {
        box-shadow: inset 0 2px 4px 0 rgba(0, 0, 0, 0.06);
    }
    .transition-all {
        transition: all 0.25s ease;
    }
    .transition-all:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(129, 196, 8, 0.25) !important;
    }
</style>
